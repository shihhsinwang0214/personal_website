---
import { langFromUrl } from '../../lib/noteRefs';
const isZh = langFromUrl(Astro.url) === 'zh';
/** Every route is a valid approach. Read each detour, in any order, then compare. */
interface Props { id: string; label?: string; next?: string; done?: string }
const { id, label = isZh ? '先試哪一條？' : 'Which approach first?', next = isZh ? '把幾種做法放在一起看' : 'Compare the approaches', done } = Astro.props;
---

<div class="dojo-node dojo-choose dojo-explore" data-node data-kind="explore" id={id} data-next={next} data-done={done}>
  <span class="dojo-tag">{label}</span>
  <div class="dojo-body dojo-choose-body"><slot /></div>
  <p class="dojo-feedback" role="status" aria-live="polite"></p>
</div>
