---
/**
 * DojoView.astro — page shell for one dojo script: themed header, the
 * dialogue, links back to the note and on to the next question.
 *
 * The wrapper carries `data-dojo-theme` (from the script's frontmatter,
 * default `board`); every themed rule in this file and in Dialogue.astro
 * hangs off that attribute, so a course can switch looks with one field.
 */
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Dialogue from './Dialogue.astro';
import type { Lang } from '../../lib/notes';
import { formatNoteDate } from '../../lib/notes';
import { resolveNoteRef } from '../../lib/noteRefs';
import { withBase } from '../../lib/url';
import { dojoIndexRoute, dojoRoute, dojoSeriesEntries, dojoThemeOf, dojoTitle, skillManualLabel, isVisibleDojo, type DojoEntry } from '../../lib/dojo';

interface Props { entry: DojoEntry; all: DojoEntry[]; lang: Lang }
const { entry, all, lang } = Astro.props;
const { Content } = await render(entry);
const note = await resolveNoteRef(entry.data.note, lang);
const sourceInChinese = lang === 'en' && /\/zh\//.test(note?.href ?? '');
const theme = dojoThemeOf(entry);
const sequence = dojoSeriesEntries(all, entry);
const seriesNav = await Promise.all(sequence.map(async (e) => ({ entry: e, note: await resolveNoteRef(e.data.note, lang) })));
const next = sequence[sequence.findIndex((e) => e.id === entry.id) + 1];
const nextNote = next ? await resolveNoteRef(next.data.note, lang) : undefined;
const other = all.find((e) => e.data.slug === entry.data.slug && e.data.lang !== lang && isVisibleDojo(e));
const alternates = [
  { lang, path: dojoRoute(entry.data.slug, lang) },
  ...(other ? [{ lang: other.data.lang, path: dojoRoute(entry.data.slug, other.data.lang) }] : []),
];
const minutesLabel = entry.data.minutes ? (lang === 'zh' ? `約 ${entry.data.minutes} 分鐘` : `~${entry.data.minutes} min`) : '';
const t = lang === 'zh'
  ? { mode: '想連著讀？', modeLink: '連續閱讀版', series: '這一系列的問題' }
  : { mode: 'Prefer continuous reading?', modeLink: sourceInChinese ? 'Read the note (Chinese)' : 'Read the note', series: 'Questions in this sequence' };
---

<Base
  title={`${entry.data.title} — ${dojoTitle[lang]}`}
  description={entry.data.summary}
  active="dojo"
  lang={lang}
  alternates={alternates}
  langToggleHref={other ? withBase(dojoRoute(entry.data.slug, other.data.lang)) : undefined}
>
  <main class="notes-page dojo-page" data-dojo-theme={theme}>
    <header class="dojo-head">
      <div class="dojo-head-signs">
        <nav class="dojo-sign note-crumbs" aria-label="Breadcrumb">
          <a href={withBase(dojoIndexRoute(lang))}>{dojoTitle[lang]}</a>
          {note && (
            <>
              <span class="note-crumb-sep" aria-hidden="true">/</span>
              <span>{note.group}</span>
            </>
          )}
        </nav>
      </div>
      <div class="dojo-head-paper">
        <p class="note-meta dojo-head-meta">
          {note?.code && <span class="note-code-chip">{note.code}</span>}
          {minutesLabel && <span>{minutesLabel}</span>}
          <span>{formatNoteDate(entry.data.updated, lang)}</span>
        </p>
        <h1>{entry.data.title}</h1>
        <p class="dojo-lead">{entry.data.summary}</p>
        <div class="dojo-modes">
          {seriesNav.length > 1 && <nav class="dojo-series" aria-label={t.series}>
            {seriesNav.map(({ entry: e, note: n }) => <a href={withBase(dojoRoute(e.data.slug, e.data.lang))} aria-current={e.id === entry.id ? 'page' : undefined} title={e.data.title}>{n?.code || e.data.title}</a>)}
          </nav>}
          {note?.href && (
            <p class="dojo-source">
              <span class="dojo-source-q">{t.mode}</span>
              <span class="dojo-source-label">{skillManualLabel[lang]}</span>
              <a href={note.href}>{t.modeLink}{note.code ? ` · ${note.code}` : ''} →</a>
            </p>
          )}
        </div>
      </div>
    </header>
    <Dialogue slug={entry.data.slug} lang={lang} progressVersion={entry.data.progressVersion} noteHref={note?.href} noteTitle={note ? `${note.title}${sourceInChinese ? ' (Chinese)' : ''}` : undefined} nextHref={next ? withBase(dojoRoute(next.data.slug, next.data.lang)) : undefined} nextTitle={next ? `${nextNote?.code ?? ''} ${next.data.title}`.trim() : undefined}>
      <Content />
    </Dialogue>
  </main>
</Base>

<style is:global>
  /* ---- shared header skeleton (theme-neutral) ---- */
  .dojo-page { padding: 0 0 48px; }
  .dojo-head { max-width: 800px; margin: 0 auto 30px; display: grid; gap: 14px; }
  .dojo-head-paper { display: grid; gap: 10px; }
  .dojo-head-paper h1 { margin: 0; font-size: clamp(1.55rem, 3.4vw, 2.1rem); line-height: 1.35; text-wrap: balance; }
  .dojo-head-meta { margin: 0; }
  .dojo-lead { margin: 0; color: var(--text-muted); line-height: 1.7; max-width: 62ch; }
  .dojo-modes { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 10px 20px; margin-top: 4px; }
  .dojo-series { display: flex; flex-wrap: wrap; gap: 8px; }
  .dojo-series a { padding: 5px 12px; border: 1px solid var(--border); border-radius: 999px; font-size: .83rem; text-decoration: none; color: var(--text-muted); }
  .dojo-series a[aria-current='page'] { color: var(--accent); border-color: var(--accent); background: color-mix(in srgb, var(--accent) 8%, transparent); }
  .dojo-series a:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  .dojo-source { margin: 0; font-size: .9rem; display: flex; flex-wrap: wrap; gap: 8px; align-items: center; color: var(--text-muted); }
  .dojo-source-label { font-size: .72rem; font-weight: 700; letter-spacing: .03em; padding: 2px 9px; border-radius: 999px; color: var(--accent); background: color-mix(in srgb, var(--accent) 14%, transparent); }

  /* ---- board: the page is a cork/wood board, the header a pinned sheet ---- */
  .dojo-page[data-dojo-theme="board"] {
    padding: 36px 32px 56px; border-radius: 24px;
    background-color: var(--bd-board);
    background-image: repeating-linear-gradient(90deg, var(--bd-grain) 0 2px, transparent 2px 46px), linear-gradient(180deg, rgba(255,255,255,.18), rgba(0,0,0,.06));
    box-shadow: inset 0 0 0 10px var(--bd-frame), inset 0 0 0 12px rgba(0,0,0,.08);
  }
  .dojo-page[data-dojo-theme="board"] .dojo-head-paper {
    position: relative; padding: 26px 30px 22px; border: 1px solid var(--border); border-radius: 4px; background: var(--bd-paper); box-shadow: var(--bd-shadow);
  }
  .dojo-page[data-dojo-theme="board"] .dojo-head-paper::before, .dojo-page[data-dojo-theme="board"] .dojo-head-paper::after {
    content: ""; position: absolute; top: -9px; width: 18px; height: 18px; border-radius: 50%; background: var(--bd-pin); box-shadow: 0 2px 4px rgba(0,0,0,.3), inset -2px -2px 0 rgba(0,0,0,.25);
  }
  .dojo-page[data-dojo-theme="board"] .dojo-head-paper::before { left: 22px; }
  .dojo-page[data-dojo-theme="board"] .dojo-head-paper::after { right: 22px; }
  .dojo-page[data-dojo-theme="board"] .dojo-source { padding: 6px 12px; border-radius: 6px; background: var(--bd-sign); color: var(--bd-sign-text); box-shadow: 0 2px 4px rgba(0,0,0,.15); }
  @media (max-width: 640px) {
    .dojo-page[data-dojo-theme="board"] { padding: 22px 14px 40px; border-radius: 14px; box-shadow: inset 0 0 0 6px var(--bd-frame), inset 0 0 0 8px rgba(0,0,0,.08); }
    .dojo-page[data-dojo-theme="board"] .dojo-head-paper { padding: 22px 18px 18px; }
  }

  /* ---- plates: a beam at the top, the title on a lacquered plaque ---- */
  .dojo-page[data-dojo-theme="plates"] {
    padding: 0 32px 56px; border-radius: 24px; background-color: var(--pl-wall);
    background-image: repeating-linear-gradient(0deg, rgba(120,90,50,.05) 0 1px, transparent 1px 7px), radial-gradient(ellipse at 50% 0%, rgba(255,255,255,.5), transparent 60%);
  }
  .dojo-page[data-dojo-theme="plates"] .dojo-head { max-width: 840px; padding-top: 0; }
  .dojo-page[data-dojo-theme="plates"] .dojo-head::before { content: ""; display: block; height: 36px; border-radius: 0 0 6px 6px; background-image: repeating-linear-gradient(90deg, rgba(0,0,0,.08) 0 3px, transparent 3px 19px), linear-gradient(180deg, var(--pl-wood-dark), color-mix(in srgb, var(--pl-wood-dark) 75%, #000)); box-shadow: 0 6px 14px rgba(60,35,10,.35); }
  .dojo-page[data-dojo-theme="plates"] .dojo-head-paper { position: relative; margin: 10px auto 0; padding: 20px 30px 18px; color: #e8d8b0; border: 3px solid var(--pl-wood-dark); border-radius: 8px; background: linear-gradient(180deg, #2d2a28, #1c1a19); box-shadow: 0 10px 24px rgba(0,0,0,.35), inset 0 0 0 2px #c9a35a; }
  .dojo-page[data-dojo-theme="plates"] .dojo-head-paper h1, .dojo-page[data-dojo-theme="plates"] .dojo-head-paper .dojo-lead { color: #e8d8b0; font-family: "Noto Serif TC", "PingFang TC", serif; }
  .dojo-page[data-dojo-theme="plates"] .dojo-head-paper .note-meta, .dojo-page[data-dojo-theme="plates"] .dojo-source { color: #c9a35a; }
  .dojo-page[data-dojo-theme="plates"] .dojo-source a, .dojo-page[data-dojo-theme="plates"] .dojo-series a { color: #e8d8b0; border-color: #8a5a34; }
  .dojo-page[data-dojo-theme="plates"] .dojo-sign { color: var(--pl-ink); }
  .dojo-page[data-dojo-theme="plates"] .dojo-sign a { color: inherit; }

  /* ---- scroll: a desk with one paper column; the header is the title block of the scroll ---- */
  .dojo-page[data-dojo-theme="scroll"] {
    padding: 40px 32px 56px; border-radius: 24px; background-color: #4a3526;
    background-image: repeating-linear-gradient(90deg, rgba(0,0,0,.12) 0 2px, transparent 2px 28px), linear-gradient(180deg, #5a4130, #3f2c1f);
  }
  .dojo-page[data-dojo-theme="scroll"] .dojo-head, .dojo-page[data-dojo-theme="scroll"] .dojo { max-width: 760px; }
  .dojo-page[data-dojo-theme="scroll"] .dojo-head { margin-bottom: 0; gap: 0; }
  .dojo-page[data-dojo-theme="scroll"] .dojo-head-signs { color: #e8d8b0; margin-bottom: 14px; }
  .dojo-page[data-dojo-theme="scroll"] .dojo-sign a { color: #e8d8b0; }
  .dojo-page[data-dojo-theme="scroll"] .dojo-sign-eyebrow { color: #c9a35a; }
  .dojo-page[data-dojo-theme="scroll"] .dojo-head-paper {
    position: relative; padding: 44px 56px 26px; margin-top: 30px; color: var(--sc-ink); background-color: var(--sc-paper);
    background-image: radial-gradient(ellipse at 20% 10%, rgba(255,255,255,.55), transparent 55%), repeating-linear-gradient(0deg, rgba(120,90,50,.06) 0 1px, transparent 1px 26px);
    box-shadow: inset 0 18px 24px -18px rgba(0,0,0,.35);
  }
  .dojo-page[data-dojo-theme="scroll"] .dojo-head-paper::before { content: ""; position: absolute; left: -14px; right: -14px; top: -30px; height: 30px; border-radius: 15px; background: linear-gradient(180deg, #3a3533, #1c1a19 50%, #3a3533); box-shadow: 0 8px 18px rgba(0,0,0,.5), inset 0 0 0 2px #6b4324; }
  .dojo-page[data-dojo-theme="scroll"] .dojo-head-paper h1 { font-family: "Noto Serif TC", "PingFang TC", serif; font-weight: 900; color: var(--sc-ink); padding-bottom: 18px; border-bottom: 2px solid color-mix(in srgb, var(--sc-rule) 55%, transparent); }
  .dojo-page[data-dojo-theme="scroll"] .dojo-head-paper .dojo-lead, .dojo-page[data-dojo-theme="scroll"] .dojo-source { color: color-mix(in srgb, var(--sc-ink) 75%, transparent); font-family: "Noto Serif TC", "PingFang TC", serif; }
  .dojo-page[data-dojo-theme="scroll"] .dojo { padding: 10px 56px 48px; margin-bottom: 30px; background-color: var(--sc-paper); background-image: repeating-linear-gradient(0deg, rgba(120,90,50,.06) 0 1px, transparent 1px 26px); box-shadow: inset 0 -18px 24px -18px rgba(0,0,0,.35); position: relative; }
  .dojo-page[data-dojo-theme="scroll"] .dojo::after { content: ""; position: absolute; left: -14px; right: -14px; bottom: -30px; height: 30px; border-radius: 15px; background: linear-gradient(180deg, #3a3533, #1c1a19 50%, #3a3533); box-shadow: 0 8px 18px rgba(0,0,0,.5), inset 0 0 0 2px #6b4324; }
  @media (max-width: 640px) {
    .dojo-page[data-dojo-theme="scroll"] { padding: 30px 12px 44px; }
    .dojo-page[data-dojo-theme="scroll"] .dojo-head-paper { padding: 32px 22px 20px; }
    .dojo-page[data-dojo-theme="scroll"] .dojo { padding: 10px 22px 36px; }
  }
</style>
