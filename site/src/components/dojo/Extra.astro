---
interface Props { label: string }
const { label } = Astro.props;
---

<details class="dojo-extra">
  <summary>{label}</summary>
  <div class="dojo-extra-body"><slot /></div>
</details>

<style is:global>
  .dojo .dojo-extra { margin: 1.3rem 0; border-block: 1px solid var(--border); }
  .dojo .dojo-extra > summary { padding: .8rem 0; cursor: pointer; font-weight: 600; }
  .dojo .dojo-extra-body { padding: 0 .25rem .4rem; }
  .dojo .dojo-extra-body .katex-display { font-size: .95em; }
</style>
