---
/** Card.astro — one draggable cell inside <Sort>. `col` (and optional `row`) say where it belongs. */
interface Props { col: number; row?: number; context?: string; hint?: string }
const { col, row, context, hint } = Astro.props;
---

<div class="dojo-card" data-col={String(col)} data-row={row !== undefined ? String(row) : undefined} data-hint={hint}>
  {context && <span class="dojo-card-context">{context}</span>}
  <slot />
</div>
