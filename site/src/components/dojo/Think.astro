---
/**
 * Think.astro — a pause: the reader writes a few lines for themselves (never stored,
 * never sent), then presses 「看我的整理」, which reveals the next node (usually a <Reveal>).
 *
 *   <Think id="t1">一次抽很多個樣本，最後只留分數最高的，這樣還需要改 sampling 嗎？</Think>
 */
interface Props { id?: string; label?: string; placeholder?: string; next?: string }
const { id, label = '先自己想一下', placeholder = '可以寫下你的猜測和理由，也可以先在心裡想。', next = '一起對照看看' } = Astro.props;
---

<div class="dojo-node dojo-think" data-node data-kind="think" id={id} data-next={next}>
  <span class="dojo-tag">{label}</span>
  <div class="dojo-body"><slot /></div>
  <textarea class="dojo-think-box" rows="3" placeholder={placeholder} aria-label={label}></textarea>
  <p class="dojo-think-hint">也可以先在心裡想，再看整理。文字只留在這個頁面，重新載入就會消失。</p>
</div>
