---
import { langFromUrl } from '../../lib/noteRefs';
interface Props { id: string; back: string; title: string }
const { id, back, title } = Astro.props;
const zh = langFromUrl(Astro.url) === 'zh';
---
<section class="dojo-method-path" id={id} data-method-path data-back={back} data-title={title}>
  <header class="dojo-method-header">
    <p>{title}</p>
    <button type="button" class="dojo-btn dojo-btn-ghost" data-method-return hidden>{zh ? '先回方法列表' : 'Return to the methods'}</button>
  </header>
  <slot />
</section>
<style is:global>
  .dojo.is-live .dojo-method-path { display: none; }
  .dojo.is-live .dojo-method-path.is-open { display: block; }
  .dojo-method-header { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 10px; margin: 20px 0 14px; }
  .dojo-method-header p { margin: 0; font-size: 1rem; font-weight: 600; }
  .dojo .dojo-opt-status { display: block; margin-top: 6px; font-size: .78rem; color: var(--text-muted); font-weight: 600; }
  .dojo .dojo-opt.is-seen .dojo-opt-status { color: var(--accent); }
</style>
