  [data-dojo-theme="plates"] .dojo-node.is-answered::after, [data-dojo-theme="plates"] .dojo-node[data-stamp-live].is-shown:not(.is-answered):not(.is-done)::after {
    display: block; content: attr(data-stamp); position: absolute; right: 16px; top: 14px; font-family: var(--font-mono); font-size: .68rem; font-weight: 700; letter-spacing: .14em; color: var(--pl-ink); border: 1.5px solid rgba(60,35,10,.45); border-radius: 4px; padding: 3px 7px; pointer-events: none;
  }
  [data-dojo-theme="plates"] .dojo-node[data-stamp-live].is-shown:not(.is-answered):not(.is-done)::after { content: attr(data-stamp-live); color: var(--pl-tassel); border-color: var(--pl-tassel); }
  [data-dojo-theme="plates"] .dojo-say.is-answered::after, [data-dojo-theme="plates"] .dojo-reveal.is-answered::after { display: none; }
  [data-dojo-theme="plates"] .dojo-slot { border: 2px solid rgba(60,35,10,.35); background: rgba(60,35,10,.12); box-shadow: inset 0 3px 6px rgba(0,0,0,.18); color: var(--pl-ink); }
