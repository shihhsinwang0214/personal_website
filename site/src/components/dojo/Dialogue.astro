---
/**
 * Dialogue.astro — wraps one dojo script and runs it one node at a time.
 *
 * Contract with the node components (Say / Talk / Explore / Choose / Judge / Think / Reveal / Sort):
 *   [data-node][data-kind]        one beat of the dialogue, in document order
 *   [data-detour="true"]          skipped by the main line; reached only via goto
 *   [data-back="id"]              after a detour's 「繼續」, return to this node
 *   [data-goto="id"]              after 「繼續」, jump here instead of the next node
 *   [data-next="label"]           label for this node's continue button
 *   [data-study="group"]          read before an exercise, hidden when its review opens
 *   [data-study-review="group"]   optional, read-only recall of that study group
 *
 * Interaction rules (decided 2026-10-13):
 *   - Choose: after the correct pick the walk may continue, but every other
 *     option stays open — tapping one shows its `why` inline or opens its
 *     detour, and the detour comes back to the question. Readers are nudged
 *     to look at the options they did not pick.
 *   - Judge: same — after answering, the other side can still be tapped to
 *     read its reply.
 *   - Sort with rows: a finished row stays on screen until the reader presses
 *     「下一列」; the next row never pops up by itself.
 *   - Themes only change CSS: the page wrapper carries data-dojo-theme
 *     (board / plates / scroll); the runner is theme-agnostic.
 *
 * With JS off, every node is visible — the script still reads as a short document.
 * Progress ("furthest main-line step reached", plus the total) lives in
 * localStorage under `slam:dojo:<slug>` and is never sent anywhere; nothing
 * about right or wrong is kept.
 */
import type { Lang } from '../../lib/notes';

interface Props {
  slug: string;
  lang?: Lang;
  /** Where the reader goes when they finish (the source note). */
  noteHref?: string;
  noteTitle?: string;
  progressVersion?: string;
  nextHref?: string;
  nextTitle?: string;
}
const { slug, lang = 'zh', noteHref, noteTitle, progressVersion = '1', nextHref, nextTitle } = Astro.props;
const t = lang === 'zh'
  ? { next: '繼續', resume: '上次讀到第 {n} 段。', resumeBtn: '接著讀', restart: '從頭開始', done: '這個問題先推到這裡。', toNote: '回技能書連著讀 →', again: '再想一次', praise: ['這個理由成立。'], retry: ['再看看這個做法需要哪些條件。'], sortDone: '整理好了，再把幾種做法放在一起看。', pick: '點一張卡片，再點它要放的格子；也可以直接拖過去。', others: '也可以展開其他選項，比較它們的理由。', otherSide: '另一個判斷的理由也可以展開比較。', rowDone: '這一列整理好了，接著比較下一個問題。', nextRow: '接著比較下一列', stampOk: '對照過了', stampJudge: '對照過了', stampThink: '想過了', stampSort: '整理好了', stampExplore: '比較過了', stampLive: '正在想', exploreStart: '先選一條，讀完再回來比較其他做法。', exploreMore: '把這條路先記下來，再看看其他做法會改動哪裡。', exploreDone: '幾種做法都看過了，現在一起比較。' }
  : { next: 'Continue', resume: 'You last read section {n}.', resumeBtn: 'Continue reading', restart: 'Start over', done: 'We have worked through this question.', toNote: 'Read the note continuously →', again: 'Think it through again', praise: ['That reasoning holds.'], retry: ['Check the conditions this approach needs.'], sortDone: 'Now compare the approaches together.', pick: 'Select a card, then its cell — or drag it.', others: 'You can also open the other options and compare their reasoning.', otherSide: 'You can also compare the reasoning for the other answer.', rowDone: 'That row is in place. Compare the next question.', nextRow: 'Compare the next row', stampOk: 'Reviewed', stampJudge: 'Reviewed', stampThink: 'Considered', stampSort: 'Organized', stampExplore: 'Compared', stampLive: 'Thinking', exploreStart: 'Pick an approach, read it, then return to compare the others.', exploreMore: 'Keep this approach in mind and see what the others change.', exploreDone: 'Now compare the approaches you have read.' };
---

<section class="dojo" data-dojo data-slug={slug} data-progress-version={progressVersion} data-i18n={JSON.stringify(t)}>
  <div class="dojo-resume" data-resume hidden>
    <span data-resume-text></span>
    <button type="button" class="dojo-btn" data-resume-go>{t.resumeBtn}</button>
    <button type="button" class="dojo-btn dojo-btn-ghost" data-resume-reset>{t.restart}</button>
  </div>
  <div class="dojo-flow"><slot /></div>
  <footer class="dojo-end" data-end hidden>
    <p class="dojo-end-title">{t.done}</p>
    {nextHref && <a class="dojo-btn" data-next-dojo href={nextHref}>{lang === 'zh' ? '接著試下一個問題 →' : 'Try the next question →'}{nextTitle && <span class="dojo-end-note"> {nextTitle}</span>}</a>}
    {noteHref && <a class:list={['dojo-btn', { 'dojo-btn-ghost': !!nextHref }]} href={noteHref}>{t.toNote}{noteTitle && <span class="dojo-end-note"> {noteTitle}</span>}</a>}
    <button type="button" class="dojo-btn dojo-btn-ghost" data-restart>{t.again}</button>
  </footer>
</section>

<style is:global>
  .dojo { max-width: 720px; margin: 0 auto; }
  .dojo [hidden] { display: none !important; }
  .dojo:not(.is-live) .dojo-end[hidden] { display: flex !important; }
  .dojo:not(.is-live) [data-restart] { display: none; }
  .dojo.is-live .dojo-node { display: none; }
  .dojo.is-live .dojo-node.is-shown { display: block; animation: dojo-in .32s var(--ease-out, ease) both; }
  @keyframes dojo-in { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: none; } }
  @media (prefers-reduced-motion: reduce) { .dojo.is-live .dojo-node.is-shown { animation: none; } }

  .dojo-node {
    margin: 0 0 18px; padding: 18px 20px; scroll-margin-top: 96px;
    border: 1px solid var(--border); border-radius: var(--radius, 12px); background: var(--surface);
  }
  .dojo-node.is-done { border-color: var(--border); }
  .dojo-node:focus { outline: none; }
  .dojo-say { background: transparent; border-color: transparent; padding: 6px 4px; }
  .dojo-say[data-detour] { border-color: var(--border); border-style: dashed; background: var(--surface); padding: 18px 20px; }
  .dojo-choose, .dojo-judge, .dojo-think { border-left: 4px solid var(--accent); background: var(--box-ml-bg, var(--surface-2)); }
  .dojo-reveal { border-left: 4px solid var(--accent); background: var(--box-math-bg, var(--surface-2)); }
  .dojo-sort { border-left: 4px solid var(--accent); }

  .dojo-tag {
    display: inline-block; margin-bottom: 10px; padding: 2px 9px;
    font-size: .72rem; font-weight: 700; letter-spacing: .03em;
    color: var(--accent); background: color-mix(in srgb, var(--accent) 14%, transparent); border-radius: 999px;
  }
  .dojo-body { line-height: 1.8; }
  .dojo-body .katex { white-space: nowrap; }
  .dojo-body .katex-display { overflow-x: auto; overflow-y: hidden; padding: 4px 0; }
  .dojo-body > p:first-child { margin-top: 0; }
  .dojo-body > p:last-child { margin-bottom: 0; }
  .dojo-choose-body > p { font-weight: 400; margin: 0 0 12px; }
  .dojo-choose-body .dojo-opt-wrap + .dojo-opt-wrap { margin-top: 8px; }
  .dojo-opt-wrap { display: block; }
  .dojo-opt-more { flex: none; margin-left: auto; margin-top: 7px; width: 8px; height: 8px; border-right: 2px solid var(--text-muted); border-bottom: 2px solid var(--text-muted); transform: rotate(45deg); opacity: .55; transition: transform .15s ease; }
  .dojo-opt[aria-expanded="true"] .dojo-opt-more { transform: rotate(225deg); margin-top: 11px; }
  .dojo-opt.is-seen:not(.is-correct):not(.is-wrong) { border-style: dashed; }
  .dojo-why { margin: 6px 0 2px 28px; padding: 8px 12px; font-size: .92rem; line-height: 1.7; color: var(--text); border-left: 3px solid var(--border); }
  .dojo.is-live .dojo-why:not(.is-open) { display: none; }
  .dojo:not(.is-live) .dojo-why::before { content: "→ "; color: var(--text-muted); }

  .dojo-opt {
    display: flex; align-items: flex-start; gap: 10px; width: 100%;
    text-align: left; cursor: pointer; font: inherit; color: inherit; font-weight: 400; line-height: 1.5;
    padding: 11px 14px; border: 1px solid var(--border); border-radius: 10px; background: var(--surface);
    transition: border-color .15s ease, background .15s ease;
  }
  .dojo-opt:hover:not(:disabled) { border-color: var(--accent); }
  .dojo-opt:focus-visible { outline: 2px solid var(--focus-ring, var(--accent)); outline-offset: 2px; }
  .dojo-opt:disabled { cursor: default; }
  .dojo-opt-text p { margin: 0; display: inline; }
  .dojo-mark { flex: 0 0 auto; width: 18px; height: 18px; margin-top: 2px; border-radius: 50%; border: 2px solid var(--text-muted); }
  .dojo-opt.is-correct { border-color: #2f9e6b; background: color-mix(in srgb, #2f9e6b 12%, var(--surface)); }
  .dojo-opt.is-correct .dojo-mark { border-color: #2f9e6b; background: #2f9e6b; }
  .dojo-opt.is-wrong { border-color: var(--accent); background: color-mix(in srgb, var(--accent) 8%, var(--surface)); }
  .dojo-opt.is-wrong .dojo-mark { border-color: var(--accent); }
  .dojo-judge-btns { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; margin-top: 12px; }
  .dojo-feedback { margin: 12px 0 0; min-height: 1.2em; font-weight: 600; line-height: 1.6; }
  .dojo-feedback:empty { display: none; }
  .dojo-feedback.ok { color: #2f9e6b; }
  .dojo-feedback.no { color: var(--text); }
  .dojo-think-hint { margin: 8px 0 0; font-size: .8rem; line-height: 1.6; color: var(--text-muted); }

  .dojo-think-box {
    display: block; width: 100%; margin-top: 12px; padding: 10px 12px; box-sizing: border-box;
    font: inherit; line-height: 1.6; color: var(--text); background: var(--surface);
    border: 1px solid var(--border); border-radius: 10px; resize: vertical;
  }
  .dojo-think-box:focus-visible { outline: 2px solid var(--focus-ring, var(--accent)); outline-offset: 1px; }

  .dojo-actions { display: flex; gap: 10px; margin-top: 14px; }
  .dojo-btn {
    display: inline-block; padding: 8px 16px; cursor: pointer; font: inherit; font-size: .9rem; font-weight: 600; text-decoration: none;
    color: #fff; background: var(--accent); border: 1px solid var(--accent); border-radius: 999px;
    transition: background .15s ease, color .15s ease;
  }
  .dojo-btn:hover { background: var(--accent-hover, var(--accent)); }
  .dojo-btn:focus-visible { outline: 2px solid var(--focus-ring, var(--accent)); outline-offset: 2px; }
  .dojo-btn-ghost { color: var(--accent); background: transparent; }
  .dojo-btn-ghost:hover { background: color-mix(in srgb, var(--accent) 12%, transparent); }
  .dojo-end-note { font-weight: 400; opacity: .9; }

  .dojo-resume, .dojo-end {
    display: flex; flex-wrap: wrap; align-items: center; gap: 10px; margin: 0 0 18px; padding: 14px 18px;
    border: 1px solid var(--border); border-radius: var(--radius, 12px); background: var(--surface-2);
  }
  .dojo-end { margin-top: 10px; }
  .dojo-resume[hidden], .dojo-end[hidden] { display: none; }
  .dojo-end-title { margin: 0; font-weight: 600; flex-basis: 100%; }

  /* ---- Sort ---- */
  .dojo-sort-table { display: grid; gap: 8px; margin: 12px 0; }
  .dojo-sort-question { margin: 16px 0 6px; font-weight: 600; }
  .dojo-card-context { display: block; color: var(--text-muted); font-size: .8rem; margin-bottom: 5px; }
  .dojo.is-live .dojo-card-context { display: none; }
  .dojo-sort-col { display: grid; gap: 6px; align-content: start; min-width: 0; }
  .dojo-sort-head { font-weight: 700; font-size: .9rem; line-height: 1.4; min-height: 2.8em; padding: 6px 8px; border-bottom: 2px solid var(--border); }
  .dojo-sort-rowhead { font-size: .8rem; color: var(--text-muted); padding: 2px 4px 0; }
  .dojo-sort:not(.is-complete) .dojo-sort-rowhead { display: none; }
  .dojo-slot {
    min-height: 54px; padding: 4px; border: 1.5px dashed var(--border); border-radius: 10px; background: var(--surface-2);
    font-size: .8rem; color: var(--text-muted); cursor: pointer;
    transition: border-color .15s ease, background .15s ease;
  }
  .dojo-slot.is-over, .dojo-slot.is-target { border-color: var(--accent); background: color-mix(in srgb, var(--accent) 10%, var(--surface-2)); }
  .dojo-slot.is-filled { border-style: solid; }
  .dojo-slot:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  .dojo-slot.is-filled { cursor: default; }
  .dojo-sort-pool { display: flex; flex-wrap: wrap; gap: 8px; min-height: 48px; padding: 8px; border-radius: 10px; background: var(--surface-2); }
  .dojo-sort-pool:empty { display: none; }
  .dojo-card {
    color: var(--text);
    padding: 8px 12px; font-size: .92rem; line-height: 1.5; cursor: grab; user-select: none;
    border: 1px solid var(--border); border-radius: 8px; background: var(--surface); box-shadow: var(--shadow-sm);
    transition: border-color .15s ease, transform .15s ease;
  }
  .dojo-card p { margin: 0; display: inline; }
  .dojo-card:hover { border-color: var(--accent); }
  .dojo-card:focus-visible { outline: 2px solid var(--focus-ring, var(--accent)); outline-offset: 2px; }
  .dojo-card.is-picked { border-color: var(--accent); transform: translateY(-2px); box-shadow: var(--shadow-md); }
  .dojo-card.is-locked { cursor: default; border-color: #2f9e6b; background: color-mix(in srgb, #2f9e6b 10%, var(--surface)); }
  @media (max-width: 640px) {
    .dojo-sort.is-complete .dojo-sort-table { grid-template-columns: 1fr !important; }
    .dojo-sort-head { font-size: .78rem; padding: 6px 3px; overflow-wrap: anywhere; }
    .dojo-slot { min-height: 64px; }
    .dojo-slot .dojo-card { font-size: .8rem; padding: 6px; }
    .dojo-judge-btns { grid-template-columns: 1fr; }
  }

  /* =====================================================================
     Themes. Only CSS; the runner and the node contract do not change.
     The page wrapper (DojoView) carries data-dojo-theme.
     ===================================================================== */
  .dojo-node { position: relative; }
  .dojo-node.is-answered::after, .dojo-node[data-stamp-live].is-shown:not(.is-answered):not(.is-done)::after { display: none; }

  /* ---------- board (任務告示板) — the default ---------- */
  [data-dojo-theme="board"] .dojo { max-width: 800px; }
  [data-dojo-theme="board"] .dojo-node { margin: 0 0 26px; scroll-margin-top: 110px; }
  /* lesson sheets: two pins, flat white paper */
  [data-dojo-theme="board"] .dojo-say:not([data-detour]), [data-dojo-theme="board"] .dojo-reveal {
    padding: 28px 30px 26px; border: 1px solid var(--border); border-radius: 4px; background: var(--bd-paper); box-shadow: var(--bd-shadow);
  }
  [data-dojo-theme="board"] .dojo-reveal { border-left: 5px solid var(--accent); background: var(--bd-paper); }
  [data-dojo-theme="board"] .dojo-say:not([data-detour])::before, [data-dojo-theme="board"] .dojo-say:not([data-detour])::after,
  [data-dojo-theme="board"] .dojo-reveal::before, [data-dojo-theme="board"] .dojo-reveal::after {
    content: ""; position: absolute; top: -9px; width: 18px; height: 18px; border-radius: 50%; background: var(--bd-pin);
    box-shadow: 0 2px 4px rgba(0,0,0,.3), inset -2px -2px 0 rgba(0,0,0,.25); pointer-events: none;
  }
  [data-dojo-theme="board"] .dojo-say:not([data-detour])::before, [data-dojo-theme="board"] .dojo-reveal::before { left: 22px; }
  [data-dojo-theme="board"] .dojo-say:not([data-detour])::after, [data-dojo-theme="board"] .dojo-reveal::after { right: 22px; }
  [data-dojo-theme="board"] .dojo-say > .dojo-tag, [data-dojo-theme="board"] .dojo-reveal > .dojo-tag {
    display: block; margin: 0 0 .5em; padding: 0; background: none; border-radius: 0;
    font-size: 1.18rem; font-weight: 700; letter-spacing: 0; line-height: 1.4; color: var(--text);
  }
  [data-dojo-theme="board"] .dojo-say:not([data-detour]) > .dojo-tag::before, [data-dojo-theme="board"] .dojo-reveal > .dojo-tag::before {
    content: ""; display: inline-block; width: 8px; height: 8px; margin: 0 10px 2px 0; border-radius: 50%; background: var(--accent);
  }
  /* prompt cards: lined index card, one pin, a little askew */
  [data-dojo-theme="board"] .dojo-choose, [data-dojo-theme="board"] .dojo-judge, [data-dojo-theme="board"] .dojo-think, [data-dojo-theme="board"] .dojo-sort {
    margin-left: 30px; margin-right: 30px; padding: 26px 26px 20px; border: 1px solid var(--border); border-left: 1px solid var(--border); border-radius: 6px;
    background: var(--bd-card); background-image: repeating-linear-gradient(0deg, transparent 0 27px, var(--bd-line) 27px 28px); background-position: 0 22px;
    box-shadow: var(--bd-shadow); transform: rotate(.5deg);
  }
  [data-dojo-theme="board"] .dojo-judge, [data-dojo-theme="board"] .dojo-sort { transform: rotate(-.4deg); }
  [data-dojo-theme="board"] .dojo-sort { margin-left: 0; margin-right: 0; background-image: none; background: var(--bd-paper); transform: none; }
  [data-dojo-theme="board"] .dojo-choose::before, [data-dojo-theme="board"] .dojo-judge::before, [data-dojo-theme="board"] .dojo-think::before, [data-dojo-theme="board"] .dojo-sort::before {
    content: ""; position: absolute; top: -9px; left: 50%; width: 18px; height: 18px; margin-left: -9px; border-radius: 50%; background: var(--bd-pin);
    box-shadow: 0 2px 4px rgba(0,0,0,.3), inset -2px -2px 0 rgba(0,0,0,.25); pointer-events: none;
  }
  [data-dojo-theme="board"] .dojo-sort::before { background: var(--bd-pin-red); }
  [data-dojo-theme="board"] .dojo-sort.is-answered::before { background: var(--bd-pin); }
  /* detour: a torn note, dashed, grey pin */
  [data-dojo-theme="board"] .dojo-say[data-detour] {
    margin-left: 60px; margin-right: 0; padding: 20px 22px 18px; border: 1px dashed var(--border); border-radius: 4px; background: var(--bd-note); box-shadow: var(--bd-shadow); transform: rotate(-.8deg);
  }
  [data-dojo-theme="board"] .dojo-say[data-detour]::before { content: ""; position: absolute; top: -9px; left: 50%; width: 18px; height: 18px; margin-left: -9px; border-radius: 50%; background: var(--bd-pin-grey); box-shadow: 0 2px 4px rgba(0,0,0,.3), inset -2px -2px 0 rgba(0,0,0,.25); }
  [data-dojo-theme="board"] .dojo-say[data-detour]::after { display: none; }
  [data-dojo-theme="board"] .dojo-say[data-detour] > .dojo-tag { display: inline-block; margin: 0 0 10px; padding: 2px 9px; font-size: .72rem; font-weight: 700; letter-spacing: .03em; line-height: 1.6; color: var(--text-muted); background: color-mix(in srgb, var(--text-muted) 16%, transparent); border-radius: 999px; }
  [data-dojo-theme="board"] .dojo-say[data-detour] > .dojo-tag::before { display: none; }
  /* stamps */
  [data-dojo-theme="board"] .dojo-node.is-answered::after,
  [data-dojo-theme="board"] .dojo-node[data-stamp-live].is-shown:not(.is-answered):not(.is-done)::after {
    display: block; content: attr(data-stamp); position: absolute; right: 16px; top: 16px; padding: 4px 8px;
    font-family: var(--font-mono); font-size: .68rem; font-weight: 700; letter-spacing: .14em; line-height: 1.2;
    color: var(--bd-ok); border: 2px solid var(--bd-ok); border-radius: 6px; transform: rotate(7deg); opacity: .85; pointer-events: none;
  }
  [data-dojo-theme="board"] .dojo-node[data-stamp-live].is-shown:not(.is-answered):not(.is-done)::after { content: attr(data-stamp-live); color: var(--accent); border-color: var(--accent); }
  [data-dojo-theme="board"] .dojo-say.is-answered::after, [data-dojo-theme="board"] .dojo-reveal.is-answered::after { display: none; }
  [data-dojo-theme="board"] .dojo-opt { background: var(--bd-paper); }
  /* sort: slips with a pin dot */
  [data-dojo-theme="board"] .dojo-slot { border-color: color-mix(in srgb, var(--bd-frame) 80%, var(--text)); background: color-mix(in srgb, var(--bd-card) 70%, transparent); border-radius: 6px; }
  [data-dojo-theme="board"] .dojo-card { position: relative; border-radius: 4px; box-shadow: 0 3px 8px rgba(28,40,51,.14); }
  [data-dojo-theme="board"] .dojo-card::before { content: ""; position: absolute; top: -5px; left: 50%; width: 9px; height: 9px; margin-left: -4px; border-radius: 50%; background: var(--bd-pin-red); }
  [data-dojo-theme="board"] .dojo-card.is-locked::before { background: var(--bd-ok); }
  [data-dojo-theme="board"] .dojo-sort-pool { padding-top: 14px; background: color-mix(in srgb, var(--bd-sign) 80%, transparent); }
  /* resume / end: small signs */
  [data-dojo-theme="board"] .dojo-resume, [data-dojo-theme="board"] .dojo-end { background: var(--bd-sign); color: var(--bd-sign-text); border-radius: 6px; box-shadow: 0 2px 4px rgba(0,0,0,.15); }
  @media (max-width: 640px) {
    [data-dojo-theme="board"] .dojo-choose, [data-dojo-theme="board"] .dojo-judge, [data-dojo-theme="board"] .dojo-think { margin-left: 6px; margin-right: 6px; padding: 22px 18px 18px; }
    [data-dojo-theme="board"] .dojo.is-live :is(.dojo-choose, .dojo-judge, .dojo-think, .dojo-sort) > .dojo-tag { max-width: calc(100% - 74px); box-sizing: border-box; }
    [data-dojo-theme="board"] .dojo-say[data-detour] { margin-left: 18px; }
    [data-dojo-theme="board"] .dojo-say:not([data-detour]), [data-dojo-theme="board"] .dojo-reveal { padding: 24px 18px 22px; }
  }

  /* ---------- plates (道場掛牌) ---------- */
  [data-dojo-theme="plates"] .dojo { max-width: 840px; }
  [data-dojo-theme="plates"] .dojo-node { margin: 0 0 38px; }
  [data-dojo-theme="plates"] .dojo-say:not([data-detour]), [data-dojo-theme="plates"] .dojo-reveal {
    padding: 28px 34px 26px; border: 1px solid var(--border); border-radius: 0; background: var(--pl-paper); box-shadow: 0 12px 26px rgba(60,35,10,.18);
  }
