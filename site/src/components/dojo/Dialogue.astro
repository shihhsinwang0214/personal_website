  [data-dojo-theme="plates"] .dojo-sort-pool { background: rgba(255,255,255,.35); }

  /* ---------- scroll (秘笈卷軸) ---------- */
  [data-dojo-theme="scroll"] .dojo { max-width: 760px; font-family: "Noto Serif TC", "PingFang TC", serif; color: var(--sc-ink); }
  [data-dojo-theme="scroll"] .dojo-node { margin: 0 0 30px; }
  [data-dojo-theme="scroll"] .dojo-say:not([data-detour]), [data-dojo-theme="scroll"] .dojo-reveal { padding: 0; border: 0; background: transparent; }
  [data-dojo-theme="scroll"] .dojo-say > .dojo-tag, [data-dojo-theme="scroll"] .dojo-reveal > .dojo-tag { display: block; margin: 0 0 .6em; padding: 0; background: none; font-size: 1.3rem; font-weight: 700; color: var(--sc-ink); letter-spacing: 0; }
  [data-dojo-theme="scroll"] .dojo-say:not([data-detour]) > .dojo-tag::before, [data-dojo-theme="scroll"] .dojo-reveal > .dojo-tag::before { content: "◆"; font-size: .7em; color: var(--sc-red); margin-right: 10px; vertical-align: 2px; }
  [data-dojo-theme="scroll"] .dojo-choose, [data-dojo-theme="scroll"] .dojo-judge, [data-dojo-theme="scroll"] .dojo-think, [data-dojo-theme="scroll"] .dojo-sort {
    padding: 20px 22px 18px; border: 1.5px solid var(--sc-rule); border-left-width: 1.5px; border-radius: 0; outline: 1px solid var(--sc-rule); outline-offset: 3px; background: rgba(255,255,255,.35); color: var(--sc-ink);
  }
  :root[data-theme=dark] [data-dojo-theme="scroll"] .dojo-choose, :root[data-theme=dark] [data-dojo-theme="scroll"] .dojo-judge, :root[data-theme=dark] [data-dojo-theme="scroll"] .dojo-think, :root[data-theme=dark] [data-dojo-theme="scroll"] .dojo-sort { background: rgba(255,255,255,.05); }
  [data-dojo-theme="scroll"] .dojo-choose > .dojo-tag, [data-dojo-theme="scroll"] .dojo-judge > .dojo-tag, [data-dojo-theme="scroll"] .dojo-think > .dojo-tag, [data-dojo-theme="scroll"] .dojo-sort > .dojo-tag { background: none; padding: 0; font-size: .78rem; letter-spacing: .2em; color: var(--sc-rule); }
  [data-dojo-theme="scroll"] .dojo-opt { color: var(--sc-ink); background: rgba(255,255,255,.5); border: 1px solid color-mix(in srgb, var(--sc-rule) 55%, transparent); border-radius: 0; }
  :root[data-theme=dark] [data-dojo-theme="scroll"] .dojo-opt { background: rgba(255,255,255,.06); }
  [data-dojo-theme="scroll"] .dojo-say[data-detour] { padding: 14px 16px; border: 0; border-left: 3px solid var(--sc-red); border-radius: 0; background: color-mix(in srgb, var(--sc-red) 7%, transparent); color: var(--sc-ink); font-size: .95rem; }
  [data-dojo-theme="scroll"] .dojo-say[data-detour] > .dojo-tag { background: none; padding: 0; font-size: .78rem; letter-spacing: .2em; color: var(--sc-red); }
  [data-dojo-theme="scroll"] .dojo-node.is-answered::after, [data-dojo-theme="scroll"] .dojo-node[data-stamp-live].is-shown:not(.is-answered):not(.is-done)::after {
    display: flex; align-items: center; justify-content: center; content: attr(data-stamp); position: absolute; right: 14px; top: 12px; width: 40px; height: 40px; padding: 2px; box-sizing: border-box;
    font-size: .72rem; font-weight: 900; line-height: 1.1; letter-spacing: .05em; text-align: center; color: var(--sc-green); border: 2.5px solid var(--sc-green); border-radius: 6px; transform: rotate(-6deg); opacity: .9; pointer-events: none;
  }
  [data-dojo-theme="scroll"] .dojo-node[data-stamp-live].is-shown:not(.is-answered):not(.is-done)::after { content: attr(data-stamp-live); color: var(--sc-red); border-color: var(--sc-red); }
  [data-dojo-theme="scroll"] .dojo-say.is-answered::after, [data-dojo-theme="scroll"] .dojo-reveal.is-answered::after { display: none; }
  [data-dojo-theme="scroll"] .dojo-slot { border: 1px solid var(--sc-rule); border-radius: 0; background: transparent; color: var(--sc-rule); }
  [data-dojo-theme="scroll"] .dojo-card { color: var(--sc-ink); background: #fff8e6; border: 1px solid #c9a35a; border-radius: 0; box-shadow: 2px 3px 0 rgba(74,53,32,.25); }
  :root[data-theme=dark] [data-dojo-theme="scroll"] .dojo-card { background: #3a3326; }
  [data-dojo-theme="scroll"] .dojo-sort-pool { background: transparent; border: 1px dashed var(--sc-rule); border-radius: 0; }
  [data-dojo-theme="scroll"] .dojo-sort-head { border-bottom-color: var(--sc-rule); }
</style>

<script>
  type Node = HTMLElement;
  type I18n = Record<string, any>;

  const pick = (arr: string[]) => arr[Math.floor(Math.random() * arr.length)];

  function storageKey(slug: string) { return `slam:dojo:${slug}`; }
  function readStep(slug: string, version: string): number {
    try {
      const saved = JSON.parse(localStorage.getItem(storageKey(slug)) || 'null');
      const step = typeof saved === 'number' && version === '1' ? saved : saved?.version === version ? saved.step : 0;
      return Number.isInteger(step) && step > 0 ? step : 0;
    } catch { return 0; }
  }
  function clearStep(slug: string) { try { localStorage.removeItem(storageKey(slug)); } catch {} }

  function shuffle<T>(arr: T[]): T[] { for (let i = arr.length - 1; i > 0; i--) { const j = Math.floor(Math.random() * (i + 1)); [arr[i], arr[j]] = [arr[j], arr[i]]; } return arr; }

  function runDojo(root: HTMLElement) {
    if (root.dataset.bound) return;
    root.dataset.bound = 'true';
    const slug = root.dataset.slug ?? '';
    const version = root.dataset.progressVersion ?? '1';
    let total = 0;
    const writeStep = (_slug: string, step: number) => { try { localStorage.setItem(storageKey(slug), JSON.stringify({ version, step, total })); } catch {} };
    const motion = () => matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' as const : 'smooth' as const;
    const t: I18n = JSON.parse(root.dataset.i18n ?? '{}');
    const nodes = Array.from(root.querySelectorAll<Node>('[data-node]'));
    const main = nodes.filter((n) => n.dataset.detour !== 'true');
    total = main.length;
    const byId = new Map<string, Node>();
    nodes.forEach((n) => { if (n.id) byId.set(n.id, n); });
    const end = root.querySelector<HTMLElement>('[data-end]')!;
    const resume = root.querySelector<HTMLElement>('[data-resume]')!;

    root.classList.add('is-live');

    // ---- continue buttons ----
    function actions(node: Node, label: string, onNext: () => void) {
      let box = node.querySelector<HTMLElement>(':scope > .dojo-actions');
      if (!box) { box = document.createElement('div'); box.className = 'dojo-actions'; node.appendChild(box); }
      box.innerHTML = '';
      const btn = document.createElement('button');
      btn.type = 'button'; btn.className = 'dojo-btn'; btn.textContent = label;
      btn.addEventListener('click', () => { box!.remove(); onNext(); });
      box.appendChild(btn);
      return btn;
    }

    function finish(node: Node) {
      node.classList.add('is-done');
      // Options that carry an explanation stay tappable after the walk moves on.
      node.querySelectorAll<HTMLButtonElement>('button.dojo-opt').forEach((b) => { if (!explorable(b)) b.disabled = true; });
      const ta = node.querySelector<HTMLTextAreaElement>('textarea'); if (ta) ta.readOnly = true;
      if (node.dataset.kind === 'think') stamp(node, t.stampThink);
    }
    function explorable(b: HTMLButtonElement) {
      if (b.classList.contains('is-correct')) return !!b.dataset.why;
      return !!(b.dataset.why || (b.dataset.goto && byId.has(b.dataset.goto)) || b.dataset.replyOther);
    }
    function stamp(node: Node, text: string) { node.dataset.stamp = text; node.classList.add('is-answered'); }

    function prepareReviews(node: Node) {
      node.querySelectorAll<HTMLDetailsElement>('[data-study-review]').forEach((review) => {
        const sources = nodes.filter((n) => n.dataset.study === review.dataset.studyReview);
        if (!review.dataset.bound) {
          review.dataset.bound = 'true';
          const content = review.querySelector<HTMLElement>('[data-study-review-content]')!;
          sources.forEach((source) => {
            const copy = document.createElement('article'); copy.className = 'dojo-study-review-source';
            source.querySelectorAll(':scope > .dojo-tag, :scope > .dojo-partner, :scope > .dojo-body').forEach((part) => copy.appendChild(part.cloneNode(true)));
            content.appendChild(copy);
          });
        }
        // Canonical nodes remain available for resume and static reading. Only
        // their presentation is hidden; reopening the review never changes progress.
        sources.forEach((source) => source.classList.remove('is-shown'));
      });
    }

    function reveal(node: Node, scroll = true) {
      node.classList.add('is-shown');
      if (node === main[0]) scroll = false;
      if (scroll) requestAnimationFrame(() => { node.tabIndex = -1; node.focus({ preventScroll: true }); node.scrollIntoView({ behavior: motion(), block: 'start' }); });
    }

    // ---- main line ----
    function advanceFrom(node: Node) {
      finish(node);
      const goto = node.dataset.goto;
      if (goto && byId.has(goto)) { show(byId.get(goto)!); return; }
      if (node.dataset.detour === 'true') {
        const back = node.dataset.back;
        if (back && byId.has(back)) { node.classList.remove('is-shown'); reopen(byId.get(back)!); return; }
      }
      let i = main.indexOf(node);
      if (i < 0) {
        // A detour with no `back`: continue after the last main-line node before it.
        const at = nodes.indexOf(node);
        i = -1;
        for (let k = at - 1; k >= 0; k--) { const m = main.indexOf(nodes[k]); if (m >= 0) { i = m; break; } }
      }
      const next = main[i + 1];
      if (next) { writeStep(slug, i + 1); show(next); }
      else { writeStep(slug, main.length); end.hidden = false; end.tabIndex = -1; end.focus({ preventScroll: true }); end.scrollIntoView({ behavior: motion(), block: 'start' }); }
    }

    function reopen(node: Node) {
      if (node.dataset.kind === 'explore') {
        const path = node.dataset.activePath;
        node.querySelectorAll<HTMLButtonElement>('.dojo-opt').forEach((b) => {
          b.disabled = false;
          if (path && b.dataset.goto === path) b.classList.add('is-seen');
        });
        delete node.dataset.activePath;
        updateExplore(node);
        node.tabIndex = -1; node.focus({ preventScroll: true });
        node.scrollIntoView({ behavior: motion(), block: 'start' });
        return;
      }
      // Back from a detour. An unanswered question is live again; an answered one
      // keeps its 「繼續」 and its options stay open for looking around.
      const answered = node.classList.contains('is-answered');
      node.classList.remove('is-done');
      node.querySelectorAll<HTMLButtonElement>('button.dojo-opt').forEach((b) => { b.disabled = answered ? !explorable(b) : false; });
      node.tabIndex = -1; node.focus({ preventScroll: true });
      node.scrollIntoView({ behavior: motion(), block: 'start' });
    }

    function show(node: Node) {
      prepareReviews(node);
      const kind = node.dataset.kind;
      if (kind === 'explore' || kind === 'choose' || kind === 'judge' || kind === 'think' || kind === 'sort') node.dataset.stampLive = t.stampLive;
      reveal(node);
      if (kind === 'explore') bindExplore(node);
      else if (kind === 'choose') bindChoose(node);
      else if (kind === 'judge') bindJudge(node);
      else if (kind === 'sort') bindSort(node);
      else actions(node, node.dataset.next || t.next, () => advanceFrom(node));
    }

    // Explore has no correct option. A route counts as read only on return.
    function updateExplore(node: Node) {
      const opts = Array.from(node.querySelectorAll<HTMLButtonElement>('.dojo-opt'));
      const complete = opts.length > 0 && opts.every((b) => b.classList.contains('is-seen'));
      const fb = node.querySelector<HTMLElement>('.dojo-feedback')!;
      fb.className = 'dojo-feedback';
      fb.textContent = complete ? (node.dataset.done || t.exploreDone) : opts.some((b) => b.classList.contains('is-seen')) ? t.exploreMore : t.exploreStart;
      if (complete) {
        stamp(node, t.stampExplore);
        if (!node.classList.contains('is-done')) actions(node, node.dataset.next || t.next, () => advanceFrom(node));
      }
    }
    function bindExplore(node: Node, completed = false) {
      if (node.dataset.bound) return;
      node.dataset.bound = 'true';
      const opts = Array.from(node.querySelectorAll<HTMLButtonElement>('.dojo-opt'));
      opts.forEach((btn) => {
        if (completed) btn.classList.add('is-seen');
        btn.addEventListener('click', () => {
          const path = btn.dataset.goto;
          if (!path || !byId.has(path)) return;
          node.dataset.activePath = path;
          opts.forEach((b) => (b.disabled = true));
          show(byId.get(path)!);
        });
      });
      updateExplore(node);
    }

    // ---- choose ----
    // One correct option moves the walk on; every option with a `why` or a
    // detour can be opened before or after answering, and is nudged after.
    function bindChoose(node: Node) {
      if (node.dataset.bound) return;
      node.dataset.bound = 'true';
      const wraps = Array.from(node.querySelectorAll<HTMLElement>('.dojo-opt-wrap'));
      if (node.dataset.shuffle !== 'false' && wraps.length > 1) {
        const parent = wraps[0].parentElement!;
        shuffle(wraps.slice()).forEach((w) => parent.appendChild(w));
      }
      const opts = Array.from(node.querySelectorAll<HTMLButtonElement>('.dojo-opt'));
      const fb = node.querySelector<HTMLElement>('.dojo-feedback')!;
      const hasOthers = () => opts.some((b) => !b.classList.contains('is-correct') && explorable(b));
      function openWhy(btn: HTMLButtonElement) {
        const why = btn.parentElement?.querySelector<HTMLElement>('.dojo-why');
        if (!why) return false;
        const open = why.classList.toggle('is-open');
        btn.classList.toggle('is-seen', open || btn.classList.contains('is-seen'));
        btn.setAttribute('aria-expanded', String(open));
        return true;
      }
      function openDetour(btn: HTMLButtonElement) {
        const goto = btn.dataset.goto;
        if (!goto || !byId.has(goto)) return false;
        btn.classList.add('is-seen');
        if (!node.classList.contains('is-answered')) { opts.forEach((b) => (b.disabled = true)); node.classList.add('is-done'); }
        show(byId.get(goto)!);
        return true;
      }
      opts.forEach((btn) => btn.addEventListener('click', () => {
        const answered = node.classList.contains('is-answered');
        const ok = btn.dataset.correct === 'true';
        if (answered) {
          // Looking around after answering: explanations only, state unchanged.
          if (!openWhy(btn)) openDetour(btn);
          return;
        }
        if (ok) {
          btn.classList.add('is-correct'); btn.disabled = !btn.dataset.why;
          stamp(node, t.stampOk);
          fb.textContent = (btn.dataset.reply || pick(t.praise)) + (hasOthers() ? ' ' + t.others : '');
          fb.className = 'dojo-feedback ok';
          opts.forEach((b) => { if (!b.classList.contains('is-correct') && !explorable(b)) b.disabled = true; });
          actions(node, node.dataset.next || t.next, () => advanceFrom(node));
        } else {
          btn.classList.add('is-wrong');
          if (openDetour(btn)) { fb.textContent = ''; fb.className = 'dojo-feedback'; return; }
          if (openWhy(btn)) { fb.textContent = btn.dataset.reply || ''; fb.className = 'dojo-feedback no'; return; }
          fb.textContent = btn.dataset.reply || pick(t.retry); fb.className = 'dojo-feedback no';
          btn.disabled = true;
        }
      }));
    }

    // ---- judge ----
    // Yes / no on one statement; after answering, the other side still opens its reply.
    function bindJudge(node: Node) {
      if (node.dataset.bound) return;
      node.dataset.bound = 'true';
      const btns = Array.from(node.querySelectorAll<HTMLButtonElement>('.dojo-judge-btn'));
      const fb = node.querySelector<HTMLElement>('.dojo-feedback')!;
      const replyOf = (btn: HTMLButtonElement) => btn.dataset.value === 'true' ? node.dataset.replyYes : node.dataset.replyNo;
      btns.forEach((btn) => { if (replyOf(btn)) btn.dataset.replyOther = 'true'; });
      btns.forEach((btn) => btn.addEventListener('click', () => {
        const answered = node.classList.contains('is-answered');
        const ok = btn.dataset.value === node.dataset.answer;
        const reply = replyOf(btn);
        if (answered) {
          let why = btn.parentElement?.querySelector<HTMLElement>(`.dojo-why[data-for="${btn.dataset.value}"]`);
          if (!why) {
            why = document.createElement('p'); why.className = 'dojo-why'; why.dataset.for = btn.dataset.value || ''; why.textContent = reply || '';
            btn.parentElement?.appendChild(why);
          }
          const open = why.classList.toggle('is-open');
          btn.classList.toggle('is-seen', open || btn.classList.contains('is-seen'));
          btn.setAttribute('aria-expanded', String(open));
          return;
        }
        btn.classList.add(ok ? 'is-correct' : 'is-wrong');
        fb.textContent = reply || pick(ok ? t.praise : t.retry); fb.className = 'dojo-feedback ' + (ok ? 'ok' : 'no');
        if (ok) {
          btn.disabled = true;
          stamp(node, t.stampJudge);
          const other = btns.find((b) => b !== btn);
          if (other && replyOf(other) && !other.classList.contains('is-wrong')) fb.textContent += ' ' + t.otherSide;
          actions(node, node.dataset.next || t.next, () => advanceFrom(node));
        }
      }));
    }

    // ---- sort (drag the table back together) ----
    function bindSort(node: Node, completed = false) {
      if (node.dataset.bound) return;
      node.dataset.bound = 'true';
      const columns: string[] = JSON.parse(node.dataset.columns || '[]');
      const rows: string[] = JSON.parse(node.dataset.rows || '[]');
      const rowReplies: string[] = JSON.parse(node.dataset.rowReplies || '[]');
      const table = node.querySelector<HTMLElement>('.dojo-sort-table')!;
      const pool = node.querySelector<HTMLElement>('.dojo-sort-pool')!;
      const fb = node.querySelector<HTMLElement>('.dojo-feedback')!;
      const question = node.querySelector<HTMLElement>('[data-sort-question]')!;
      const cards = Array.from(node.querySelectorAll<HTMLElement>('.dojo-card'));
      const slots: HTMLElement[] = [];
      const rowHeads: HTMLElement[] = [];
      let activeRow = 0;
      let picked: HTMLElement | null = null;
      let allDone = completed;
      const isZh = document.documentElement.lang.startsWith('zh');
      const words = isZh
        ? { place: '放置卡片', selected: '卡片已選取，接著選它要放的格子；按 Escape 可以取消。', nextRow: '接著想：', retry: '再比較一下這張卡片描述的做法。' }
        : { place: 'Place card', selected: 'Card selected. Choose its cell; press Escape to cancel.', nextRow: 'Next: ', retry: 'Compare what this card describes.' };
      table.style.gridTemplateColumns = `repeat(${columns.length}, minmax(0, 1fr))`;
      table.replaceChildren();
      shuffle(cards.slice()).forEach((c) => pool.appendChild(c));
      columns.forEach((name, ci) => {
        const col = document.createElement('div'); col.className = 'dojo-sort-col';
        const head = document.createElement('div'); head.className = 'dojo-sort-head';
        const profile = node.querySelector<HTMLTemplateElement>(`template[data-column-partner="${ci}"]`);
        if (profile) head.appendChild(profile.content.cloneNode(true)); else head.textContent = name;
        col.appendChild(head);
        for (let ri = 0; ri < Math.max(1, rows.length); ri++) {
          if (rows.length) {
            const rh = document.createElement('div'); rh.className = 'dojo-sort-rowhead'; rh.textContent = rows[ri]; rh.dataset.row = String(ri);
            rowHeads.push(rh); col.appendChild(rh);
          }
          const slot = document.createElement('div'); slot.className = 'dojo-slot'; slot.dataset.col = String(ci);
          if (rows.length) slot.dataset.row = String(ri);
          slot.tabIndex = 0; slot.setAttribute('role', 'button');
          slot.setAttribute('aria-label', `${name}${rows[ri] ? `，${rows[ri]}` : ''}，${words.place}`);
          slot.textContent = words.place;
          slots.push(slot); col.appendChild(slot);
        }
        table.appendChild(col);
      });

      function clearPick() {
        cards.forEach((c) => { c.classList.remove('is-picked'); if (!c.classList.contains('is-locked')) c.setAttribute('aria-pressed', 'false'); });
        picked = null;
        slots.forEach((s) => s.classList.remove('is-target', 'is-over'));
      }
      function displayRow() {
        node.classList.toggle('is-complete', allDone);
        cards.forEach((c) => { c.hidden = !allDone && rows.length > 0 && c.dataset.row !== String(activeRow); });
        [...slots, ...rowHeads].forEach((s) => { s.hidden = !allDone && rows.length > 0 && s.dataset.row !== String(activeRow); });
        question.hidden = allDone || rows.length === 0;
        question.textContent = rows[activeRow] || '';
      }
      function lock(card: HTMLElement, slot: HTMLElement) {
        if (!slot.classList.contains('is-filled')) slot.replaceChildren();
        slot.appendChild(card); slot.classList.add('is-filled');
        card.classList.add('is-locked'); card.draggable = false; card.tabIndex = -1;
        card.removeAttribute('role'); card.removeAttribute('aria-pressed');
        // A bucket without rows may receive several cards and stays focusable.
        if (rows.length) { slot.tabIndex = -1; slot.setAttribute('aria-disabled', 'true'); }
      }
      function place(card: HTMLElement, slot: HTMLElement) {
        if (allDone || slot.hidden || card.classList.contains('is-locked')) return;
        const ok = slot.dataset.col === card.dataset.col && (!rows.length || slot.dataset.row === card.dataset.row);
        if (!ok || (rows.length && slot.classList.contains('is-filled'))) {
          fb.textContent = card.dataset.hint || words.retry; fb.className = 'dojo-feedback no';
          clearPick(); card.focus({ preventScroll: true }); return;
        }
        clearPick(); lock(card, slot);
        const rowLeft = cards.some((c) => !c.classList.contains('is-locked') && (!rows.length || c.dataset.row === String(activeRow)));
        if (!rowLeft) {
          allDone = cards.every((c) => c.classList.contains('is-locked'));
          if (allDone) {
            displayRow();
            stamp(node, t.stampSort);
            fb.textContent = node.dataset.done || rowReplies[activeRow] || t.sortDone; fb.className = 'dojo-feedback ok';
            const btn = actions(node, node.dataset.next || t.next, () => advanceFrom(node)); btn.focus({ preventScroll: true }); return;
          }
          // A finished row stays until the reader asks for the next one.
          fb.textContent = rowReplies[activeRow] || t.rowDone; fb.className = 'dojo-feedback ok';
          const btn = actions(node, t.nextRow, () => {
            activeRow++;
            displayRow();
            fb.textContent = words.nextRow + rows[activeRow]; fb.className = 'dojo-feedback';
            const nextCard = cards.find((c) => !c.hidden && !c.classList.contains('is-locked'));
            nextCard?.focus({ preventScroll: true });
          });
          btn.focus({ preventScroll: true });
          return;
        } else { fb.textContent = t.pick; fb.className = 'dojo-feedback'; }
        const nextCard = cards.find((c) => !c.hidden && !c.classList.contains('is-locked'));
        nextCard?.focus({ preventScroll: true });
      }
      cards.forEach((card, index) => {
        card.tabIndex = 0; card.draggable = true; card.setAttribute('role', 'button'); card.setAttribute('aria-pressed', 'false');
        const choose = () => {
          if (allDone || card.classList.contains('is-locked')) return;
          const deselect = picked === card; clearPick();
          if (deselect) { fb.textContent = t.pick; return; }
          picked = card; card.classList.add('is-picked'); card.setAttribute('aria-pressed', 'true');
          const targets = slots.filter((s) => !s.hidden && (!s.classList.contains('is-filled') || !rows.length));
          targets.forEach((s) => s.classList.add('is-target'));
          fb.textContent = words.selected; fb.className = 'dojo-feedback';
          targets[0]?.focus({ preventScroll: true });
        };
        card.addEventListener('click', choose);
        card.addEventListener('keydown', (e) => { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); choose(); } });
        card.addEventListener('dragstart', (e) => {
          if (allDone || card.classList.contains('is-locked')) { e.preventDefault(); return; }
          clearPick(); picked = card; card.classList.add('is-picked'); card.setAttribute('aria-pressed', 'true');
          e.dataTransfer?.setData('text/plain', String(index));
          if (e.dataTransfer) e.dataTransfer.effectAllowed = 'move';
        });
        card.addEventListener('dragend', clearPick);
      });
      slots.forEach((slot) => {
        slot.addEventListener('dragover', (e) => { if (!allDone && (!slot.classList.contains('is-filled') || !rows.length)) { e.preventDefault(); slot.classList.add('is-over'); } });
        slot.addEventListener('dragleave', () => slot.classList.remove('is-over'));
        slot.addEventListener('drop', (e) => { e.preventDefault(); if (picked) place(picked, slot); });
        slot.addEventListener('click', () => { if (picked) place(picked, slot); });
        slot.addEventListener('keydown', (e) => {
          if ((e.key === 'Enter' || e.key === ' ') && picked) { e.preventDefault(); place(picked, slot); }
        });
      });
      node.addEventListener('keydown', (e) => { if (e.key === 'Escape' && picked) { const card = picked; clearPick(); fb.textContent = t.pick; card.focus(); } });
      if (completed) {
        cards.forEach((c) => { const slot = slots.find((s) => s.dataset.col === c.dataset.col && (!rows.length || s.dataset.row === c.dataset.row)); if (slot) lock(c, slot); });
        fb.textContent = node.dataset.done || t.sortDone; fb.className = 'dojo-feedback ok';
      } else { fb.textContent = t.pick; fb.className = 'dojo-feedback'; }
      displayRow();
    }
    // ---- fast-forward for resume ----
    function fastForward(upto: number) {
      main[0]?.querySelector(':scope > .dojo-actions')?.remove();
      for (let i = 0; i < upto && i < main.length; i++) {
        const n = main[i];
        n.classList.add('is-shown', 'is-done');
        prepareReviews(n);
        const kind = n.dataset.kind;
        if (kind === 'explore') {
          bindExplore(n, true);
        } else if (kind === 'choose' || kind === 'judge') {
          n.querySelectorAll<HTMLButtonElement>('.dojo-opt').forEach((b) => {
            const ok = kind === 'choose' ? b.dataset.correct === 'true' : b.dataset.value === n.dataset.answer;
            if (ok) b.classList.add('is-correct');
          });
          stamp(n, kind === 'choose' ? t.stampOk : t.stampJudge);
          // Bind so the other options can still be opened, then mark it answered.
          if (kind === 'choose') bindChoose(n); else bindJudge(n);
          n.querySelectorAll<HTMLButtonElement>('.dojo-opt').forEach((b) => { b.disabled = !explorable(b); });
        } else if (kind === 'sort') {
          bindSort(n, true);
          stamp(n, t.stampSort);
        } else if (kind === 'think') {
          const ta = n.querySelector<HTMLTextAreaElement>('textarea'); if (ta) ta.readOnly = true;
          stamp(n, t.stampThink);
        }
      }
      if (upto >= main.length) { end.hidden = false; end.tabIndex = -1; end.focus({ preventScroll: true }); end.scrollIntoView({ behavior: motion(), block: 'start' }); return; }
      show(main[upto]);
    }

    function restart() {
      clearStep(slug);
      location.reload();
    }
    root.querySelector('[data-restart]')?.addEventListener('click', restart);
    root.querySelector('[data-resume-reset]')?.addEventListener('click', restart);

    const saved = Math.min(readStep(slug, version), main.length);
    if (saved > 0 && main.length > 1) {
      resume.hidden = false;
      resume.querySelector('[data-resume-text]')!.textContent = String(t.resume).replace('{n}', String(Math.min(saved, main.length) + (saved >= main.length ? 0 : 1)));
      resume.querySelector('[data-resume-go]')?.addEventListener('click', () => { resume.hidden = true; fastForward(saved); });
      // The first node is always visible so the page never looks empty.
      reveal(main[0], false);
      if (main[0].dataset.kind === 'explore' || main[0].dataset.kind === 'choose' || main[0].dataset.kind === 'judge' || main[0].dataset.kind === 'sort') show(main[0]);
      else actions(main[0], main[0].dataset.next || t.next, () => { resume.hidden = true; clearStep(slug); advanceFrom(main[0]); });
    } else if (main.length) {
      show(main[0]);
    }
  }

  document.querySelectorAll<HTMLElement>('[data-dojo]').forEach(runDojo);
</script>
