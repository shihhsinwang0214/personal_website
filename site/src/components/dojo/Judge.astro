---
import { langFromUrl } from '../../lib/noteRefs';
const isZh = langFromUrl(Astro.url) === 'zh';
/**
 * Judge.astro — a yes/no call on one statement.
 *
 *   <Judge id="j1" answer={false} yes="成立" no="不成立"
 *          replyYes="再想一下：…" replyNo="對：…">
 *   只要 $\theta$ 被更新，就還算 test-time steering。
 *   </Judge>
 */
import Partner from './Partner.astro';
import type { DojoPartnerId, DojoPartnerPose } from '../../lib/dojoPartners';

interface Props { pose?: DojoPartnerPose; partner?: DojoPartnerId;  id: string; answer: boolean; label?: string; yes?: string; no?: string; replyYes?: string; replyNo?: string; goto?: string }
const { pose = 'question', partner, id, answer, label = isZh ? '成立嗎？' : 'Does this hold?', yes = isZh ? '成立' : 'Yes', no = isZh ? '不成立' : 'No', replyYes, replyNo, goto } = Astro.props;
---

<div class="dojo-node dojo-judge" data-node data-kind="judge" id={id} data-answer={answer ? 'true' : 'false'} data-reply-yes={replyYes} data-reply-no={replyNo} data-goto={goto}>
  <span class="dojo-tag">{label}</span>
  {partner && <Partner partner={partner} pose={pose} reactive={pose === 'question'} />}
  <div class="dojo-body"><slot /></div>
  <div class="dojo-judge-btns">
    <button type="button" class="dojo-opt dojo-judge-btn" data-value="true"><span class="dojo-mark" aria-hidden="true"></span><span class="dojo-opt-text">{yes}</span></button>
    <button type="button" class="dojo-opt dojo-judge-btn" data-value="false"><span class="dojo-mark" aria-hidden="true"></span><span class="dojo-opt-text">{no}</span></button>
  </div>
  <p class="dojo-feedback" role="status" aria-live="polite"></p>
  <noscript><p class="dojo-body">{answer ? replyYes : replyNo}</p></noscript>
</div>
