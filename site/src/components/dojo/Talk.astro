---
import Partner from './Partner.astro';
import type { DojoPartnerId, DojoPartnerPose } from '../../lib/dojoPartners';

interface Props { pose?: DojoPartnerPose;  id: string; partner: DojoPartnerId; label: string; study?: string; next?: string; detour?: boolean; back?: string }
const { pose = 'explain', id, partner, label, study, next, detour = false, back } = Astro.props;
---

<article class="dojo-node dojo-say dojo-talk" data-node data-kind="say" id={id} data-study={study} data-next={next} data-detour={detour ? 'true' : undefined} data-back={back}>
  <span class="dojo-tag">{label}</span>
  <Partner partner={partner} pose={pose} />
  <div class="dojo-body"><slot /></div>
</article>
