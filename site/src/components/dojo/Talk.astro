---
import Partner from './Partner.astro';
import type { DojoPartnerId } from '../../lib/dojoPartners';

interface Props { id: string; partner: DojoPartnerId; label: string; study?: string; next?: string }
const { id, partner, label, study, next } = Astro.props;
---

<article class="dojo-node dojo-say dojo-talk" data-node data-kind="say" id={id} data-study={study} data-next={next}>
  <span class="dojo-tag">{label}</span>
  <Partner partner={partner} />
  <div class="dojo-body"><slot /></div>
</article>
