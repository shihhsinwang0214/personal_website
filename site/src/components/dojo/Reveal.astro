---
/**
 * Reveal.astro — the author's write-up after a <Think>, or a full table / formula
 * the reader has earned by getting here. Content is the slot (tables, math, <Ref>).
 */
import Partner from './Partner.astro';
import type { DojoPartnerId } from '../../lib/dojoPartners';
interface Props { id?: string; label?: string; next?: string; goto?: string; partner?: DojoPartnerId }
const { id, label = '我的整理', next, goto, partner } = Astro.props;
---

<div class="dojo-node dojo-reveal" data-node data-kind="reveal" id={id} data-next={next} data-goto={goto}>
  <span class="dojo-tag">{label}</span>
  {partner && <Partner partner={partner} />}
  <div class="dojo-body"><slot /></div>
</div>
