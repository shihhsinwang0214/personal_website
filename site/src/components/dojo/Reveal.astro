---
import { langFromUrl } from '../../lib/noteRefs';
const isZh = langFromUrl(Astro.url) === 'zh';
/**
 * Reveal.astro — the author's write-up after a <Think>, or a full table / formula
 * the reader has earned by getting here. Content is the slot (tables, math, <Ref>).
 */
import Partner from './Partner.astro';
import type { DojoPartnerId, DojoPartnerPose } from '../../lib/dojoPartners';
interface Props { pose?: DojoPartnerPose;  id?: string; label?: string; next?: string; goto?: string; partner?: DojoPartnerId }
const { pose = 'explain', id, label = isZh ? '我的整理' : 'Putting it together', next, goto, partner } = Astro.props;
---

<div class="dojo-node dojo-reveal" data-node data-kind="reveal" id={id} data-next={next} data-goto={goto}>
  <span class="dojo-tag">{label}</span>
  {partner && <Partner partner={partner} pose={pose} />}
  <div class="dojo-body"><slot /></div>
</div>
