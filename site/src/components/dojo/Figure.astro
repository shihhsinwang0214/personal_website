---
import { langFromUrl } from '../../lib/noteRefs';
const isZh = langFromUrl(Astro.url) === 'zh';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props { src: ImageMetadata; alt: string; eager?: boolean }
const { src, alt, eager = false } = Astro.props;
---

<figure class="dojo-figure">
  <a href={src.src} target="_blank" rel="noopener noreferrer" aria-label={isZh ? '查看情境圖大圖（另開分頁）' : 'Open the full-size illustration in a new tab'}>
    <Image src={src} alt={alt} widths={[480, 960, 1440]} sizes="(max-width: 640px) 90vw, 720px" format="webp" loading={eager ? 'eager' : 'lazy'} />
  </a>
  <figcaption><slot /><span class="dojo-figure-zoom">{isZh ? '點圖可放大' : 'Select the image to enlarge'}</span></figcaption>
</figure>

<style>
  .dojo-figure { margin: 16px 0; }
  .dojo-figure a { display: block; border-radius: 10px; overflow: hidden; background: white; }
  .dojo-figure a:focus-visible { outline: 3px solid var(--accent); outline-offset: 3px; }
  .dojo-figure img { display: block; width: 100%; height: auto; }
  .dojo-figure figcaption { margin-top: 8px; font-size: .83rem; line-height: 1.6; color: var(--text-muted); }
  .dojo-figure figcaption :global(p) { display: inline; margin: 0; }
  .dojo-figure-zoom { display: block; margin-top: 3px; font-size: .76rem; }
</style>
