---
/**
 * Say.astro — one beat of narration in the author's voice. The reader reads it
 * and presses 「繼續」. Also the building block of a detour:
 *
 *   <Say>情境或旁白（可含 $math$）</Say>
 *   <Say id="d-retrain" detour back="c1">答錯後才會走到的岔路，讀完回到 c1 重選。</Say>
 *   <Say goto="c2">讀完跳到 c2 而不是下一個節點。</Say>
 *
 * `label` overrides the small tag; omit it for plain narration.
 */
import Partner from './Partner.astro';
import type { DojoPartnerId, DojoPartnerPose } from '../../lib/dojoPartners';

interface Props { pose?: DojoPartnerPose; partner?: DojoPartnerId;  id?: string; label?: string; detour?: boolean; back?: string; goto?: string; next?: string; study?: string }
const { pose = 'explain', partner, id, label, detour = false, back, goto, next, study } = Astro.props;
---

<div class="dojo-node dojo-say" data-node data-kind="say" id={id} data-detour={detour ? 'true' : undefined} data-back={back} data-goto={goto} data-next={next} data-study={study}>
  {label && <span class="dojo-tag">{label}</span>}
  {partner && <Partner partner={partner} pose={pose} />}
  <div class="dojo-body"><slot /></div>
</div>
