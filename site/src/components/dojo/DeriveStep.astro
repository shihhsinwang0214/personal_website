---
import { langFromUrl } from '../../lib/noteRefs';
const isZh = langFromUrl(Astro.url) === 'zh';
interface Props { title: string; goal: string; tool: string; reason: string }
const { title, goal, tool, reason } = Astro.props;
---

<section class="dojo-derive-step" data-derive-step data-derive-title={title}>
  <h3>{title}</h3>
  <dl class="dojo-derive-reasoning">
    <div><dt>{isZh ? '想算什麼' : 'Goal'}</dt><dd>{goal}</dd></div>
    <div><dt>{isZh ? '用哪個工具' : 'Tool'}</dt><dd>{tool}</dd></div>
    <div><dt>{isZh ? '為什麼用它' : 'Why this tool'}</dt><dd>{reason}</dd></div>
  </dl>
  <div class="dojo-derive-result"><slot /></div>
</section>

<style is:global>
  .dojo .dojo-derive-step { padding: 16px 0; border-block-start: 1px solid var(--border); scroll-margin-top: 96px; }
  .dojo .dojo-derive-step h3 { margin: 0 0 12px; font-size: 1.05rem; line-height: 1.5; }
  .dojo .dojo-derive-step:focus-visible { outline: 2px solid var(--focus-ring, var(--accent)); outline-offset: 4px; }
  .dojo .dojo-derive-reasoning { display: grid; gap: 8px; margin: 0 0 16px; font-size: .92rem; }
  .dojo .dojo-derive-reasoning > div { display: grid; grid-template-columns: 6em minmax(0, 1fr); gap: 10px; }
  .dojo .dojo-derive-reasoning dt { color: var(--text-muted); }
  .dojo .dojo-derive-reasoning dd { margin: 0; }
  .dojo .dojo-derive-result > :first-child { margin-top: 0; }
  .dojo .dojo-derive-result > :last-child { margin-bottom: 0; }
  @media (max-width: 600px) {
    .dojo .dojo-derive-reasoning > div { grid-template-columns: minmax(0, 1fr); gap: 1px; }
    .dojo .dojo-derive-reasoning dt { font-size: .8rem; }
  }
</style>
