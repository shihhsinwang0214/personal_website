---
/**
 * Choose.astro — a decision point. The question is the slot; each <Option> is a
 * branch. A wrong option either shows its short `reply` inline, or (RPG style)
 * opens the detour node named by `goto`, which comes back here on 「繼續」.
 *
 *   <Choose id="c1" label="你會怎麼做？">
 *   題目（可含 $math$）
 *   <Option goto="d-retrain">重新訓練</Option>
 *   <Option correct reply="對，這就是本單元的界線。">固定參數，改 sampling</Option>
 *   </Choose>
 */
import Review from './Review.astro';
import Partner from './Partner.astro';
import type { DojoPartnerId, DojoPartnerPose } from '../../lib/dojoPartners';

interface Props { pose?: DojoPartnerPose; partner?: DojoPartnerId;  id: string; label?: string; shuffle?: boolean; review?: string }
const { pose = 'question', partner, id, label = '你會怎麼做？', shuffle = true, review } = Astro.props;
---

<div class="dojo-node dojo-choose" data-node data-kind="choose" id={id} data-shuffle={shuffle ? 'true' : 'false'}>
  <span class="dojo-tag">{label}</span>
  {partner && <Partner partner={partner} pose={pose} reactive={pose === 'question'} />}
  {review && <Review group={review} />}
  <div class="dojo-body dojo-choose-body"><slot /></div>
  <p class="dojo-feedback" role="status" aria-live="polite"></p>
</div>
