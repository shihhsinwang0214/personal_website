---
/**
 * Path.astro — one branch of an <Explore>. Nodes inside run in order and are
 * never part of the main line; after the last one the walk returns to the
 * Explore that opened this path. `title` is shown as a small caption while
 * the path is open.
 */
interface Props { id: string; title?: string }
const { id, title } = Astro.props;
---

<div class="dojo-path" data-path id={id} data-title={title}>
  {title && <p class="dojo-path-title"><span class="dojo-tag dojo-tag-muted">你選的路</span>{title}</p>}
  <slot />
</div>
