---
/**
 * Section.astro — one chapter of the walk, mirroring an H2 of the source note.
 * Not a node itself: its children are. The heading surfaces when the first
 * node inside is shown, and the side map tracks each section's state
 * (not yet / surfacing / surfaced).
 *
 *   <Section id="s1" title="先分清楚：什麼時候才算 test-time？">
 *   …nodes…
 *   </Section>
 */
interface Props { id: string; title: string }
const { id, title } = Astro.props;
---

<section class="dojo-section" data-section id={id} data-title={title}>
  <h2 class="dojo-section-title">{title}</h2>
  <slot />
</section>
