---
/**
 * Content.astro — a stretch of the note's own prose, surfacing. Rendered in the
 * note's typography (no card), so a finished walk reads as the note itself.
 * Headings inside should be H3 (the Section provides the H2).
 *
 *   <Content label="技能書 §2.1">…paragraphs, $math$, tables, <Ref/>…</Content>
 */
interface Props { id?: string; label?: string; next?: string; goto?: string }
const { id, label, next, goto } = Astro.props;
---

<div class="dojo-node dojo-content" data-node data-kind="content" id={id} data-next={next} data-goto={goto}>
  {label && <span class="dojo-tag dojo-tag-muted">{label}</span>}
  <div class="dojo-body markdown-body"><slot /></div>
</div>
