---
import { langFromUrl } from '../../lib/noteRefs';
const isZh = langFromUrl(Astro.url) === 'zh';
/** The runner fills this with the already-read group's text, then hides that group. */
interface Props { group: string }
const { group } = Astro.props;
---

<details class="dojo-study-review" data-study-review={group}>
  <summary>{isZh ? '再聽一次夥伴的提案' : 'Revisit the partners’ proposals'}</summary>
  <div class="dojo-study-review-content" data-study-review-content></div>
  <noscript><p>{isZh ? '夥伴的提案已在前面完整列出，可以往前對照。' : 'The full proposals appear above. You can scroll back to compare them.'}</p></noscript>
</details>

<style is:global>
  .dojo .dojo-study-review { margin: 0 0 16px; padding: 10px 12px; border: 1px solid var(--border); border-radius: 8px; background: var(--surface-2); }
  .dojo .dojo-study-review summary { cursor: pointer; font-size: .9rem; line-height: 1.5; color: var(--accent); }
  .dojo .dojo-study-review summary:focus-visible { outline: 2px solid var(--focus-ring, var(--accent)); outline-offset: 4px; }
  .dojo .dojo-study-review-content { display: grid; gap: 24px; margin-top: 20px; }
  .dojo .dojo-study-review-source + .dojo-study-review-source { padding-top: 18px; border-top: 1px solid var(--border); }
  .dojo .dojo-study-review-source > .dojo-tag { display: block; background: none; padding: 0; margin-bottom: 12px; font-size: .9rem; line-height: 1.5; }
  .dojo .dojo-study-review-content .dojo-body { overflow-wrap: anywhere; }
  .dojo .dojo-study-review-content .katex-display { font-size: .9em; }
</style>
