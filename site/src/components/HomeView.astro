---
import { getCollection } from 'astro:content';
import { withBase } from '../lib/url';
import { profile, research, news, publications, uiText, heroContent } from '../data/content';
import type { Lang } from '../lib/notes';
import {
  categoryLabels,
  courseByKey,
  courseRoute,
  formatNoteDate,
  homeSections,
  isPublishedNote,
  notesIndexRoute,
} from '../lib/notes';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;

const allNotes = await getCollection('notes');
// The home page lists only the top-level headings (course / research area);
// the notes index is where the lecture and note levels live.
const homeBlocks = homeSections(allNotes, lang);
const published = allNotes.filter((n) => isPublishedNote(n) && n.data.lang === lang);
/** Slugs per course, so the cards can show this browser's progress. */
const courseSlugs = (key: string) => {
  const course = courseByKey(key);
  if (!course) return [];
  const groups = new Set(course.lectures.map((l) => l.group));
  return published.filter((n) => groups.has(n.data.group)).map((n) => n.data.slug);
};
const courseKeyOf = (id: string) => (id.startsWith('course-') ? id.slice('course-'.length) : undefined);
const selectedPubs = publications[0].items.slice(0, 3);
const recentNews = news.slice(0, 4);
---

<main class="home">
  <section class="hero">
    <svg class="hero-contour" viewBox="0 0 380 140" preserveAspectRatio="none" aria-hidden="true">
      <path d="M0,34 C90,8 210,58 380,18" />
      <path d="M0,62 C110,38 240,86 380,48" />
      <path d="M0,90 C100,70 230,114 380,80" />
      <path d="M0,118 C120,98 250,140 380,108" />
    </svg>
    <p class="eyebrow">{heroContent.eyebrow[lang]}</p>
    <h1 class="hero-title">Shih-Hsin Wang <span class="zh">王士欣</span></h1>
    <div class="hero-rule"></div>
    <p class="hero-lead">{heroContent.lead[lang]}</p>
    <div class="hero-links">
      <a href={profile.contact.scholar} target="_blank" rel="noopener">Google Scholar</a>
      <a href={profile.contact.github} target="_blank" rel="noopener">GitHub</a>
      <a href={profile.contact.linkedin} target="_blank" rel="noopener">LinkedIn</a>
      <a href={withBase(profile.cv)} target="_blank" rel="noopener">CV</a>
      <a href={`mailto:${profile.contact.email}`}>Email</a>
    </div>
  </section>

  <section class="home-section">
    <div class="home-section-head">
      <h2>{uiText.recent[lang]}</h2>
      <a class="section-more" href={withBase(lang === 'zh' ? 'experience' : 'experience')}>
        {uiText.experienceMore[lang]}
      </a>
    </div>
    <div class="update-list">
      {
        recentNews.map((n) => (
          <div class="update-item">
            <div class="update-date">{n.date}</div>
            <div class="update-text">
              <span set:html={lang === 'zh' && n.htmlZh ? n.htmlZh : n.html} />
              {n.links &&
                n.links.map((l) => (
                  <>
                    {' '}
                    <a href={withBase(l.href)} target="_blank" rel="noopener">
                      {l.label}
                    </a>
                  </>
                ))}
            </div>
          </div>
        ))
      }
    </div>
  </section>

  <section class="home-section">
    <div class="home-section-head">
      <h2>{uiText.notes[lang]}</h2>
      <a class="section-more" href={withBase(lang === 'zh' ? 'zh/notes' : 'notes')}>
        {uiText.notesMore[lang]}
      </a>
    </div>
    <div class="writing-list" id="home-notes">
      <a class="home-continue" id="home-continue" href="#" hidden>
        <span class="home-continue-copy">
          <span class="home-continue-kicker">{lang === 'zh' ? '上次讀到' : 'Last read'}</span>
          <span class="home-continue-title" data-continue-title></span>
        </span>
        <span class="home-continue-btn">{lang === 'zh' ? '接著讀 →' : 'Continue →'}</span>
      </a>
      {
        homeBlocks.map((section) => (
          <section class="writing-category" aria-labelledby={`writing-${section.category}`}>
            <h3 id={`writing-${section.category}`} class="writing-category-label">
              {categoryLabels[section.category][lang]}
            </h3>
            <div class="topic-cards">
              {section.items.map((item) => {
                const key = courseKeyOf(item.id);
                const course = key ? courseByKey(key) : undefined;
                const slugs = key ? courseSlugs(key) : [];
                const href = course ? courseRoute(course.key, lang) : `${notesIndexRoute(lang)}#${item.id}`;
                return (
                  <a class="topic-card" href={withBase(href)} data-tone={course?.tone ?? 'neutral'} data-read-count={course ? '' : undefined}>
                    <span class="topic-card-title">{item.title}</span>
                    {item.description && <span class="topic-card-desc">{item.description}</span>}
                    <span class="topic-card-meta">
                      {item.noteCount} {lang === 'zh' ? '篇' : item.noteCount === 1 ? 'note' : 'notes'}
                      {item.unitCount > 1
                        ? ` · ${item.unitCount} ${lang === 'zh' ? '個單元' : 'units'}`
                        : ''}
                      {item.latest ? ` · ${formatNoteDate(item.latest, lang)}` : ''}
                    </span>
                    {course && (
                      <span class="topic-card-progress" aria-hidden="true">
                        <span class="course-progress"><span data-read-bar></span></span>
                        <span class="topic-card-count" data-read-count-out>0 / {slugs.length}</span>
                        <span hidden>
                          {slugs.map((slug) => (
                            <span data-read-slug={slug} />
                          ))}
                        </span>
                      </span>
                    )}
                  </a>
                );
              })}
            </div>
          </section>
        ))
      }
    </div>
  </section>

  <section class="home-section">
    <div class="home-section-head"><h2>{uiText.research[lang]}</h2></div>
    <ul class="research-list">
      {
        research.map((r) => (
          <li>
            <strong>{r.name}</strong>
            <span>{r.desc}</span>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="home-section">
    <div class="home-section-head">
      <h2>{uiText.selectedPubs[lang]}</h2>
      <a class="section-more" href={withBase('publications')}>{uiText.pubsMore[lang]}</a>
    </div>
    {
      selectedPubs.map((pub) => (
        <div class="pub-item">
          <div class="pub-title">
            {pub.url ? (
              <a href={pub.url} target="_blank" rel="noopener">
                {pub.title}
              </a>
            ) : (
              pub.title
            )}
          </div>
          <div class="pub-authors" set:html={pub.authors} />
          <div class="pub-venue">{pub.venue}</div>
        </div>
      ))
    }
  </section>
</main>

<script>
  import { paintReadState, readLast } from '../lib/reading';
  import { withBase } from '../lib/url';

  function initHomeNotes() {
    const root = document.getElementById('home-notes');
    if (!root) return;
    paintReadState(root);
    const last = readLast();
    const card = document.getElementById('home-continue') as HTMLAnchorElement | null;
    if (!card || !last) return;
    const zh = document.documentElement.lang?.startsWith('zh');
    const title = card.querySelector<HTMLElement>('[data-continue-title]');
    if (title) title.textContent = last.title;
    card.href = withBase(last.lang === 'zh' ? `zh/notes/${last.slug}` : `notes/${last.slug}`);
    if ((zh && last.lang !== 'zh') || (!zh && last.lang !== 'en')) {
      // Recorded in the other language: still offer it, the note page handles the language toggle.
    }
    card.hidden = false;
  }
  initHomeNotes();
</script>
