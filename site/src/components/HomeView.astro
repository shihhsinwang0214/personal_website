---
import { getCollection } from 'astro:content';
import ResearchAtlas from './ResearchAtlas.astro';
import NavigationIcon from './NavigationIcon.astro';
import PixelIcon from './PixelIcon.astro';
import ReadingResume from './ReadingResume.astro';
import { withBase } from '../lib/url';
import { profile, research, news, publications, uiText, heroContent } from '../data/content';
import type { Lang } from '../lib/notes';
import {
  tierLabels,
  courseByKey,
  courseRoute,
  formatNoteDate,
  homeSections,
  isPublishedNote,
  notesIndexRoute,
} from '../lib/notes';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;

const allNotes = await getCollection('notes');
// The home page lists only the top-level headings (course / research area);
// the notes index is where the lecture and note levels live.
const homeBlocks = homeSections(allNotes, lang);
const published = allNotes.filter((n) => isPublishedNote(n) && n.data.lang === lang);
/** Slugs per course, so the cards can show this browser's progress. */
const courseSlugs = (key: string) => {
  const course = courseByKey(key);
  if (!course) return [];
  const groups = new Set(course.lectures.map((l) => l.group));
  return published.filter((n) => groups.has(n.data.group)).map((n) => n.data.slug);
};
const courseKeyOf = (id: string) => (id.startsWith('course-') ? id.slice('course-'.length) : undefined);
const selectedPubs = publications[0].items.slice(0, 3);
const recentNews = news.slice(0, 4);
---

<main class="home home--scholar">
  <section class="hero">
    <div class="hero-opening">
    <div class="hero-copy">
    <div class="field-heading" aria-hidden="true">
      <PixelIcon name="network" size={22} />
      <span>RESEARCHER’S FIELDNOTES</span>
      <span class="field-heading-rule"></span>
    </div>
    <p class="eyebrow">{heroContent.eyebrow[lang]}</p>
    <h1 class="hero-title">Shih-Hsin Wang <span class="zh">王士欣</span></h1>
    <div class="hero-rule"></div>
    <p class="hero-lead">{lang === 'zh'
      ? '研究幾何深度學習、生成模型與 AI for Science，將直覺轉化為有理論基礎、可靠且高效的工具。'
      : 'I work on geometric deep learning, generative models and AI for Science, turning intuition into principled and practical tools.'}</p>
    </div>
    <ResearchAtlas lang={lang} />
    </div>
    <div class="path-selection-label">
      <span>{lang === 'zh' ? '選一條路線，開始探索' : 'Choose a path to explore'}</span>
      <span aria-hidden="true">SELECT A PATH</span>
    </div>
    <nav class="visitor-paths" aria-label={lang === 'zh' ? '依目的開始' : 'Start with your goal'}>
      <a href={withBase(notesIndexRoute(lang))}>
        <span class="visitor-path-cursor" aria-hidden="true">▸</span>
        <span class="visitor-path-code" aria-hidden="true">01 / 04</span>
        <NavigationIcon kind="learn" class="visitor-path-image" animate />
        <span class="visitor-path-kicker">{lang === 'zh' ? '想學習' : 'Learn'}</span>
        <strong>{lang === 'zh' ? '課程與筆記' : 'Courses & notes'} <PixelIcon name="right" size={14} /></strong>
        <span class="visitor-path-desc">{lang === 'zh' ? '依單元建立直覺、推導與實作。' : 'Build intuition through reading, derivations and experiments.'}</span>
      </a>
      <a href={withBase(lang === 'zh' ? 'zh/dojo' : 'dojo')}>
        <span class="visitor-path-cursor" aria-hidden="true">▸</span>
        <span class="visitor-path-code" aria-hidden="true">02 / 04</span>
        <NavigationIcon kind="practice" class="visitor-path-image" animate />
        <span class="visitor-path-kicker">{lang === 'zh' ? '想邊想邊學' : 'Learn through questions'}</span>
        <strong>{lang === 'zh' ? '互動學習' : 'Interactive learning'} <PixelIcon name="right" size={14} /></strong>
        <span class="visitor-path-desc">{lang === 'zh' ? '從情境與問題開始，選擇做法、比較理由。' : 'Explore situations, choose an approach and compare the reasoning.'}</span>
      </a>
      <a href={withBase(lang === 'zh' ? 'zh/publications' : 'publications')}>
        <span class="visitor-path-cursor" aria-hidden="true">▸</span>
        <span class="visitor-path-code" aria-hidden="true">03 / 04</span>
        <NavigationIcon kind="research" class="visitor-path-image" animate />
        <span class="visitor-path-kicker">{lang === 'zh' ? '想了解研究' : 'Explore the research'}</span>
        <strong>{lang === 'zh' ? '研究著作' : 'Publications'} <PixelIcon name="right" size={14} /></strong>
        <span class="visitor-path-desc">{lang === 'zh' ? '查看論文、研究主題與相關資源。' : 'Find papers, research topics and resources.'}</span>
      </a>
      <a href={withBase(lang === 'zh' ? 'zh/handbook' : 'handbook')}>
        <span class="visitor-path-cursor" aria-hidden="true">▸</span>
        <span class="visitor-path-code" aria-hidden="true">04 / 04</span>
        <NavigationIcon kind="lab" class="visitor-path-image" animate />
        <span class="visitor-path-kicker">{lang === 'zh' ? '想認識或加入團隊' : 'Meet or join the team'}</span>
        <strong>{lang === 'zh' ? '研究室與招募' : 'Lab & recruitment'} <PixelIcon name="right" size={14} /></strong>
        <span class="visitor-path-desc">{lang === 'zh' ? '認識成員、研究方式與目前招募資訊。' : 'Meet the members and learn about research and recruitment.'}</span>
      </a>
    </nav>
    <div class="hero-links">
      <a href={profile.contact.scholar} target="_blank" rel="noopener">Google Scholar</a>
      <a href={profile.contact.github} target="_blank" rel="noopener">GitHub</a>
      <a href={profile.contact.linkedin} target="_blank" rel="noopener">LinkedIn</a>
      <a href={withBase(profile.cv)} target="_blank" rel="noopener">CV</a>
      <a href={`mailto:${profile.contact.email}`}>Email</a>
    </div>
    <details class="hero-research-details">
      <summary>{lang === 'zh' ? '更多研究介紹' : 'More about my research'}</summary>
      <p>{heroContent.lead[lang]}</p>
    </details>
  </section>

  <section class="home-section">
    <div class="home-section-head">
      <h2>{uiText.notes[lang]}</h2>
      <a class="section-more" href={withBase(lang === 'zh' ? 'zh/notes' : 'notes')}>
        {uiText.notesMore[lang]}
      </a>
    </div>
    <div class="writing-list" id="home-notes">
      <ReadingResume lang={lang} notes={allNotes} />
      {
        homeBlocks.map((section) => (
          <section class="writing-category" aria-labelledby={`writing-${section.tier}`}>
            <h3 id={`writing-${section.tier}`} class="writing-category-label">
              {tierLabels[section.tier][lang]}
            </h3>
            {section.tier === 'academic-skills' ? (
              /* Craft notes are a side shelf, not a course — a light list, never a card the
                 size of a 52-note course. */
              <ul class="skill-list">
                {section.items.map((item) => (
                  <li>
                    <a href={withBase(`${notesIndexRoute(lang)}#${item.id}`)}>
                      <span class="skill-list-title">{item.title}</span>
                      <span class="skill-list-meta">
                        {item.noteCount} {lang === 'zh' ? '篇' : item.noteCount === 1 ? 'note' : 'notes'}
                      </span>
                    </a>
                  </li>
                ))}
              </ul>
            ) : (
              <div class="topic-cards">
                {section.items.map((item) => {
                  const key = courseKeyOf(item.id);
                  const course = key ? courseByKey(key) : undefined;
                  const slugs = key ? courseSlugs(key) : [];
                  const href = course ? courseRoute(course.key, lang) : `${notesIndexRoute(lang)}#${item.id}`;
                  const isFoundation = course?.kind === 'foundation';
                  return (
                    <a
                      class="topic-card"
                      href={withBase(href)}
                      data-tone={course?.tone ?? 'neutral'}
                      data-read-count={course && !isFoundation ? '' : undefined}
                    >
                      <span class="topic-card-title">{item.title}</span>
                      {item.description && <span class="topic-card-desc">{item.description}</span>}
                      <span class="topic-card-meta">
                        {isFoundation
                          ? lang === 'zh'
                            ? `被 ${item.reuse ?? 0} 篇引用`
                            : `reused by ${item.reuse ?? 0} notes`
                          : item.unitCount > 1
                            ? `${item.unitCount} ${lang === 'zh' ? '個單元' : 'units'}`
                            : ''}
                        {item.latest ? `${isFoundation || item.unitCount > 1 ? ' · ' : ''}${formatNoteDate(item.latest, lang)}` : ''}
                      </span>
                      {course && !isFoundation && (
                        <span class="topic-card-progress" aria-hidden="true">
                          <span class="course-progress"><span data-read-bar></span></span>
                          <span class="topic-card-count" data-read-count-out>0 / {slugs.length}</span>
                          <span hidden>
                            {slugs.map((slug) => (
                              <span data-read-slug={slug} />
                            ))}
                          </span>
                        </span>
                      )}
                    </a>
                  );
                })}
              </div>
            )}
          </section>
        ))
      }
    </div>
  </section>

  <section class="home-section">
    <div class="home-section-head">
      <h2>{uiText.recent[lang]}</h2>
      <a class="section-more" href={withBase(lang === 'zh' ? 'zh/experience' : 'experience')}>
        {uiText.experienceMore[lang]}
      </a>
    </div>
    <div class="update-list">
      {
        recentNews.map((n) => (
          <div class="update-item">
            <div class="update-date">{n.date}</div>
            <div class="update-text">
              <span set:html={lang === 'zh' && n.htmlZh ? n.htmlZh : n.html} />
              {n.links &&
                n.links.map((l) => (
                  <>
                    {' '}
                    <a href={withBase(l.href)} target="_blank" rel="noopener">
                      {l.label}
                    </a>
                  </>
                ))}
            </div>
          </div>
        ))
      }
    </div>
  </section>

  <section class="home-section">
    <div class="home-section-head"><h2>{uiText.research[lang]}</h2></div>
    <ul class="research-list">
      {
        research.map((r) => (
          <li>
            <strong>{r.name}</strong>
            <span>{r.desc}</span>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="home-section">
    <div class="home-section-head">
      <h2>{uiText.selectedPubs[lang]}</h2>
      <a class="section-more" href={withBase(lang === 'zh' ? 'zh/publications' : 'publications')}>{uiText.pubsMore[lang]}</a>
    </div>
    {
      selectedPubs.map((pub) => (
        <div class="pub-item">
          <div class="pub-title">
            {pub.url ? (
              <a href={pub.url} target="_blank" rel="noopener">
                {pub.title}
              </a>
            ) : (
              pub.title
            )}
          </div>
          <div class="pub-authors" set:html={pub.authors} />
          <div class="pub-venue">{pub.venue}</div>
        </div>
      ))
    }
  </section>
</main>

<script>
  import { paintReadState } from '../lib/reading';
  paintReadState(document.getElementById('home-notes') ?? document);
</script>
