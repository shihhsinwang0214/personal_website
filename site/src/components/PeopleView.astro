---
/**
 * PeopleView.astro — the expedition screen.
 *
 * Every card is on the page at once, grouped by role. An earlier version used a
 * roster menu plus one detail panel; it looked more like a game UI, but it hid
 * nine people behind nine clicks. A People page is read for the overview, so
 * the overview wins. Card-per-person also means: Ctrl+F finds everyone, every
 * card has its own anchor, and the page needs no JavaScript at all.
 *
 * The PI is simply the first group — the leader is on the expedition too.
 * Per-person extras (second photo, links, gilded frame) are optional fields on
 * the same record, so nobody needs a second layout.
 */
import HandbookSidebar from './HandbookSidebar.astro';
import { withBase } from '../lib/url';
import type { Lang, Person } from '../lib/handbook';
import {
  labMembers,
  peopleHeading,
  piHeading,
  statLabels,
  partyHeading,
  recruitingTag,
  recruitmentStatus,
} from '../lib/handbook';
import { profile } from '../data/content';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;

/** First character of a name — the placeholder when there is no photo. */
const monogram = (name: string) => Array.from(name)[0] ?? '?';
/** Photo filenames include CJK and spaces; encode so every host serves them. */
const photoUrl = (p?: string) => (p ? encodeURI(withBase(p)) : '');
/** Stable per-person anchor, so a card can be linked to directly. */
const anchorFor = (p: Person) => `m-${p.nameEn || p.name}`;

/** Optional links on a card. Members will mostly use `homepage`; the rest are
 *  here so the same field works for anyone who has them. */
const linkList = (p: Person) => {
  const l = p.links ?? {};
  return [
    l.homepage ? { label: 'Homepage', href: l.homepage } : null,
    l.email ? { label: 'Email', href: `mailto:${l.email}` } : null,
    l.scholar ? { label: 'Scholar', href: l.scholar } : null,
    l.github ? { label: 'GitHub', href: l.github } : null,
  ].filter((x): x is { label: string; href: string } => x !== null);
};

/** Only the stat rows that have something in them — a card of em-dashes reads
 *  as neglect, and most members have not filled these in yet. */
const statsFor = (p: Person) =>
  [
    p.focus ? { label: statLabels.quest, value: p.focus } : null,
    p.since ? { label: statLabels.joined, value: p.since } : null,
    p.interests ? { label: statLabels.hobby, value: p.interests } : null,
  ].filter((x): x is { label: string; value: string } => x !== null);

// The PI, expressed as a roster entry so there is only one card layout.
const piPerson: Person = {
  name: profile.name,
  nameEn: profile.nameZh,
  photo: profile.photoPeople ?? profile.avatar,
  photoAlt: 'images/people/shwang-snowboard-card.jpg',
  since: '2026 Fall',
  interests: 'Snowboarding, bartending',
  foil: true,
};

const groups: { label: string; people: Person[] }[] = [
  { label: piHeading[lang], people: [piPerson] },
  ...labMembers.map((g) => ({ label: g.label[lang], people: g.people })),
];
const total = groups.reduce((n, g) => n + g.people.length, 0);

/** Corners of the gilded frame. One motif in a <symbol>, referenced four times
 *  and rotated by CSS. (Astro frontmatter is TypeScript, not JSX — markup
 *  cannot be stored in a variable here.) */
const foilCorners = ['tl', 'tr', 'br', 'bl'] as const;
const anyFoil = groups.some((g) => g.people.some((p) => p.foil));
---

<main class="handbook-shell" id="note-main">
  <HandbookSidebar lang={lang} current="people" />

  <article class="handbook-article">
    <header class="note-header">
      <p class="note-meta">
        👥 {peopleHeading[lang]}
        <span class="node-counter">{total} MEMBERS</span>
      </p>
      <h1>{peopleHeading[lang]}</h1>
    </header>

    <section class="people-group">
      <h2>{partyHeading[lang]}</h2>

      {anyFoil && (
        <svg width="0" height="0" class="foil-sprite" aria-hidden="true">
          <symbol id="foil-corner" viewBox="0 0 36 36">
            <g fill="none" stroke="currentColor" stroke-width="1.1" stroke-linecap="round">
              <path d="M4 24 Q4 4 24 4" />
              <path d="M10 24 Q10 10 24 10" />
              <path d="M4 12 L10 12" />
              <path d="M12 4 L12 10" />
              <circle cx="7" cy="7" r="1.5" fill="currentColor" stroke="none" />
            </g>
          </symbol>
        </svg>
      )}

      {groups.map((group) => (
        <div class="member-block">
          <div class="party-roster-label">
            {group.label}<span class="party-count">{group.people.length}</span>
          </div>
          <div class="member-grid">
            {group.people.map((p) => {
              const stats = statsFor(p);
              const links = linkList(p);
              const photo = photoUrl(p.photo);
              const photoAlt = photoUrl(p.photoAlt);
              return (
                <article
                  class={`member-card hud${p.foil ? ' is-foil' : ''}`}
                  id={anchorFor(p)}
                  data-photo={photo || undefined}
                  data-photo-alt={photoAlt || undefined}
                >
                  {p.foil && (
                    <div class="foil-frame" aria-hidden="true">
                      {foilCorners.map((c) => (
                        <svg class={`foil-corner foil-${c}`} viewBox="0 0 36 36"><use href="#foil-corner" /></svg>
                      ))}
                    </div>
                  )}

                  <div class="member-photo-wrap">
                    {photo ? (
                      <img class="member-photo" src={photo} alt={p.name} width="720" height="960" loading="lazy" />
                    ) : (
                      <div class="member-photo person-monogram" aria-hidden="true">{monogram(p.name)}</div>
                    )}
                    {photoAlt && (
                      <button type="button" class="party-flip" hidden aria-pressed="false">
                        <span aria-hidden="true">⇄</span>
                        <span class="visually-hidden">
                          {lang === 'zh' ? '切換另一張照片' : 'Show the other photo'}
                        </span>
                      </button>
                    )}
                  </div>

                  <div class="member-body">
                    <div class="person-name">
                      {p.name}
                      {p.nameEn && <span class="person-name-zh">{p.nameEn}</span>}
                    </div>
                    {p.role && <div class="person-role">{p.role}</div>}

                    {stats.length > 0 && (
                      <dl class="hud-stats">
                        {stats.map((s) => (
                          <div class="hud-stat"><dt>{s.label}</dt><dd>{s.value}</dd></div>
                        ))}
                      </dl>
                    )}

                    {links.length > 0 && (
                      <ul class="person-links">
                        {links.map((l) => (
                          <li>
                            <a
                              href={l.href}
                              target={l.href.startsWith('mailto:') ? undefined : '_blank'}
                              rel="noopener"
                            >{l.label}</a>
                          </li>
                        ))}
                      </ul>
                    )}
                  </div>
                </article>
              );
            })}
          </div>
        </div>
      ))}
    </section>

    <div class="quest-banner hud">
      <span class="quest-banner-tag">▸ {recruitingTag[lang]}</span>
      <p>
        {recruitmentStatus[lang]}{' '}
        {lang === 'zh' ? (
          <>目前狀況見<a href={withBase('zh/handbook/join')}>加入研究室</a>。</>
        ) : (
          <>See <a href={withBase('handbook/join')}>Join the Lab</a>.</>
        )}
      </p>
    </div>
  </article>
</main>

<script>
  /* Photo flip, per card. The button is rendered only for people who have a
     second photo and revealed only here, so with JS off a photo is just a
     photo. Everything else on this page is static. */
  (() => {
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    document.querySelectorAll<HTMLElement>('.member-card[data-photo-alt]').forEach((card) => {
      const front = card.dataset.photo ?? '';
      const back = card.dataset.photoAlt ?? '';
      const img = card.querySelector<HTMLImageElement>('.member-photo');
      const wrap = card.querySelector<HTMLElement>('.member-photo-wrap');
      const btn = card.querySelector<HTMLButtonElement>('.party-flip');
      if (!front || !back || !img || !wrap || !btn) return;

      btn.hidden = false;
      let flipped = false;

      const swap = () => {
        img.src = flipped ? back : front;
        btn.setAttribute('aria-pressed', String(flipped));
      };
      const flip = () => {
        flipped = !flipped;
        if (reduceMotion) { swap(); return; }
        wrap.classList.add('is-flipping');
        setTimeout(swap, 140);
        setTimeout(() => wrap.classList.remove('is-flipping'), 300);
      };

      btn.addEventListener('click', flip);
      img.addEventListener('click', flip);
    });
  })();
</script>
