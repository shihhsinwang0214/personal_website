---
/**
 * Remark.astro — 主線旁邊的補充：一個名詞的解釋、一個小例子、一個正式定義。
 * 一律**可收起**（預設關閉），需要的人再點開；視覺與 <Details> 同一套，只是
 * 標籤換成 補充／定義／符號…，用來說明「這一塊是什麼性質的東西」。
 *
 *   <Remark label="定義" summary="Pushforward">
 *   …markdown / math…
 *   </Remark>
 *
 * summary 是單行文字：MDX 屬性內不能放 <Ref>、粗體也不生效，但 `$…$` 可以用
 * （由 Details 呼叫 inlineMath() 渲染，見 src/lib/inlineMath.ts）。
 */
import Details from './Details.astro';

interface Props { label?: string; summary: string; open?: boolean }
const { label = '補充', summary, open = false } = Astro.props;
---

<Details label={label} summary={summary} open={open}><slot /></Details>
