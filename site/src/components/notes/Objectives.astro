---
/**
 * Objectives.astro — "學完這篇你能…" box at the top of a course note (BOPPPS: Objective).
 * Usage in .mdx:
 *   <Objectives>
 *   - 目標一
 *   - 目標二
 *   </Objectives>
 */
interface Props { title?: string }
const { title = '學完這篇，你能' } = Astro.props;
---

<aside class="objectives">
  <p class="objectives-title">{title}</p>
  <div class="objectives-body"><slot /></div>
</aside>

<style>
  .objectives {
    margin: 0 0 28px;
    padding: 16px 20px;
    border: 1px solid var(--border);
    border-radius: var(--radius, 12px);
    background: var(--box-ml-bg, var(--surface-2));
  }
  .objectives-title {
    margin: 0 0 8px;
    font-size: 0.78rem; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase;
    color: var(--accent);
  }
  .objectives-body :global(ul) { margin: 0; padding-left: 1.2em; }
  .objectives-body :global(li) { margin: 4px 0; line-height: 1.6; }
  .objectives-body :global(p) { margin: 0; }
</style>
