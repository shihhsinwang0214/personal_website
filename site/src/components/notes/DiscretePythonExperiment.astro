---
import PythonCell from '../dojo/PythonCell.astro';
import transition from '../../../public/notes/notebooks/diffusion-models-applications/dma-u4-transition.py?raw';
import referenceRate from '../../../public/notes/notebooks/diffusion-models-applications/dma-u4-reference-rate.py?raw';
import sequence from '../../../public/notes/notebooks/diffusion-models-applications/dma-u4-sequence-transition.py?raw';
import posterior from '../../../public/notes/notebooks/diffusion-models-applications/dma-u4-learn-posterior.py?raw';
import contextPosterior from '../../../public/notes/notebooks/diffusion-models-applications/dma-u4-context-posterior.py?raw';
import sampler from '../../../public/notes/notebooks/diffusion-models-applications/dma-u4-mask-sampler.py?raw';
import joint from '../../../public/notes/notebooks/diffusion-models-applications/dma-u4-joint-sampling.py?raw';
import remasking from '../../../public/notes/notebooks/diffusion-models-applications/dma-u4-balanced-remasking.py?raw';
import paritySampling from '../../../public/notes/notebooks/diffusion-models-applications/dma-u4-parity-sampling.py?raw';
import samplingErrors from '../../../public/notes/notebooks/diffusion-models-applications/dma-u4-sampling-errors.py?raw';
const examples = {
  referenceRate: {code: referenceRate, summary: '執行 Python：用 reference rate 分批填回原字'},
  transition: {code: transition, summary: '執行 Python：同一張矩陣，更新 PMF 也更新樣本'},
  sequence: {code: sequence, summary: '執行 Python：對每格抽樣，更新整句 sequence'},
  posterior: {code: posterior, summary: '執行 Python：從原字 labels 學出 PMF'},
  contextPosterior: {code: contextPosterior, summary: '執行 Python：翻開一格後，模型會改變另一格的機率嗎？'},
  sampler: {code: sampler, summary: '執行 Python：從全 MASK 生成一句話'},
  joint: {code: joint, summary: '執行 Python：同批填字與逐格填字'},
  remasking: {code: remasking, summary: '執行 Python：相等 rate 與相等 flow 的差別'},
  paritySampling: {code: paritySampling, summary: '執行 Python：三種方法補完同一張 parity snapshot'},
  samplingErrors: {code: samplingErrors, summary: '執行 Python：分開檢查時間、修改與預測誤差'},
};
interface Props { example: keyof typeof examples }
const { example } = Astro.props;
const item = examples[example];
---
<PythonCell id={`u4-${example}`} code={item.code} summary={item.summary} open
  intro="可以改程式前面的條件，再按「執行 Python」比較。第一次執行會下載 Python；運算在瀏覽器進行，修改的程式不會存檔。" />
