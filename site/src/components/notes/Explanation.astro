---
/** Explanation.astro — hidden until the reader picks an option in <QuizBlock>. */
---

<div class="quiz-explain" hidden>
  <slot />
</div>

<style>
  .quiz-explain {
    margin: 12px 0 0; padding: 8px 12px; font-size: 0.92rem; line-height: 1.6;
    color: var(--text-muted); border-left: 2px solid var(--border);
  }
  .quiz-explain :global(p) { margin: 0; }
  .quiz-explain :global(p + p) { margin-top: 6px; }
</style>
