---
/**
 * Question.astro — an in-class discussion prompt (提問 → 思考 → 收集 → 整理).
 * Pair with <Answer> inside it; the answer is collapsed until the reader opens it.
 *
 *   <Question id="Q2">
 *   問題敘述…
 *   <Answer>整理後的答案…</Answer>
 *   </Question>
 */
interface Props { id?: string; label?: string }
const { id, label = '課堂提問' } = Astro.props;
---

<section class="question" id={id ? `question-${id}` : undefined}>
  <p class="question-tag"><span>{label}</span>{id && <span class="question-id">{id}</span>}</p>
  <div class="question-body"><slot /></div>
</section>

<style>
  .question {
    margin: 28px 0;
    padding: 18px 22px 14px;
    border: 1px solid var(--border);
    border-left: 4px solid var(--accent);
    border-radius: var(--radius, 12px);
    background: var(--surface);
  }
  .question-tag {
    display: flex; align-items: center; gap: 8px; margin: 0 0 10px;
    font-size: 0.78rem; font-weight: 700; letter-spacing: 0.05em; color: var(--accent);
  }
  .question-id {
    padding: 1px 8px; border-radius: 999px; font-weight: 600; letter-spacing: 0;
    background: color-mix(in srgb, var(--accent) 14%, transparent);
  }
  .question-body :global(p:first-child) { margin-top: 0; }
  .question-body :global(p) { line-height: 1.7; }
</style>
