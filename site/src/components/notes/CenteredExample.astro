---
/** Center a note example while keeping wide tables scrollable on small screens. */
---

<div class="centered-example"><slot /></div>

<style>
  .centered-example {
    margin: 1.25em 0;
    text-align: center;
    overflow-x: auto;
  }
  .centered-example :global(table) {
    display: table;
    width: max-content;
    max-width: none;
    margin-inline: auto;
  }
  @media (max-width: 520px) {
    .centered-example :global(th),
    .centered-example :global(td) {
      padding-inline: 6px;
    }
  }
</style>
