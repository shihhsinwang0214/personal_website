---
/**
 * Render the whole equation once, then reveal semantic groups in teaching order.
 * Groups with the same number appear together, wherever they sit in the formula.
 * See docs/formula-steps.md for the MDX authoring convention.
 */
import katex from 'katex';
import { inlineMath } from '../../lib/inlineMath';

interface Props {
  id: string;
  title: string;
  formula: string;
  steps: { label: string; text: string }[];
  compact?: boolean;
}
const { id, title, formula, steps, compact = false } = Astro.props;
if (!id || !steps?.length || steps.some((step) => !step.label || !step.text)) {
  throw new Error('FormulaSteps needs an id and a label/text for every step.');
}
const equation = katex.renderToString(formula, {
  displayMode: true,
  throwOnError: true,
  strict: 'ignore',
  // Only the local grouping macro may add HTML classes; no URLs or inline styles.
  trust: (context) => context.command === '\\htmlClass',
  macros: { '\\reveal': String.raw`\htmlClass{formula-fragment formula-fragment-#1}{#2}` },
});
const groups = [...equation.matchAll(/class="enclosing formula-fragment formula-fragment-(\d+)"/g)]
  .map((match) => Number(match[1]));
if (groups.some((group) => group < 1 || group > steps.length)
  || steps.some((_, index) => !groups.includes(index + 1))) {
  throw new Error(`FormulaSteps ${id}: use \\reveal{1} through \\reveal{${steps.length}}.`);
}
const prefix = `formula-${id}`;
---

<section class="formula-steps" id={prefix} data-formula-steps
  data-layout={compact ? 'compact' : 'detailed'} aria-labelledby={`${prefix}-title`}>
  <header class="formula-header">
    <p class="formula-title" id={`${prefix}-title`}>{title}</p>
    {!compact && <span class="formula-progress" data-progress hidden aria-hidden="true">1 / {steps.length}</span>}
  </header>
  <div class="formula-equation" set:html={equation} />
  <ol class="formula-story">
    {steps.map((step, index) => (
      <li data-story-step={index + 1} data-step-label={step.label}>
        <span class="story-number" aria-hidden="true">{index + 1}</span>
        <span set:html={inlineMath(step.text)} />
      </li>
    ))}
  </ol>
  <footer class="formula-controls" hidden>
    <div class="formula-navigation" role="group" aria-label="公式展開步驟">
      <button type="button" data-action="first" aria-label="回到起點" title="回到起點">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M6 5v14M18 6l-6 6 6 6" />
        </svg>
      </button>
      <button type="button" data-action="previous" aria-label="上一步" title="上一步">←</button>
      {compact && <span class="formula-progress" data-progress hidden aria-hidden="true">1 / {steps.length}</span>}
      <button type="button" data-action="play" aria-pressed="false">播放</button>
      <button type="button" data-action="next" aria-label="下一步"><span class="next-label">下一步</span> <span aria-hidden="true">→</span></button>
      <button type="button" data-action="last" aria-label="一鍵到底" title="一鍵到底：顯示完整公式">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M18 5v14M6 6l6 6-6 6" />
        </svg>
      </button>
    </div>
  </footer>
  <p class="formula-sr-only" data-announcement aria-live="polite" aria-atomic="true"></p>
</section>

<style>
  .formula-steps {
    --formula-ink: #bc4908;
    margin: 26px 0;
    border: 1px solid var(--border);
    border-radius: 12px;
    background: var(--surface);
    color: var(--text);
    min-width: 0;
    overflow: hidden;
    scroll-margin-top: 100px;
  }
  :global(:root[data-theme='dark']) .formula-steps { --formula-ink: #ffae76; }
  .formula-header {
    display: flex; align-items: baseline; justify-content: space-between;
    gap: 12px; padding: 18px 22px 0;
  }
  .formula-steps .formula-title { margin: 0; font-size: .95rem; font-weight: 650; }
  .formula-progress { flex: none; color: var(--text-muted); font-size: .75rem; font-variant-numeric: tabular-nums; }
  .formula-equation { padding: 26px 18px 24px; font-size: clamp(1.15rem, 3.1vw, 1.9rem); }
  .formula-equation :global(.katex-display) { margin: 0; padding: .3em 0; }
  /* Keep the final typesetting throughout: only visibility and ink change. */
  .formula-equation :global(.formula-fragment) { color: var(--text); transition: color .25s ease; }
  /* Visibility can be overridden by an earlier child inside a later fraction
     or bracket group; ancestor opacity would hide that child as well. */
  .formula-steps[data-ready] .formula-equation :global(.formula-fragment:not(.is-future)) { visibility: visible; }
  .formula-steps[data-ready] .formula-equation :global(.is-future) { visibility: hidden; }
  .formula-steps[data-ready] .formula-equation :global(.is-current) { color: var(--formula-ink); }
  .formula-equation :global(.is-entering) { animation: formula-appear .35s ease-out both; }
  @keyframes formula-appear { from { opacity: 0; } to { opacity: 1; } }
  .formula-steps .formula-story {
    display: grid; gap: 10px; margin: 0; padding: 0 22px 22px;
    list-style: none; font-size: .91rem; line-height: 1.85;
  }
  .formula-steps .formula-story li {
    display: grid; grid-template-columns: 20px 1fr; align-items: baseline;
    gap: 10px; margin: 0; padding: 0; transition: color .25s ease;
  }
  .story-number { color: var(--text-muted); font-size: .72rem; font-variant-numeric: tabular-nums; }
  .formula-steps[data-ready] .formula-story .is-future { visibility: hidden; }
  .formula-story .is-current { color: var(--formula-ink); }
  .formula-story .is-current .story-number { color: inherit; }
  .formula-controls {
    display: flex; align-items: center; justify-content: space-between; gap: 12px;
    padding: 12px 18px; border-top: 1px solid var(--border);
    background: var(--surface-2);
  }
  .formula-navigation { display: flex; gap: 6px; }
  .formula-controls button {
    display: inline-flex; align-items: center; justify-content: center; gap: 8px;
    min-height: 40px; min-width: 40px; padding: 7px 12px;
    border: 1px solid var(--border); border-radius: 7px;
    color: var(--text); background: var(--surface);
    font: inherit; font-size: .8rem; line-height: 1.5; cursor: pointer;
  }
  .formula-controls button:hover:not(:disabled) { border-color: var(--text-muted); }
  .formula-controls button:disabled { opacity: .35; cursor: default; }
  .formula-controls button:focus-visible { outline: 2px solid var(--focus-ring); outline-offset: 3px; }
  .formula-controls button[aria-pressed='true'] { color: var(--formula-ink); border-color: currentColor; }
  .formula-sr-only {
    position: absolute; width: 1px; height: 1px; margin: -1px;
    padding: 0; overflow: hidden; clip-path: inset(50%); white-space: nowrap;
  }
  [hidden] { display: none; }
  @media (max-width: 600px) {
    .formula-header { padding: 16px 14px 0; }
    .formula-equation { padding: 24px 10px; font-size: 1.08rem; }
    .formula-steps .formula-story { padding: 0 14px 18px; font-size: .85rem; gap: 12px; }
    .formula-steps .formula-story li { grid-template-columns: 14px 1fr; gap: 7px; }
    .formula-controls { gap: 4px; row-gap: 8px; flex-wrap: wrap; padding: 10px; }
    .formula-controls button { padding: 7px 9px; }
  }
  /* Compact mode reads like a display equation with one changing annotation. */
  .formula-steps[data-layout='compact'] {
    border-width: 1px 0; border-radius: 0; background: transparent;
  }
  .formula-steps[data-layout='compact'] .formula-header {
    position: absolute; width: 1px; height: 1px; margin: -1px;
    padding: 0; overflow: hidden; clip-path: inset(50%); white-space: nowrap;
  }
  .formula-steps[data-layout='compact'] .formula-equation { padding: 14px 8px 10px; }
  .formula-steps[data-layout='compact'] .formula-story {
    padding: 0 8px; text-align: center; font-size: .86rem;
  }
  .formula-steps[data-layout='compact'] .formula-story li { display: block; }
  .formula-steps[data-layout='compact'][data-ready] .formula-story { gap: 0; }
  .formula-steps[data-layout='compact'][data-ready] .formula-story li {
    grid-area: 1 / 1; display: block; visibility: hidden;
  }
  .formula-steps[data-layout='compact'][data-ready] .formula-story .is-active { visibility: visible; }
  .formula-steps[data-layout='compact'] .story-number { display: none; }
  .formula-steps[data-layout='compact'] .formula-controls {
    justify-content: center; padding: 5px 0 9px; border: 0; background: transparent;
  }
  .formula-steps[data-layout='compact'] .formula-navigation { align-items: center; gap: 6px; }
  .formula-steps[data-layout='compact'] .formula-controls button {
    border-color: transparent; background: transparent;
    min-width: 36px; min-height: 36px; padding: 4px; font-size: .95rem;
  }
  .formula-steps[data-layout='compact'] .formula-controls button:hover:not(:disabled) { color: var(--formula-ink); }
  .formula-steps[data-layout='compact'] .formula-progress { min-width: 44px; text-align: center; }
  .formula-steps[data-layout='compact'] :is([data-action='play'], .next-label) { display: none; }
  @media (max-width: 600px) {
    .formula-steps[data-layout='compact'] .formula-equation { padding-left: 0; padding-right: 0; }
  }
  @media (prefers-reduced-motion: reduce) {
    .formula-equation :global(.formula-fragment), .formula-story li { transition: none; animation: none; }
  }
  @media print {
    .formula-steps { break-inside: avoid; background: transparent; overflow: visible; }
    .formula-controls, .formula-progress { display: none !important; }
    .formula-steps[data-ready] .formula-equation :global(.formula-fragment),
    .formula-steps[data-ready] .formula-story li {
      opacity: 1 !important; visibility: visible !important;
      color: var(--text) !important; animation: none;
    }
    .formula-steps[data-layout='compact'][data-ready] .formula-story { gap: 8px; text-align: left; }
    .formula-steps[data-layout='compact'][data-ready] .formula-story li { grid-area: auto; }
  }
</style>

<script>
  function bindFormulaSteps() {
    document.querySelectorAll<HTMLElement>('[data-formula-steps]').forEach((root) => {
      if (root.dataset.ready) return;
      const stories = Array.from(root.querySelectorAll<HTMLElement>('[data-story-step]'));
      const stepOf = (element: HTMLElement) => Number(element.className.match(/formula-fragment-(\d+)/)?.[1]);
      const fragments = Array.from(root.querySelectorAll<HTMLElement>('.formula-fragment')).map((element) => ({
        element,
        step: stepOf(element),
        // Fading an enclosing group must not fade its already-visible children.
        animate: Array.from(element.querySelectorAll<HTMLElement>('.formula-fragment'))
          .every((child) => stepOf(child) >= stepOf(element)),
      }));
      const controls = root.querySelector<HTMLElement>('.formula-controls')!;
      const first = root.querySelector<HTMLButtonElement>('[data-action="first"]')!;
      const previous = root.querySelector<HTMLButtonElement>('[data-action="previous"]')!;
      const next = root.querySelector<HTMLButtonElement>('[data-action="next"]')!;
      const end = root.querySelector<HTMLButtonElement>('[data-action="last"]')!;
      const play = root.querySelector<HTMLButtonElement>('[data-action="play"]')!;
      const progress = root.querySelector<HTMLElement>('[data-progress]')!;
      const announcement = root.querySelector<HTMLElement>('[data-announcement]')!;
      const last = stories.length + 1; // A final, neutral-ink view after the last reveal.
      let current = 1;
      let playing = false;
      let timer: number | undefined;

      function pause() {
        playing = false;
        window.clearTimeout(timer);
        play.textContent = '播放';
        play.setAttribute('aria-pressed', 'false');
      }
      function show(step: number, announce = true) {
        current = Math.max(1, Math.min(last, step));
        root.dataset.step = String(current);
        fragments.forEach(({ element, step: group, animate }) => {
          const wasHidden = element.classList.contains('is-future');
          element.classList.toggle('is-future', group > current);
          element.classList.toggle('is-current', group === current);
          element.classList.toggle('is-entering', animate && wasHidden && group <= current);
        });
        stories.forEach((story, index) => {
          story.classList.toggle('is-future', index + 1 > current);
          story.classList.toggle('is-current', index + 1 === current);
          story.classList.toggle('is-active', index + 1 === Math.min(current, stories.length));
        });
        first.disabled = previous.disabled = current === 1;
        end.disabled = next.disabled = current === last;
        progress.textContent = current === last ? '完整公式' : `${current} / ${stories.length}`;
        if (announce) announcement.textContent = current === last ? '完整公式與說明已顯示。'
          : `第 ${current} 步，共 ${stories.length} 步：${stories[current - 1].dataset.stepLabel}`;
        if (current === last) pause();
      }
      function schedule() {
        if (!playing) return;
        timer = window.setTimeout(() => {
          show(current + 1);
          schedule();
        }, 4500);
      }
      first.addEventListener('click', () => { pause(); show(1); });
      previous.addEventListener('click', () => { pause(); show(current - 1); });
      next.addEventListener('click', () => { pause(); show(current + 1); });
      end.addEventListener('click', () => { pause(); show(last); });
      play.addEventListener('click', () => {
        if (playing) { pause(); return; }
        // Give immediate feedback; subsequent concepts leave time for reading.
        show(current === last ? 1 : current + 1);
        if (current === last) return;
        playing = true;
        play.textContent = '暫停';
        play.setAttribute('aria-pressed', 'true');
        schedule();
      });
      controls.addEventListener('keydown', (event) => {
        if (!['ArrowLeft', 'ArrowRight', 'Home', 'End'].includes(event.key)) return;
        event.preventDefault();
        pause();
        show(event.key === 'Home' ? 1 : event.key === 'End' ? last
          : current + (event.key === 'ArrowRight' ? 1 : -1));
      });
      // Never keep advancing a lesson after the reader has left it.
      const observer = new IntersectionObserver(([entry]) => { if (!entry.isIntersecting) pause(); });
      observer.observe(root);
      const onVisibility = () => { if (document.hidden) pause(); };
      document.addEventListener('visibilitychange', onVisibility);
      document.addEventListener('astro:before-swap', () => {
        pause(); observer.disconnect();
        document.removeEventListener('visibilitychange', onVisibility);
      }, { once: true });
      show(1, false);
      root.dataset.ready = 'true';
      controls.hidden = false;
      progress.hidden = false;
    });
  }
  bindFormulaSteps();
  document.addEventListener('astro:page-load', bindFormulaSteps);
</script>
