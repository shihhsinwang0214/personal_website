---
import { pixelIcons, type PixelIconName } from '../lib/pixelIcons';
interface Props { name: PixelIconName; size?: number; class?: string }
const { name, size = 20, class: className } = Astro.props;
---
<svg class:list={['pixel-icon', className]} data-icon={name} viewBox="0 0 32 32" width={size} height={size} aria-hidden="true" focusable="false" shape-rendering="crispEdges">
  <Fragment set:html={pixelIcons[name]} />
</svg>
