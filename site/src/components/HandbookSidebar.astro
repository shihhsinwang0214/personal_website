---
/**
 * HandbookSidebar.astro — navigation for the whole lab area.
 *
 * Each group is a native <details>, so collapsing works with no JavaScript and
 * is keyboard-operable for free. Groups start open: the sidebar is the only way
 * to see what the handbook contains, and a nav that hides itself by default
 * costs more than the scrolling it saves. The script only adds memory — which
 * groups you closed, kept in this browser.
 */
import { getCollection } from 'astro:content';
import { withBase } from '../lib/url';
import type { Lang } from '../lib/handbook';
import {
  expeditionTag,
  handbookNav,
  handbookRoute,
  handbookIndexRoute,
  handbookTitle,
  handbookTitleFormal,
  peopleHeading,
  peopleRoute,
} from '../lib/handbook';
import { bestiaryHeading, bestiaryRoute, visibleMonsters } from '../lib/bestiary';
import { missionsRoute, missionText, visibleQuests } from '../lib/mission';

interface Props {
  lang: Lang;
  /** Article slug, or 'people' / 'bestiary' / 'missions' / 'index'. */
  current?: string;
}
const { lang, current } = Astro.props;
const all = await getCollection('handbook');
const nav = handbookNav(all, lang);
// The codex and the board only appear once something in them is published.
const codexOpen = visibleMonsters().length > 0;
const boardOpen = visibleQuests().length > 0;
---

<details class="handbook-sidebar">
  <summary class="handbook-sidebar-head">
    <a
      href={withBase(handbookIndexRoute(lang))}
      aria-current={current === 'index' ? 'page' : undefined}
    >
      {handbookTitle[lang]}
      {handbookTitleFormal[lang] !== handbookTitle[lang] && (
        <span class="handbook-sidebar-sub">{handbookTitleFormal[lang]}</span>
      )}
    </a>
    <svg class="disclosure-chevron" viewBox="0 0 20 20" aria-hidden="true"><path d="M7 4.5 12.5 10 7 15.5" /></svg>
  </summary>
  <nav class="handbook-nav" aria-label={lang === 'zh' ? '手冊導覽' : 'Handbook navigation'}>
    <details class="handbook-nav-group" data-group="people" open>
      <summary class="handbook-nav-label">
        <span class="nav-label-row">
          <span aria-hidden="true">👥</span> {peopleHeading[lang]}
          <svg class="nav-chevron" viewBox="0 0 20 20" aria-hidden="true"><path d="M7 4.5 12.5 10 7 15.5" /></svg>
        </span>
        <span class="handbook-nav-tag">{expeditionTag}</span>
      </summary>
      <ul>
        <li>
          <a href={withBase(peopleRoute(lang))} aria-current={current === 'people' ? 'page' : undefined}>
            {peopleHeading[lang]}
          </a>
        </li>
      </ul>
    </details>

    {boardOpen && (
      <details class="handbook-nav-group" data-group="missions" open>
        <summary class="handbook-nav-label">
          <span class="nav-label-row">
          <span aria-hidden="true">🗺</span> {missionText.boardHeading[lang]}
          <svg class="nav-chevron" viewBox="0 0 20 20" aria-hidden="true"><path d="M7 4.5 12.5 10 7 15.5" /></svg>
        </span>
        <span class="handbook-nav-tag">MISSIONS</span>
        </summary>
        <ul>
          <li>
            <a href={withBase(missionsRoute(lang))} aria-current={current === 'missions' ? 'page' : undefined}>
              {missionText.boardHeading[lang]}
            </a>
          </li>
        </ul>
      </details>
    )}

    {codexOpen && (
      <details class="handbook-nav-group" data-group="codex" open>
        <summary class="handbook-nav-label">
          <span class="nav-label-row">
          <span aria-hidden="true">👾</span> {bestiaryHeading[lang]}
          <svg class="nav-chevron" viewBox="0 0 20 20" aria-hidden="true"><path d="M7 4.5 12.5 10 7 15.5" /></svg>
        </span>
        <span class="handbook-nav-tag">CODEX</span>
        </summary>
        <ul>
          <li>
            <a href={withBase(bestiaryRoute(lang))} aria-current={current === 'bestiary' ? 'page' : undefined}>
              {bestiaryHeading[lang]}
            </a>
          </li>
        </ul>
      </details>
    )}

    {nav.map((group) => (
      <details class="handbook-nav-group" data-group={group.section.key} open>
        <summary class="handbook-nav-label">
          <span class="nav-label-row">
          <span aria-hidden="true">{group.section.icon}</span> {group.section.label[lang]}
          <svg class="nav-chevron" viewBox="0 0 20 20" aria-hidden="true"><path d="M7 4.5 12.5 10 7 15.5" /></svg>
        </span>
        <span class="handbook-nav-tag">{group.section.tag}</span>
        </summary>
        <ul>
          {group.items.map((item) => (
            <li>
              <a
                href={withBase(handbookRoute(item.data.slug, lang))}
                aria-current={item.data.slug === current ? 'page' : undefined}
              >
                {item.data.title}
              </a>
            </li>
          ))}
        </ul>
      </details>
    ))}
  </nav>
</details>

<script>
  /* Remember which nav groups were collapsed, so the choice survives navigating
     to another page. Local to this browser, never sent anywhere. The group
     holding the current page is always opened — otherwise you would lose sight
     of where you are. */
  (() => {
    const KEY = 'slam:navclosed';
    const groups = Array.from(document.querySelectorAll<HTMLDetailsElement>('.handbook-nav-group[data-group]'));
    if (!groups.length) return;

    const read = (): Set<string> => {
      try {
        const raw = localStorage.getItem(KEY);
        const parsed: unknown = raw ? JSON.parse(raw) : [];
        return Array.isArray(parsed) ? new Set(parsed.filter((s): s is string => typeof s === 'string')) : new Set();
      } catch {
        return new Set();
      }
    };
    const write = (closed: Set<string>) => {
      try {
        localStorage.setItem(KEY, JSON.stringify([...closed]));
      } catch {
        /* private mode — collapsing still works, it just will not be remembered */
      }
    };

    const closed = read();
    groups.forEach((g) => {
      const key = g.dataset.group;
      if (!key) return;
      const hasCurrent = Boolean(g.querySelector('[aria-current="page"]'));
      g.open = hasCurrent || !closed.has(key);
      g.addEventListener('toggle', () => {
        const next = read();
        if (g.open) next.delete(key);
        else next.add(key);
        write(next);
      });
    });
  })();
</script>
