---
import { getCollection } from 'astro:content';
import { withBase } from '../lib/url';
import type { Lang } from '../lib/handbook';
import { handbookNav, handbookRoute, handbookIndexRoute, labInfo } from '../lib/handbook';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const all = await getCollection('handbook');
const nav = handbookNav(all, lang);
---

<main class="handbook-shell" id="note-main">
  <details class="handbook-sidebar" open>
    <summary class="handbook-sidebar-head">
      <a href={withBase(handbookIndexRoute(lang))} aria-current="page">{lang === 'zh' ? '實驗室手冊' : 'Lab Handbook'}</a>
      <svg class="disclosure-chevron" viewBox="0 0 20 20" aria-hidden="true"><path d="M7 4.5 12.5 10 7 15.5" /></svg>
    </summary>
    <nav class="handbook-nav" aria-label={lang === 'zh' ? '手冊導覽' : 'Handbook navigation'}>
      {nav.map((group) => (
        <div class="handbook-nav-group">
          <div class="handbook-nav-label"><span aria-hidden="true">{group.section.icon}</span> {group.section.label[lang]}</div>
          <ul>
            {group.items.map((item) => (
              <li>
                <a href={withBase(handbookRoute(item.data.slug, lang))}>{item.data.title}</a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </nav>
  </details>

  <article class="handbook-article lab-home">
    <section class="lab-hero">
      <svg class="lab-contour" viewBox="0 0 380 120" preserveAspectRatio="none" aria-hidden="true">
        <path d="M0,30 C90,6 210,52 380,16" />
        <path d="M0,56 C110,34 240,78 380,44" />
        <path d="M0,82 C100,64 230,104 380,74" />
      </svg>
      <p class="eyebrow">{labInfo.eyebrow[lang]}</p>
      <h1 class="lab-title">{labInfo.name}</h1>
      <p class="lab-subtitle">{labInfo.subtitle}</p>
      <p class="lab-gloss">{labInfo.nameGloss[lang]}</p>
      <div class="lab-rule"></div>
      <p class="lab-lead">{labInfo.description[lang]}</p>
    </section>

    <section class="lab-philosophy">
      <h2>{labInfo.philosophyHeading[lang]}</h2>
      <blockquote class="lab-statement">{labInfo.philosophy[lang]}</blockquote>
      <div class="lab-pillars">
        {labInfo.pillars.map((p) => (
          <div class="lab-pillar">
            <div class="lab-pillar-label">{p.label[lang]}</div>
            <p>{p.text[lang]}</p>
          </div>
        ))}
      </div>
    </section>
  </article>
</main>
