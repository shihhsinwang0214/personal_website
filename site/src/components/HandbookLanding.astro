---
/**
 * HandbookLanding.astro — the lab homepage, as an expedition command dashboard.
 *
 * Rules this page follows (docs/lab-expedition-redesign.md):
 *   - Every panel is backed by real current content. No placeholder panels: if
 *     the data is not there, the panel is not rendered. A dashboard of empty
 *     boxes reads as a dead lab, which is worse than a document.
 *   - Game language lives in the mono labels, the panel chrome and the status
 *     indicators. The content itself stays in academic language.
 *   - Static first. The only script is the visited-node highlight and the role
 *     picker, both of which are enhancements over links that already work.
 */
import { getCollection } from 'astro:content';
import HandbookSidebar from './HandbookSidebar.astro';
import { withBase } from '../lib/url';
import type { Lang } from '../lib/handbook';
import {
  handbookNav,
  handbookRoute,
  labInfo,
  labMembers,
  peopleHeading,
  peopleRoute,
  piHeading,
  recruitingTag,
  recruitmentStatus,
  roleCards,
} from '../lib/handbook';
import { bestiaryHeading, bestiaryRoute, visibleMonsters } from '../lib/bestiary';
import { missionText, missionsRoute, visibleQuests } from '../lib/mission';
import { profile, news } from '../data/content';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const all = await getCollection('handbook');
const nav = handbookNav(all, lang);
// Only offer a role whose section actually has visible pages right now.
const liveSections = new Set(nav.map((g) => g.section.key));
const visibleRoles = roleCards.filter((r) => liveSections.has(r.section));
const codex = visibleMonsters();

const crewCount = labMembers.reduce((n, g) => n + g.people.length, 0);
const crewAvatars = labMembers
  .flatMap((g) => g.people)
  .filter((p) => p.photo)
  .slice(0, 6);
const latest = news[0];
// The board is hidden until quests are reviewed; Main Mission stays either way.
const quests = visibleQuests();

const t = {
  leader: piHeading[lang],
  crew: { en: 'Crew', zh: '隊伍' }[lang],
  dispatch: { en: 'Latest Dispatch', zh: '最新動態' }[lang],
  recruitment: { en: 'Recruitment', zh: '招募狀態' }[lang],
  joinLink: { en: 'Join the expedition →', zh: '加入研究室 →' }[lang],
  crewLink: { en: 'Full crew →', zh: '所有成員 →' }[lang],
  leaderLink: { en: 'Profile →', zh: '個人頁 →' }[lang],
  manual: { en: 'Field Manual', zh: '遠征攻略' }[lang],
  manualHint: { en: 'pick a path', zh: '選一條開始' }[lang],
};
---

<main class="handbook-shell" id="note-main">
  <HandbookSidebar lang={lang} current="index" />

  <article class="handbook-article lab-home">
    <section class="lab-hero">
      <p class="eyebrow">{labInfo.eyebrow[lang]}</p>
      <h1 class="lab-title">{labInfo.name}</h1>
      <p class="lab-subtitle">{labInfo.subtitle}</p>
      <p class="lab-gloss">{labInfo.nameGloss[lang]}</p>
    </section>

    <div class="console">
      {/* ── Main Mission — the conceptual centre, spanning the console ── */}
      <section class="panel panel-wide hud" id="main-mission">
        <div class="panel-head">
          <span class="panel-label">{missionText.mainMission[lang]}</span>
        </div>
        <blockquote class="lab-statement">{labInfo.philosophy[lang]}</blockquote>
        <div class="lab-pillars">
          {labInfo.pillars.map((p) => (
            <div class="lab-pillar">
              <div class="lab-pillar-label">{p.label[lang]}</div>
              <p>{p.text[lang]}</p>
            </div>
          ))}
        </div>
      </section>

      {/* ── Active main quests — parallel, not a roadmap. Rendered only when
             quests are published; see `draftQuestIds` in lib/mission.ts. ── */}
      {quests.length > 0 && (
        <section class="panel hud">
          <div class="panel-head">
            <span class="panel-label">{missionText.activeQuests[lang]}</span>
            <span class="panel-count">{quests.length}</span>
          </div>
          <ol class="quest-list">
            {quests.map((q) => (
              <li>
                <a href={`${withBase(missionsRoute(lang))}#${q.id}`}>
                  <span class="quest-code">{q.code}</span>
                  <span class="quest-name">{q.title}</span>
                </a>
              </li>
            ))}
          </ol>
          <a class="panel-link" href={withBase(missionsRoute(lang))}>{missionText.viewBoard[lang]}</a>
        </section>
      )}

      {/* ── Expedition leader ── */}
      <section class="panel hud">
        <div class="panel-head">
          <span class="panel-label">{t.leader}</span>
        </div>
        <div class="panel-leader">
          <img
            class="panel-leader-photo"
            src={encodeURI(withBase(profile.photoPeople ?? profile.avatar))}
            alt={profile.name}
            width="720"
            height="960"
            loading="lazy"
          />
          <div>
            <div class="person-name">{profile.name} <span class="person-name-zh">{profile.nameZh}</span></div>
            <div class="person-role">{profile.roleShort[lang]}</div>
          </div>
        </div>
        <a class="panel-link" href={withBase(peopleRoute(lang))}>{t.leaderLink}</a>
      </section>

      {/* ── Crew ── */}
      <section class="panel hud">
        <div class="panel-head">
          <span class="panel-label">{t.crew}</span>
          <span class="panel-count">{crewCount}</span>
        </div>
        {crewAvatars.length > 0 && (
          <div class="crew-strip">
            {crewAvatars.map((p) => (
              <img src={encodeURI(withBase(p.photo!))} alt={p.name} width="720" height="960" loading="lazy" />
            ))}
          </div>
        )}
        <ul class="crew-groups">
          {labMembers.map((g) => (
            <li><span>{g.label[lang]}</span><span class="panel-count">{g.people.length}</span></li>
          ))}
        </ul>
        <a class="panel-link" href={withBase(peopleRoute(lang))}>{t.crewLink}</a>
      </section>

      {/* ── Latest dispatch ── */}
      {latest && (
        <section class="panel hud">
          <div class="panel-head">
            <span class="panel-label">{t.dispatch}</span>
            <span class="panel-stamp">{latest.date}</span>
          </div>
          <p class="dispatch-body" set:html={lang === 'zh' ? latest.htmlZh ?? latest.html : latest.html} />
        </section>
      )}

      {/* ── Recruitment status ── */}
      <section class="panel hud">
        <div class="panel-head">
          <span class="panel-label">{t.recruitment}</span>
          <span class="panel-status">{recruitingTag[lang]}</span>
        </div>
        <p class="dispatch-body">{recruitmentStatus[lang]}</p>
        <a class="panel-link" href={withBase(handbookRoute('join', lang))}>{t.joinLink}</a>
      </section>
    </div>

    <section class="lab-tree">
      <div class="lab-section-head">
        <h2>{t.manual}</h2>
        <span class="lab-tree-hint">{t.manualHint}</span>
      </div>

      {/* Role picker. Anchors, so it works with JS off; the script upgrades it
          to a highlight. Cards live in `roleCards` in lib/handbook.ts. */}
      <nav class="lab-roles" aria-label={lang === 'zh' ? '路線建議' : 'Suggested paths'}>
        <span class="lab-roles-q">{lang === 'zh' ? '你是誰？' : 'Who are you?'}</span>
        {visibleRoles.map((r) => (
          <a class="lab-role" href={`#path-${r.section}`} data-section={r.section} title={r.desc[lang]}>
            <span aria-hidden="true">{r.icon}</span> {r.title[lang]}
          </a>
        ))}
      </nav>

      <div class="lab-tree-paths">
        {nav.map((group) => (
          <div class="lab-tree-path" id={`path-${group.section.key}`} data-section={group.section.key}>
            <div class="lab-tree-head">
              <span class="lab-tree-icon" aria-hidden="true">{group.section.icon}</span>
              <span class="lab-tree-title">{group.section.label[lang]}</span>
              <span class="lab-tree-tag">{group.section.tag}</span>
            </div>
            <ol class="lab-tree-nodes">
              {group.items.map((item) => (
                <li data-slug={item.data.slug}>
                  <a href={withBase(handbookRoute(item.data.slug, lang))}>
                    <span class="lab-tree-dot" aria-hidden="true"></span>
                    {item.data.title}
                  </a>
                </li>
              ))}
            </ol>
          </div>
        ))}
      </div>

      {/* Revealed by script only — with JS off there is nothing to explain. */}
      <p class="lab-tree-legend" hidden>
        <span class="lab-tree-swatch" aria-hidden="true"></span>
        <span>
          {lang === 'zh'
            ? '亮起來的是這台瀏覽器讀過的頁。這筆紀錄只留在你的裝置上，不會傳出去，我也看不到。'
            : 'Lit nodes are pages this browser has opened. That record stays on your device — it is never sent, and I cannot see it.'}
        </span>
        <button type="button" class="lab-tree-clear">{lang === 'zh' ? '清除紀錄' : 'Clear'}</button>
      </p>
    </section>

    {codex.length > 0 && (
    <a class="lab-codex hud" href={withBase(bestiaryRoute(lang))}>
      <span class="lab-codex-icon" aria-hidden="true">👾</span>
      <span class="lab-codex-body">
        <span class="lab-codex-title">{bestiaryHeading[lang]}<span class="lab-codex-count">{codex.length}</span></span>
        <span class="lab-codex-text">
          {lang === 'zh'
            ? '研究路上會遇到的困難，以及手冊裡對應的打法。'
            : 'The difficulties you will meet, and where the handbook deals with each.'}
        </span>
      </span>
      <span class="lab-codex-go" aria-hidden="true">▸</span>
    </a>
    )}

    <p class="lab-location">{profile.office[lang]}</p>
  </article>
</main>

<script>
  import { readVisited, clearVisited } from '../lib/visited';

  /* Light up the nodes this browser has already read. Coverage of the content,
     never a score: no percentage, no "N of M", no total anywhere. */
  const legend = document.querySelector<HTMLElement>('.lab-tree-legend');
  const nodes = Array.from(document.querySelectorAll<HTMLElement>('.lab-tree-nodes li[data-slug]'));
  const paint = () => {
    const seen = readVisited();
    let any = false;
    nodes.forEach((li) => {
      const on = Boolean(li.dataset.slug && seen.has(li.dataset.slug));
      li.classList.toggle('is-visited', on);
      if (on) any = true;
    });
    if (legend) legend.hidden = !any;
  };
  if (nodes.length) {
    paint();
    document.querySelector('.lab-tree-clear')?.addEventListener('click', () => {
      clearVisited();
      paint();
    });
  }

  /* Role picker: the anchors already jump to the right path without JS. Here we
     add the highlight so the choice is visible after landing. */
  const roles = Array.from(document.querySelectorAll<HTMLAnchorElement>('.lab-role'));
  const paths = Array.from(document.querySelectorAll<HTMLElement>('.lab-tree-path'));
  const focusPath = (key: string) => {
    roles.forEach((r) => r.classList.toggle('is-active', r.dataset.section === key));
    paths.forEach((p) => {
      p.classList.toggle('is-focus', p.dataset.section === key);
      p.classList.toggle('is-dim', p.dataset.section !== key);
    });
  };
  roles.forEach((r) => {
    r.addEventListener('click', () => {
      if (r.dataset.section) focusPath(r.dataset.section);
    });
  });
  if (location.hash.startsWith('#path-')) focusPath(location.hash.slice(6));
</script>
