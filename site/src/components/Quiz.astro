---
/**
 * Quiz.astro — a small, framework-free multiple-choice self-check for notes.
 * Used inside .mdx notes:
 *
 *   import Quiz from '../../components/Quiz.astro';
 *
 *   <Quiz
 *     q="問題敘述..."
 *     options={[
 *       { text: "選項 A", correct: true,  explain: "為什麼對" },
 *       { text: "選項 B", explain: "為什麼這樣想會偏掉" },
 *     ]}
 *   />
 *
 * Self-contained: scoped styles use the site's CSS variables, so it tracks the
 * light/dark theme automatically; the client script re-binds on view-transition
 * navigation. Multiple quizzes per page are supported.
 */
interface Option {
  text: string;
  correct?: boolean;
  explain?: string;
}
interface Props {
  q: string;
  options: Option[];
  hint?: string;
}
const { q, options, hint } = Astro.props;
---

<form class="quiz" data-quiz>
  <p class="quiz-q"><span class="quiz-tag">想一想</span>{q}</p>
  <ul class="quiz-opts">
    {
      options.map((o) => (
        <li>
          <button type="button" class="quiz-opt" data-correct={o.correct ? 'true' : 'false'}>
            <span class="quiz-mark" aria-hidden="true"></span>
            <span class="quiz-text">{o.text}</span>
          </button>
          {o.explain && <p class="quiz-explain" hidden>{o.explain}</p>}
        </li>
      ))
    }
  </ul>
  <p class="quiz-feedback" role="status" aria-live="polite"></p>
  {hint && <p class="quiz-hint">{hint}</p>}
</form>

<style>
  .quiz {
    margin: 24px 0;
    padding: 18px 20px;
    border: 1px solid var(--border);
    border-left: 4px solid var(--accent);
    border-radius: var(--radius, 12px);
    background: var(--box-ml-bg, var(--surface-2));
  }
  .quiz-q { margin: 0 0 14px; font-weight: 600; line-height: 1.5; }
  .quiz-tag {
    display: inline-block; margin-right: 8px; padding: 2px 9px;
    font-size: 0.72rem; font-weight: 700; letter-spacing: 0.03em;
    color: var(--accent); background: color-mix(in srgb, var(--accent) 14%, transparent);
    border-radius: 999px; vertical-align: middle;
  }
  .quiz-opts { list-style: none; margin: 0; padding: 0; display: grid; gap: 8px; }
  .quiz-opt {
    display: flex; align-items: flex-start; gap: 10px; width: 100%;
    text-align: left; cursor: pointer; font: inherit; color: inherit;
    padding: 11px 14px; border: 1px solid var(--border); border-radius: 10px;
    background: var(--surface); transition: border-color .15s ease, background .15s ease;
  }
  .quiz-opt:hover { border-color: var(--accent); }
  .quiz-opt:focus-visible { outline: 2px solid var(--focus-ring, var(--accent)); outline-offset: 2px; }
  .quiz-mark {
    flex: 0 0 auto; width: 18px; height: 18px; margin-top: 1px; border-radius: 50%;
    border: 2px solid var(--text-muted); display: inline-block;
  }
  .quiz-text { line-height: 1.5; }
  .quiz-opt.is-correct { border-color: #2f9e6b; background: color-mix(in srgb, #2f9e6b 12%, var(--surface)); }
  .quiz-opt.is-correct .quiz-mark { border-color: #2f9e6b; background: #2f9e6b; }
  .quiz-opt.is-wrong { border-color: #d0664a; background: color-mix(in srgb, #d0664a 10%, var(--surface)); }
  .quiz-opt.is-wrong .quiz-mark { border-color: #d0664a; }
  .quiz-explain {
    margin: 6px 0 0; padding: 8px 12px; font-size: 0.9rem; line-height: 1.55;
    color: var(--text-muted); border-left: 2px solid var(--border);
  }
  .quiz-feedback { margin: 12px 0 0; min-height: 1.2em; font-weight: 600; }
  .quiz-feedback.ok { color: #2f9e6b; }
  .quiz-feedback.no { color: #d0664a; }
  .quiz-hint { margin: 6px 0 0; font-size: 0.85rem; color: var(--text-muted); }
</style>

<script>
  function bindQuizzes() {
    document.querySelectorAll('form[data-quiz]').forEach((quiz) => {
      if ((quiz as HTMLElement).dataset.bound) return;
      (quiz as HTMLElement).dataset.bound = 'true';
      const feedback = quiz.querySelector('.quiz-feedback') as HTMLElement | null;
      const opts = Array.from(quiz.querySelectorAll<HTMLButtonElement>('.quiz-opt'));
      opts.forEach((btn) => {
        btn.addEventListener('click', () => {
          const correct = btn.dataset.correct === 'true';
          opts.forEach((b) => {
            const exp = b.parentElement?.querySelector('.quiz-explain') as HTMLElement | null;
            if (exp) exp.hidden = true;
          });
          btn.classList.remove('is-correct', 'is-wrong');
          btn.classList.add(correct ? 'is-correct' : 'is-wrong');
          const exp = btn.parentElement?.querySelector('.quiz-explain') as HTMLElement | null;
          if (exp) exp.hidden = false;
          if (feedback) {
            feedback.textContent = correct ? '對了 — 就是這個直覺。' : '再想想：看看這個選項下方的說明。';
            feedback.classList.toggle('ok', correct);
            feedback.classList.toggle('no', !correct);
          }
          if (correct) {
            opts.forEach((b) => { if (b.dataset.correct === 'true') b.classList.add('is-correct'); });
          }
        });
      });
    });
  }
  bindQuizzes();
</script>
