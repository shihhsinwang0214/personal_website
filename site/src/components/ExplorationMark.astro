---
import NavigationIcon from './NavigationIcon.astro';
import PixelIcon from './PixelIcon.astro';
import { navigationIconOrder } from '../lib/navigationIcons';
import type { PixelIconName } from '../lib/pixelIcons';
import type { NavigationIconKind } from '../lib/navigationIcons';
interface Props { kind: NavigationIconKind | PixelIconName; label: string }
const { kind, label } = Astro.props;
---
<div class="exploration-mark" aria-hidden="true">
  {navigationIconOrder.includes(kind as NavigationIconKind)
    ? <NavigationIcon kind={kind as NavigationIconKind} size="small" />
    : <PixelIcon name={kind as PixelIconName} size={32} />}
  <span>{label}</span>
</div>
