---
/**
 * The notes sky map: sky = courses drawn as constellations (one star per note), sea =
 * Machine Learning Foundations as buoy lights riding the waves, shore = Mathematical
 * Foundations as lanterns on land (which course lives where is `realm` in lib/notes.ts). Everything is inline SVG coloured through CSS
 * variables (see `--sky-*` in global.css), so both themes and print work.
 *
 * Geometry comes from `constellation` on each lecture in lib/notes.ts; prerequisite
 * threads come from the notes' `prereqs`. Read state is painted client-side.
 */
import type { CourseDef, Lang, NoteEntry } from '../lib/notes';
import {
  courseRoute,
  courses,
  hiddenCourseKeys,
  lectureAnchor,
  noteRoute,
  notesForLang,
  noteHref,
} from '../lib/notes';
import type { Constellation } from '../lib/notes';
import { groupCode, noteTitles, resolveNoteRef, stripNoteCode } from '../lib/noteRefs';
import { withBase } from '../lib/url';
import { existsSync } from 'node:fs';
import { resolve } from 'node:path';

/**
 * Painted backdrop (optional). Drop `sky-night.{webp,png}` and `sky-day.{webp,png}` into
 * `public/notes/sky/` (2240×1480, composition per claude/sky-map-art-brief.md) and the
 * scene switches from the procedural sky/sea/shore to the paintings; the stars, buoys,
 * lanterns, labels and threads stay vector on top. Missing files → procedural fallback,
 * so the page never breaks while the art is in progress.
 */
// `astro build` runs from the project root, so resolve against cwd (import.meta.url would
// point at the compiled chunk, not the source tree).
const artDir = resolve(process.cwd(), 'public/notes/sky');
const findArt = (stem: string) => {
  for (const ext of ['webp', 'png', 'jpg']) {
    if (existsSync(resolve(artDir, `${stem}.${ext}`))) return withBase(`notes/sky/${stem}.${ext}`);
  }
  return undefined;
};
const artNight = findArt('sky-night');
const artDay = findArt('sky-day');
const painted = Boolean(artNight && artDay);

interface Props {
  notes: NoteEntry[];
  lang: Lang;
}
const { notes, lang } = Astro.props;
const zh = lang === 'zh';
const titles = await noteTitles();
const published = notesForLang(notes, lang);

const W = 1120;
const H = 740;
const HORIZON = 440;

// Deterministic "random" so the dust and waves are identical on every build.
let seed = 20260914;
const rand = () => {
  seed = (seed * 1664525 + 1013904223) % 4294967296;
  return seed / 4294967296;
};
const between = (a: number, b: number) => a + (b - a) * rand();
const f = (n: number) => Number(n.toFixed(1));

const lectureName = (group: string) => group.replace(/^[^·]*·\s*/, '');
const visibleCourses = courses.filter(
  (c) => !hiddenCourseKeys.has(c.key) && published.some((n) => c.lectures.some((l) => l.group === n.data.group)),
);
const byRealm = (realm: CourseDef['realm']) => visibleCourses.filter((c) => c.realm === realm);

// ---- sky: constellations ----
interface Star {
  x: number;
  y: number;
  r: number;
  note: NoteEntry;
}
interface Lecture {
  course: CourseDef;
  group: string;
  code: string;
  name: string;
  stars: Star[];
  edges: [number, number][];
  labelX: number;
  labelY: number;
  /** Where prerequisite threads start: the brightest star. */
  hub: Star;
  notes: NoteEntry[];
}
const fallbackConstellation = (i: number, n: number): Constellation => {
  const cx = 140 + (i % 6) * 160;
  const cy = 120 + Math.floor(i / 6) * 160;
  const stars: [number, number, number][] = [];
  const edges: [number, number][] = [];
  for (let k = 0; k < Math.max(n, 3); k++) {
    const a = (k / Math.max(n, 3)) * Math.PI * 2;
    stars.push([f(Math.cos(a) * 38 + between(-8, 8)), f(Math.sin(a) * 30 + between(-8, 8)), f(between(2.8, 4.4))]);
    if (k > 0) edges.push([k - 1, k]);
  }
  return { anchor: [cx, cy], stars, edges };
};

const skyLectures: Lecture[] = [];
let fallbackIndex = 0;
for (const course of byRealm('sky')) {
  for (const lecture of course.lectures) {
    const lectureNotes = published.filter((n) => n.data.group === lecture.group);
    if (lectureNotes.length === 0) continue;
    const def = lecture.constellation ?? fallbackConstellation(fallbackIndex++, lectureNotes.length);
    const [ax, ay] = def.anchor;
    const stars: Star[] = lectureNotes.map((note, i) => {
      const base = def.stars[Math.min(i, def.stars.length - 1)];
      // Notes beyond the drawn stars orbit the last one so a new note never breaks the shape.
      const extra = i - (def.stars.length - 1);
      const dx = extra > 0 ? Math.cos(extra * 2.1) * 22 * extra : 0;
      const dy = extra > 0 ? Math.sin(extra * 2.1) * 18 * extra : 0;
      return { x: f(ax + base[0] + dx), y: f(ay + base[1] + dy), r: extra > 0 ? 2.8 : base[2], note };
    });
    const edges = def.edges.filter(([a, b]) => a < stars.length && b < stars.length);
    for (let i = def.stars.length; i < stars.length; i++) edges.push([i - 1, i]);
    const hub = stars.reduce((best, s) => (s.r > best.r ? s : best), stars[0]);
    skyLectures.push({
      course,
      group: lecture.group,
      code: groupCode(lecture.group),
      name: lectureName(lecture.group),
      stars,
      edges,
      labelX: f(stars.reduce((s, p) => s + p.x, 0) / stars.length),
      labelY: f(Math.max(...stars.map((p) => p.y)) + 24),
      hub,
      notes: lectureNotes,
    });
  }
}

// ---- sea & land: one light per lecture ----
interface Light {
  course: CourseDef;
  group: string;
  code: string;
  name: string;
  x: number;
  y: number;
  slugs: string[];
  href: string;
}
const spread = (course: CourseDef, yBase: number, jitterY: number, stagger: number): Light[] => {
  const ready = course.lectures.filter((l) => published.some((n) => n.data.group === l.group));
  const n = ready.length;
  return ready.map((lecture, i) => {
    const x = n === 1 ? W / 2 : 100 + (i * (W - 200)) / (n - 1) + between(-12, 12);
    return {
      course,
      group: lecture.group,
      code: groupCode(lecture.group),
      name: lectureName(lecture.group),
      x: f(x),
      y: f(yBase + stagger * (i % 3) + between(-jitterY, jitterY)),
      slugs: published.filter((n) => n.data.group === lecture.group).map((n) => n.data.slug),
      href: withBase(`${courseRoute(course.key, lang)}#${lectureAnchor(lecture.group)}`),
    };
  });
};
const seaCourses = byRealm('sea');
const landCourses = byRealm('land');
const buoys = seaCourses.flatMap((c, ci) => spread(c, 495 + ci * 40, 4, 14));
const lanterns = landCourses.flatMap((c, ci) => spread(c, 700 - ci * 18, 3, 0));
const lightByGroup = new Map<string, Light>();
for (const l of [...buoys, ...lanterns]) lightByGroup.set(l.group, l);

// ---- threads: one per (note, prerequisite lecture), shown only while that star is hovered ----
interface Thread {
  slug: string;
  light: string;
  x1: number;
  y1: number;
  x2: number;
  y2: number;
  tone: string;
}
const threads: Thread[] = [];
for (const lecture of skyLectures) {
  for (const star of lecture.stars) {
    const targets = new Set<string>();
    for (const label of star.note.data.prereqs) {
      const ref = await resolveNoteRef(label, lang);
      if (ref && !ref.planned) targets.add(ref.group);
    }
    for (const group of targets) {
      const light = lightByGroup.get(group);
      if (!light) continue;
      threads.push({
        slug: star.note.data.slug,
        light: light.code,
        x1: star.x,
        y1: star.y,
        x2: light.x,
        y2: light.y - (light.course.realm === 'sea' ? 17 : 10),
        tone: light.course.tone,
      });
    }
  }
}

// ---- decoration ----
const dust = Array.from({ length: 220 }, () => ({
  x: f(between(0, W)),
  y: f(between(0, HORIZON - 10)),
  r: [0.5, 0.7, 0.9, 1.3][Math.floor(rand() * 4)],
  o: f(between(0.1, 0.45)),
}));
/**
 * A wave band: an irregular crest line (each crest its own length, height and lean, so it
 * never reads as a sine), closed down to the bottom so bands stack like water.
 */
interface Crest { x: number; y: number }
const crestLine = (y0: number, amp: number, minLen: number, maxLen: number): Crest[] => {
  const pts: Crest[] = [{ x: -20, y: y0 }];
  let x = -20;
  while (x < W + 20) {
    const len = between(minLen, maxLen);
    const lean = between(0.35, 0.6); // crest sits past the middle: steep front, long back
    const h = amp * between(0.5, 1.2);
    pts.push({ x: f(x + len * lean), y: f(y0 - h) });
    x += len;
    pts.push({ x: f(x), y: f(y0 + h * between(0.15, 0.4)) });
  }
  return pts;
};
const smoothPath = (pts: Crest[]) => {
  // Catmull-Rom → cubic Bézier, so the crest line is smooth but keeps its asymmetry.
  let d = `M${pts[0].x},${pts[0].y}`;
  for (let i = 0; i < pts.length - 1; i++) {
    const p0 = pts[Math.max(0, i - 1)];
    const p1 = pts[i];
    const p2 = pts[i + 1];
    const p3 = pts[Math.min(pts.length - 1, i + 2)];
    const c1x = f(p1.x + (p2.x - p0.x) / 6);
    const c1y = f(p1.y + (p2.y - p0.y) / 6);
    const c2x = f(p2.x - (p3.x - p1.x) / 6);
    const c2y = f(p2.y - (p3.y - p1.y) / 6);
    d += ` C${c1x},${c1y} ${c2x},${c2y} ${p2.x},${p2.y}`;
  }
  return d;
};
interface Band { path: string; crests: Crest[]; shade: number }
const bands: Band[] = [
  [456, 2.5, 90, 160],
  [480, 4, 80, 150],
  [508, 5.5, 70, 130],
  [540, 7, 60, 120],
  [574, 8.5, 55, 110],
  [608, 9, 50, 100],
].map(([y0, amp, a, b], i) => {
  const crests = crestLine(y0, amp, a, b);
  const line = smoothPath(crests);
  return { path: `${line} L${W + 20},${H} L-20,${H} Z`, crests: crests.filter((_, k) => k % 2 === 1), shade: i };
});
// Foam: short bright strokes just behind the higher crests, plus a few specks.
const foam = bands.flatMap((b) =>
  b.crests
    .filter(() => rand() < 0.55)
    .map((c) => ({
      x1: f(c.x - between(6, 20)),
      x2: f(c.x + between(3, 10)),
      y: f(c.y + between(0.5, 2.5)),
      o: f(between(0.35, 0.85)),
    })),
);
const specks = Array.from({ length: 70 }, () => ({
  x: f(between(0, W)),
  y: f(between(HORIZON + 6, 626)),
  r: f(between(0.4, 1.2)),
  o: f(between(0.1, 0.4)),
}));
// Shore: a shelf of sand where the water runs out, a broken foam edge, two ridges of land.
const shoreEdge = crestLine(632, 4, 70, 140);
const shorePath = `${smoothPath(shoreEdge)} L${W + 20},${H} L-20,${H} Z`;
const shoreFoam = shoreEdge
  .filter((_, k) => k % 2 === 0 && rand() < 0.8)
  .map((c) => ({ x: f(c.x + between(-20, 20)), w: f(between(14, 44)), y: f(c.y + between(-2, 3)), o: f(between(0.25, 0.55)) }));
const ridge = (base: number, amp: number, phase: number, step: number) => {
  const pts: Crest[] = [{ x: -20, y: base }];
  for (let x = 0; x <= W + 40; x += step) {
    pts.push({ x, y: f(base + amp * Math.sin(x / 190 + phase) + amp * 0.5 * Math.sin(x / 61 + phase * 2) + between(-3, 3)) });
  }
  return `${smoothPath(pts)} L${W + 20},${H} L-20,${H} Z`;
};
const ridgeBack = ridge(648, 9, 1.3, 48);
const ridgeFront = ridge(666, 6, 2.9, 40);
const grass = Array.from({ length: 110 }, () => ({
  x: f(between(0, W)),
  y: f(between(664, 736)),
  dx: f(between(-2, 2)),
  h: f(between(3, 8)),
  o: f(between(0.15, 0.45)),
}));
// A few low shrubs on the back ridge so the land has some silhouette.
const shrubs = Array.from({ length: 7 }, () => ({
  x: f(between(30, W - 120)),
  y: f(between(646, 652)),
  rx: f(between(7, 14)),
  ry: f(between(3, 5)),
}));
const LX = 1040;
---

<div class="sky-map" id="sky-map" data-lang={lang}>
  <div class="sky-scroll">
  <svg
    class:list={['sky-svg', { 'sky-svg--painted': painted }]}
    viewBox={`0 0 ${W} ${H}`}
    role="img"
    aria-label={zh ? '筆記星圖：腳下是數學構築的陸地，眼前是機器學習的海洋，抬頭是課程組成的星空' : 'Notes sky map: mathematics underfoot, machine learning at sea, the courses overhead as constellations'}
  >
    <defs>
      <radialGradient id="fire-glow-grad"><stop offset="0" stop-color="#f3c95a" stop-opacity=".55" /><stop offset=".55" stop-color="#e8862b" stop-opacity=".18" /><stop offset="1" stop-color="#e8862b" stop-opacity="0" /></radialGradient>
      <linearGradient id="sky-grad" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="var(--sky-top)" />
        <stop offset="1" stop-color="var(--sky-bottom)" />
      </linearGradient>
      <linearGradient id="sea-grad" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="var(--sea-top)" />
        <stop offset="1" stop-color="var(--sea-bottom)" />
      </linearGradient>
      <linearGradient id="land-grad" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="var(--shore-back)" />
        <stop offset="1" stop-color="var(--shore-front)" />
      </linearGradient>
      <filter id="sky-glow" x="-60%" y="-60%" width="220%" height="220%">
        <feGaussianBlur stdDeviation="3" result="blur" />
        <feComponentTransfer in="blur" result="halo"><feFuncA type="linear" slope="1.4" /></feComponentTransfer>
        <feMerge><feMergeNode in="halo" /><feMergeNode in="SourceGraphic" /></feMerge>
      </filter>
    </defs>

    {
      painted && (
        <g class="sky-art" aria-hidden="true">
          <image class="sky-art-night" href={artNight} x="0" y="0" width={W} height={H} preserveAspectRatio="xMidYMid slice" />
          <image class="sky-art-day" href={artDay} x="0" y="0" width={W} height={H} preserveAspectRatio="xMidYMid slice" />
        </g>
      )
    }
    <g class="sky-scene" aria-hidden="true">
    <!-- sky -->
    <rect width={W} height={HORIZON} fill="url(#sky-grad)" />
    <g class="sky-dust" aria-hidden="true">
      {dust.map((d) => <circle cx={d.x} cy={d.y} r={d.r} opacity={d.o} />)}
    </g>

    <!-- sea -->
    <rect y={HORIZON} width={W} height={H - HORIZON} fill="url(#sea-grad)" />
    <rect class="sky-reflection" x={-100} y={HORIZON} width="28" height={H - HORIZON} data-reflection />
    <g class="sea-bands" aria-hidden="true">
      {bands.map((b) => <path class={`sea-band sea-band-${b.shade}`} d={b.path} />)}
    </g>
    <g class="sea-foam" aria-hidden="true">
      {foam.map((s) => <line x1={s.x1} y1={s.y} x2={s.x2} y2={s.y} opacity={s.o} />)}
      {specks.map((s) => <circle cx={s.x} cy={s.y} r={s.r} opacity={s.o} />)}
    </g>

    <!-- shore -->
    <path class="shore-sand" d={shorePath} />
    <g class="shore-foam" aria-hidden="true">
      {shoreFoam.map((s) => <line x1={s.x} y1={s.y} x2={f(s.x + s.w)} y2={s.y} opacity={s.o} />)}
    </g>
    <path class="shore-back" d={ridgeBack} />
    <g class="shore-shrubs" aria-hidden="true">
      {shrubs.map((b) => <ellipse cx={b.x} cy={b.y} rx={b.rx} ry={b.ry} />)}
    </g>
    <path d={ridgeFront} fill="url(#land-grad)" />
    <g class="shore-grass" aria-hidden="true">
      {grass.map((g) => <line x1={g.x} y1={g.y} x2={f(g.x + g.dx)} y2={f(g.y - g.h)} opacity={g.o} />)}
    </g>
    <g class="shore-lighthouse" aria-hidden="true">
      <polygon points={`${LX - 5},662 ${LX + 5},662 ${LX + 4},622 ${LX - 4},622`} />
      <rect x={LX - 6} y="616" width="12" height="7" />
      <circle class="lighthouse-lamp-glow" cx={LX} cy="613" r="9" />
      <circle class="lighthouse-lamp" cx={LX} cy="613" r="3" />
    </g>
    </g>

    <!-- threads (prerequisites), one per note; lit only while that star or that light is hovered -->
    <g class="sky-threads" aria-hidden="true">
      {threads.map((t) => <line class="sky-thread" data-slug={t.slug} data-light={t.light} data-tone={t.tone} x1={t.x1} y1={t.y1} x2={t.x2} y2={t.y2} />)}
    </g>

    <!-- constellations -->
    {
      skyLectures.map((lecture) => (
        <g class="sky-lecture" data-lecture={lecture.code} data-tone={lecture.course.tone} data-read-count>
          <g class="sky-fx" aria-hidden="true" data-fx data-cx={lecture.hub.x} data-cy={lecture.hub.y}></g>
          <g class="sky-edges">
            {lecture.edges.map(([a, b]) => (
              <line x1={lecture.stars[a].x} y1={lecture.stars[a].y} x2={lecture.stars[b].x} y2={lecture.stars[b].y} />
            ))}
          </g>
          {lecture.stars.map((s) => (
            <a class="sky-star" href={withBase(noteHref(s.note))} data-read-slug={s.note.data.slug}>
              <title>{titles.of(s.note)}</title>
              <circle class="sky-star-hit" cx={s.x} cy={s.y} r="14" />
              <circle class="sky-star-glow" cx={s.x} cy={s.y} r={f(s.r * 2.4)} />
              <circle class="sky-star-core" cx={s.x} cy={s.y} r={s.r} />
            </a>
          ))}
          <a class="sky-lecture-label" href={withBase(`${courseRoute(lecture.course.key, lang)}#${lectureAnchor(lecture.group)}`)}>
            <text class="sky-label-code" x={lecture.labelX} y={lecture.labelY} text-anchor="middle">{lecture.code}</text>
            <text class="sky-label-name" x={lecture.labelX} y={lecture.labelY + 15} text-anchor="middle">{lecture.name}</text>
          </a>
        </g>
      ))
    }

    <!-- buoys (sea courses) -->
    {
      buoys.map((b, i) => (
        <a class="sky-light sky-buoy" href={b.href} data-tone={b.course.tone} data-read-slugs={b.slugs.join(',')} data-lecture={b.code} style={`--bob-delay:${(i % 5) * 0.65}s`}>
          <title>{b.group}</title>
          <line class="buoy-reflection" x1={b.x} y1={b.y + 4} x2={b.x} y2={b.y + 42} />
          <circle class="buoy-ripple" cx={b.x} cy={b.y + 2} r="6" />
          <g class="buoy-bob">
            <ellipse class="buoy-shadow" cx={b.x} cy={b.y + 1} rx="9" ry="2.2" />
            <line class="light-mast" x1={b.x} y1={b.y} x2={b.x} y2={b.y - 14} />
            <circle class="light-glow" cx={b.x} cy={b.y - 17} r="9" />
            <circle class="light-lamp" cx={b.x} cy={b.y - 17} r="3.4" />
          </g>
          <text class="light-code" x={b.x} y={b.y + 16} text-anchor="middle">{b.code}</text>
        </a>
      ))
    }
    {
      seaCourses.map((c, i) => (
        <text class="realm-label realm-label--sea" x="24" y={HORIZON + 16 + i * 14} data-tone={c.tone}>
          {c.title[lang].toUpperCase()} · {zh ? '海' : 'SEA'}
        </text>
      ))
    }

    <!-- campfires (land courses): one per unit, lit once any note is read, taller when all are -->
    {
      lanterns.map((l, i) => (
        <a class="sky-light sky-fire" href={l.href} data-tone={l.course.tone} data-read-slugs={l.slugs.join(',')} data-lecture={l.code} style={`--flicker-delay:${(i % 4) * 0.3}s`}>
          <title>{l.group}</title>
          <ellipse class="fire-shadow" cx={l.x} cy={l.y + 2} rx="13" ry="3" />
          <circle class="fire-glow" cx={l.x} cy={l.y - 8} r="20" />
          <line class="fire-log" x1={l.x - 9} y1={l.y} x2={l.x + 9} y2={l.y - 6} />
          <line class="fire-log fire-log--front" x1={l.x - 9} y1={l.y - 6} x2={l.x + 9} y2={l.y} />
          <g class="fire-flames">
            <path class="fire-flame fire-flame--outer" d={`M${l.x - 8},${l.y - 4} q8,-9 3,-19 q7,11 5,19 z`} />
            <path class="fire-flame fire-flame--inner" d={`M${l.x - 3},${l.y - 4} q3,-6.5 1.5,-11 q2.5,7.5 1.5,11 z`} />
          </g>
          <circle class="light-lamp fire-ember" cx={l.x} cy={l.y - 3} r="1.8" />
          <text class="light-code" x={l.x} y={l.y + 18} text-anchor="middle">{l.code}</text>
        </a>
      ))
    }
    {
      landCourses.map((c, i) => (
        <text class="realm-label realm-label--land" x="24" y={662 + i * 14} data-tone={c.tone}>
          {c.title[lang].toUpperCase()} · {zh ? '陸' : 'SHORE'}
        </text>
      ))
    }

    <!-- "you are here": a quiet ring around the last-read star, positioned client-side -->
    <g class="sky-here is-hidden" data-here>
      <circle class="sky-here-ring" r="13" />
    </g>
  </svg>
  </div>

  <div class="sky-legend">
    <span><span class="sky-legend-dot is-on"></span>{zh ? '已讀' : 'read'}</span>
    <span><span class="sky-legend-dot"></span>{zh ? '未讀' : 'unread'}</span>
    <span><span class="sky-legend-thread"></span>{zh ? '先備知識（將游標移到星星上查看）' : 'prerequisites (hover a star to see them)'}</span>
    <span class="sky-legend-note">{zh ? '紀錄只留在這台裝置' : 'kept on this device only'}</span>
  </div>
</div>

<script>
  import { markCelebrated, paintReadState, readCelebrated, readLast } from '../lib/reading';

  function initSky() {
    const root = document.getElementById('sky-map');
    if (!root) return;
    const seen = paintReadState(root);

    // Buoys / lanterns: lit when any note of that lecture has been read, full when all have.
    root.querySelectorAll<SVGElement>('.sky-light').forEach((el) => {
      const slugs = (el.dataset.readSlugs ?? '').split(',').filter(Boolean);
      const n = slugs.filter((s) => seen.has(s)).length;
      el.classList.toggle('is-lit', n > 0);
      el.classList.toggle('is-complete', slugs.length > 0 && n === slugs.length);
    });

    // A constellation whose every star is lit gets a glow (persistent) and, the first time
    // this device sees it complete, a short celebration: edges draw in, a ripple, a few sparks.
    const celebrated = readCelebrated();
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const svgNS = 'http://www.w3.org/2000/svg';
    root.querySelectorAll<SVGGElement>('.sky-lecture.is-complete').forEach((g, i) => {
      const code = g.dataset.lecture ?? '';
      if (!code || celebrated.has(code)) return;
      markCelebrated(code);
      if (reduceMotion) return;
      const fx = g.querySelector<SVGGElement>('[data-fx]');
      const cx = Number(fx?.dataset.cx ?? 0);
      const cy = Number(fx?.dataset.cy ?? 0);
      const stars = Array.from(g.querySelectorAll<SVGCircleElement>('.sky-star-core'));
      const bx = stars.reduce((a, c) => a + Number(c.getAttribute('cx')), 0) / (stars.length || 1);
      const by = stars.reduce((a, c) => a + Number(c.getAttribute('cy')), 0) / (stars.length || 1);
      const delay = 400 + i * 1200; // several units completing at once play one after another
      window.setTimeout(() => {
        g.classList.add('is-celebrating');
        if (fx) {
          // two ripples from the centre of the constellation
          for (let k = 0; k < 2; k++) {
            const ring = document.createElementNS(svgNS, 'circle');
            ring.setAttribute('class', 'sky-fx-ring');
            ring.setAttribute('cx', String(bx));
            ring.setAttribute('cy', String(by));
            ring.setAttribute('r', '6');
            ring.style.animationDelay = `${k * 420}ms`;
            fx.appendChild(ring);
          }
          // sparks that fly out from each star
          stars.forEach((c) => {
            for (let k = 0; k < 3; k++) {
              const spark = document.createElementNS(svgNS, 'circle');
              spark.setAttribute('class', 'sky-fx-spark');
              spark.setAttribute('cx', c.getAttribute('cx') ?? '0');
              spark.setAttribute('cy', c.getAttribute('cy') ?? '0');
              spark.setAttribute('r', String(0.9 + Math.random() * 1.1));
              const a = Math.random() * Math.PI * 2;
              const d = 14 + Math.random() * 18;
              spark.style.setProperty('--dx', `${Math.cos(a) * d}px`);
              spark.style.setProperty('--dy', `${Math.sin(a) * d}px`);
              spark.style.animationDelay = `${300 + Math.random() * 600}ms`;
              fx.appendChild(spark);
            }
          });
          void cx; void cy;
        }
        window.setTimeout(() => {
          g.classList.remove('is-celebrating');
          if (fx) fx.replaceChildren();
        }, 4200);
      }, delay);
    });

    // Threads: none by default. Hovering (or focusing) a star lights that note's own
    // prerequisites; hovering a buoy / lantern lights every thread that lands on it.
    const threads = Array.from(root.querySelectorAll<SVGElement>('.sky-thread'));
    const clear = () => threads.forEach((t) => t.classList.remove('is-on'));
    root.querySelectorAll<SVGElement>('.sky-star').forEach((star) => {
      const slug = star.dataset.readSlug;
      const on = () => threads.forEach((t) => t.classList.toggle('is-on', t.dataset.slug === slug));
      star.addEventListener('mouseenter', on);
      star.addEventListener('focusin', on);
      star.addEventListener('mouseleave', clear);
      star.addEventListener('focusout', clear);
    });
    root.querySelectorAll<SVGElement>('.sky-light').forEach((el) => {
      const code = el.dataset.lecture;
      const on = () => threads.forEach((t) => t.classList.toggle('is-on', t.dataset.light === code));
      el.addEventListener('mouseenter', on);
      el.addEventListener('focusin', on);
      el.addEventListener('mouseleave', clear);
      el.addEventListener('focusout', clear);
    });

    // "You are here": the star of the note this browser read last.
    const last = readLast();
    const hereStar = last ? root.querySelector<SVGElement>(`.sky-star[data-read-slug="${last.slug}"]`) : null;
    if (hereStar) {
      const core = hereStar.querySelector<SVGCircleElement>('.sky-star-core');
      const here = root.querySelector<SVGGElement>('[data-here]');
      if (core && here) {
        const x = Number(core.getAttribute('cx'));
        const y = Number(core.getAttribute('cy'));
        here.classList.remove('is-hidden');
        here.querySelector('.sky-here-ring')?.setAttribute('cx', String(x));
        here.querySelector('.sky-here-ring')?.setAttribute('cy', String(y));
        const refl = root.querySelector<SVGRectElement>('[data-reflection]');
        if (refl) refl.setAttribute('x', String(x - 14));
      }
    }
  }
  initSky();
</script>
