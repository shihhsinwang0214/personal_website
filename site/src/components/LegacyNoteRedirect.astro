---
import { withBase } from '../lib/url';
import type { Lang } from '../lib/notes';

interface Props {
  lang: Lang;
  target: string;
}

const { lang, target } = Astro.props;
const href = withBase(target);
const label = lang === 'zh' ? '前往新的筆記頁面' : 'Go to the updated note';
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta http-equiv="refresh" content={`0; url=${href}`} />
    <link rel="canonical" href={href} />
    <title>{lang === 'zh' ? 'Redirecting...' : 'Redirecting...'}</title>
    <script is:inline define:vars={{ href }}>
      window.location.replace(href);
    </script>
  </head>
  <body>
    <p><a href={href}>{label}</a></p>
  </body>
</html>
