---
/**
 * MapHead.astro — the heading above each course map on the notes landing page (the sky for
 * DMA, the molecule map for Geometric Deep Learning). It is what names a map: without it the
 * sky reads as "the notes" rather than as one course, which is the whole point of having it.
 */
interface Props {
  id?: string;
  title: string;
  /** One paragraph, or several. */
  lead?: string | string[];
  /** One quiet line under the lead, e.g. what else lives inside the picture. */
  note?: string;
  href?: string;
  linkLabel?: string;
  tone?: string;
}
const { id, title, lead, note, href, linkLabel, tone } = Astro.props;
const paragraphs = lead === undefined ? [] : Array.isArray(lead) ? lead : [lead];
---

<div class="map-head" data-tone={tone}>
  <div class="map-head-copy">
    <h3 id={id}><span class="tone-dot" aria-hidden="true"></span>{title}</h3>
    {paragraphs.map((p) => <p class="map-head-lead">{p}</p>)}
    {note && <p class="map-head-note">{note}</p>}
  </div>
  {href && linkLabel && <a class="map-head-link" href={href}>{linkLabel}</a>}
</div>

<style>
  .map-head {
    display: flex; align-items: flex-end; justify-content: space-between; gap: 16px;
    flex-wrap: wrap; margin: 0 0 12px;
  }
  .map-head h3 {
    display: flex; align-items: center; gap: 9px;
    margin: 0 0 4px; font-size: 1.12rem; letter-spacing: -0.01em;
  }
  .map-head-lead + .map-head-lead { margin-top: 6px; }
  .map-head-lead { margin: 0; max-width: 74ch; font-size: 0.92rem; line-height: 1.7; color: var(--text-muted); }
  .map-head-note {
    margin: 4px 0 0; font-family: var(--font-mono); font-size: 0.74rem;
    letter-spacing: 0.02em; color: var(--text-muted); opacity: 0.85;
  }
  .map-head-link {
    flex: 0 0 auto; font-size: 0.85rem; font-weight: 700; color: var(--tone, var(--accent));
    text-decoration: none; border-bottom: 1px dotted currentColor;
  }
  .map-head-link:hover { border-bottom-style: solid; }
</style>
