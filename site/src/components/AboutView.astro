---
import { withBase } from '../lib/url';
import { profile, aboutHtml, aboutHtmlZh, philosophy, uiText } from '../data/content';
import type { Lang } from '../lib/notes';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const bio = lang === 'zh' ? aboutHtmlZh : aboutHtml;
const subtitle = lang === 'zh' ? profile.subtitleZh : profile.subtitle;
---

<main class="about content">
  <section>
    <h1>{uiText.aboutTitle[lang]}</h1>

    <div class="about-top">
      <img class="about-photo" src={withBase(profile.photo)} alt={profile.name} />
      <div class="about-side">
        <div>
          <div class="about-name">{profile.name} <span class="zh">{profile.nameZh}</span></div>
          <p class="about-role">{subtitle.slice(0, 2).join(' · ')}</p>
          {subtitle.slice(2).map((line) => <p class="about-role about-role-sub">{line}</p>)}
        </div>
        <ul class="about-contacts">
          <li>
            <a href={`mailto:${profile.contact.email}`}>
              <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <rect x="3" y="5" width="18" height="14" rx="2" />
                <path d="M3 7l9 6 9-6" />
              </svg>
              {profile.contact.email}
            </a>
          </li>
          <li>
            <a href={profile.contact.scholar} target="_blank" rel="noopener">
              <svg width="17" height="17" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M12 3 1 9l4 2.18v3.68L12 18l7-3.14v-3.68l2-1.09V15h2V9L12 3zm0 2.28L18.92 9 12 12.72 5.08 9 12 5.28zM7 12.27l5 2.73 5-2.73v2.29l-5 2.24-5-2.24v-2.29z" />
              </svg>
              Google Scholar
            </a>
          </li>
          <li>
            <a href={profile.contact.github} target="_blank" rel="noopener">
              <svg width="17" height="17" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M12 2C6.48 2 2 6.58 2 12.26c0 4.5 2.87 8.32 6.84 9.67.5.09.68-.22.68-.48 0-.24-.01-.87-.01-1.7-2.78.62-3.37-1.37-3.37-1.37-.45-1.18-1.11-1.49-1.11-1.49-.91-.64.07-.62.07-.62 1 .07 1.53 1.06 1.53 1.06.89 1.56 2.34 1.11 2.91.85.09-.66.35-1.11.63-1.37-2.22-.26-4.56-1.14-4.56-5.07 0-1.12.39-2.03 1.03-2.75-.1-.26-.45-1.3.1-2.71 0 0 .84-.27 2.75 1.05A9.3 9.3 0 0112 6.84c.85 0 1.71.12 2.51.34 1.91-1.32 2.75-1.05 2.75-1.05.55 1.41.2 2.45.1 2.71.64.72 1.03 1.63 1.03 2.75 0 3.94-2.34 4.81-4.57 5.06.36.32.68.94.68 1.9 0 1.37-.01 2.47-.01 2.81 0 .27.18.58.69.48A10.02 10.02 0 0022 12.26C22 6.58 17.52 2 12 2z" />
              </svg>
              GitHub
            </a>
          </li>
          <li>
            <a href={profile.contact.linkedin} target="_blank" rel="noopener">
              <svg width="17" height="17" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M4.98 3.5A2.5 2.5 0 002.5 6 2.5 2.5 0 005 8.5 2.5 2.5 0 007.5 6 2.5 2.5 0 004.98 3.5zM3 9h4v12H3zM10 9h3.8v1.7h.05c.53-.95 1.83-1.95 3.77-1.95 4.03 0 4.78 2.5 4.78 5.75V21h-4v-5.3c0-1.27-.02-2.9-1.9-2.9-1.9 0-2.2 1.4-2.2 2.8V21h-4z" />
              </svg>
              LinkedIn
            </a>
          </li>
        </ul>
      </div>
    </div>

    <div class="bio-text about-bio" set:html={bio} />

    <h3>{uiText.approach[lang]}</h3>
    <div class="philosophy-split">
      <div class="philosophy-col">
        <div class="philosophy-title">{lang === 'zh' ? philosophy[0].titleZh : philosophy[0].title}</div>
        <div class="philosophy-desc">{lang === 'zh' ? philosophy[0].descZh : philosophy[0].desc}</div>
      </div>
      <div class="philosophy-arrow">↔</div>
      <div class="philosophy-col">
        <div class="philosophy-title">{lang === 'zh' ? philosophy[1].titleZh : philosophy[1].title}</div>
        <div class="philosophy-desc">{lang === 'zh' ? philosophy[1].descZh : philosophy[1].desc}</div>
      </div>
    </div>
  </section>
</main>
