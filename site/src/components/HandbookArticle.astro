---
import { render } from 'astro:content';
import Base from '../layouts/Base.astro';
import HandbookSidebar from './HandbookSidebar.astro';
import SelfCheck from './SelfCheck.astro';
import { withBase } from '../lib/url';
import type { HandbookEntry, Lang } from '../lib/handbook';
import {
  findHandbook,
  formatHandbookDate,
  handbookNav,
  handbookTitleFormal,
  handbookRoute,
  handbookSiblings,
  sectionByKey,
  statusLabels,
} from '../lib/handbook';
import { bestiaryRoute, visibleMonsters } from '../lib/bestiary';

interface Props {
  entry: HandbookEntry;
  allEntries: HandbookEntry[];
  lang: Lang;
}
const { entry, allEntries, lang } = Astro.props;
const { Content, headings } = await render(entry);
const otherLang: Lang = lang === 'zh' ? 'en' : 'zh';
const alt = findHandbook(allEntries, entry.data.slug, otherLang);
const nav = handbookNav(allEntries, lang);
const { previous, next } = handbookSiblings(allEntries, entry, lang);
const section = sectionByKey(entry.data.section);
// Position within this section's visible pages — shown as a node counter.
const sectionItems = nav.find((g) => g.section.key === entry.data.section)?.items ?? [];
const nodeIndex = sectionItems.findIndex((e) => e.data.slug === entry.data.slug) + 1;
const nodeTotal = sectionItems.length;
const tocHeadings = headings.filter((h) => h.depth > 1 && h.depth <= 3);
// Monsters whose counter-play lives on this page — shown as an encounter strip.
const pageMonsters = visibleMonsters().filter((m) => m.link === entry.data.slug);

const alternates = alt
  ? [
      { lang, path: handbookRoute(entry.data.slug, lang) },
      { lang: otherLang, path: handbookRoute(alt.data.slug, otherLang) },
    ]
  : undefined;
const articleJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: entry.data.title,
  description: entry.data.summary,
  inLanguage: lang === 'zh' ? 'zh-Hant' : 'en',
  dateModified: entry.data.updated.toISOString().slice(0, 10),
  author: { '@type': 'Person', name: 'Shih-Hsin Wang' },
  isPartOf: { '@type': 'CreativeWork', name: handbookTitleFormal[lang] },
};
---

<Base
  title={`${entry.data.title} — ${handbookTitleFormal[lang]}`}
  description={entry.data.summary}
  active="handbook"
  lang={lang}
  alternates={alternates}
  jsonLd={articleJsonLd}
  langToggleHref={alt ? withBase(handbookRoute(alt.data.slug, otherLang)) : undefined}
>
  <div class="reading-progress" aria-hidden="true"><span></span></div>
  <button class="back-to-top" type="button" aria-label={lang === 'zh' ? '回到頂部' : 'Back to top'}>
    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 19V5M5 12l7-7 7 7" /></svg>
  </button>

  <main class="handbook-shell" id="note-main">
    <HandbookSidebar lang={lang} current={entry.data.slug} />

    <article class="handbook-article" data-slug={entry.data.slug}>
      <header class="note-header">
        <p class="note-meta">
          {section.icon} {section.label[lang]}
          <span class="section-tag">{section.tag}</span>
          {nodeTotal > 0 && nodeIndex > 0 && (
            <span class="node-counter">NODE {nodeIndex}/{nodeTotal}</span>
          )}
          <span class="note-meta-date">{formatHandbookDate(entry.data.updated, lang)}</span>
        </p>
        <h1>{entry.data.title}</h1>
        <div class="note-header-actions">
          <span class={`status-badge status-${entry.data.status}`}>{statusLabels[entry.data.status][lang]}</span>
          {alt && (
            <a href={withBase(handbookRoute(alt.data.slug, otherLang))}>{otherLang === 'zh' ? '中文' : 'EN'}</a>
          )}
        </div>
      </header>

      <div class="note-grid">
        <aside class="note-toc" aria-label={lang === 'zh' ? '目錄' : 'Table of contents'}>
          <strong>{lang === 'zh' ? '本頁目錄' : 'On this page'}</strong>
          {tocHeadings.length > 0 ? (
            <ol>
              {tocHeadings.map((h) => (
                <li class={`toc-depth-${h.depth}`}><a href={`#${h.slug}`}>{h.text}</a></li>
              ))}
            </ol>
          ) : (
            <p>{lang === 'zh' ? '此頁沒有章節目錄。' : 'No section headings.'}</p>
          )}
        </aside>
        <div class="note-body markdown-body">
          <Content />
        </div>
      </div>

      {entry.data.slug === 'join' && <SelfCheck lang={lang} />}

      {pageMonsters.length > 0 && (
        <aside class="encounter hud">
          <div class="hud-tag">ENCOUNTER</div>
          <p class="encounter-lead">
            {lang === 'zh' ? '這一頁是這些怪物的打法：' : 'This page is the counter-play for:'}
          </p>
          <ul class="encounter-list">
            {pageMonsters.map((m) => (
              <li>
                <a href={`${withBase(bestiaryRoute(lang))}#${m.id}`}>
                  <span class={`encounter-tier encounter-${m.tier}`}>{m.tier.toUpperCase()}</span>
                  <span class="encounter-name">{m.name[lang]}</span>
                  <span class="encounter-symptom">{m.symptom[lang]}</span>
                </a>
              </li>
            ))}
          </ul>
        </aside>
      )}

      <nav class="note-prev-next" aria-label="Previous and next">
        {previous ? (
          <a class="nav-prev" href={withBase(handbookRoute(previous.data.slug, lang))}>
            <span>◀ {lang === 'zh' ? '上一節點' : 'Prev node'}</span>
            {previous.data.title}
          </a>
        ) : (<span />)}
        {next ? (
          <a class="nav-next" href={withBase(handbookRoute(next.data.slug, lang))}>
            <span>{lang === 'zh' ? '下一節點' : 'Next node'} ▶</span>
            {next.data.title}
          </a>
        ) : (<span />)}
      </nav>
    </article>
  </main>

  <script>
    import { markVisited } from '../lib/visited';
    // Remember that this node has been walked, so the skill tree on the lab
    // home can light it up. Local to this browser; never sent anywhere.
    const slugEl = document.querySelector('.handbook-article[data-slug]');
    if (slugEl instanceof HTMLElement && slugEl.dataset.slug) markVisited(slugEl.dataset.slug);

    function initHandbook() {
      const progress = document.querySelector('.reading-progress > span');
      const backTop = document.querySelector('.back-to-top');
      const body = document.querySelector('.note-body');
      const tocLinks = Array.from(document.querySelectorAll('.note-toc a[href^="#"]'));
      const onScroll = () => {
        const doc = document.documentElement;
        const max = doc.scrollHeight - doc.clientHeight;
        const ratio = max > 0 ? Math.min(1, doc.scrollTop / max) : 0;
        if (progress) progress.style.width = ratio * 100 + '%';
        if (backTop) backTop.classList.toggle('is-visible', doc.scrollTop > 600);
      };
      if (window.__hbScroll) window.removeEventListener('scroll', window.__hbScroll);
      window.__hbScroll = onScroll;
      window.addEventListener('scroll', onScroll, { passive: true });
      onScroll();
      if (backTop) backTop.addEventListener('click', () => window.scrollTo({ top: 0, behavior: 'smooth' }));
      if (body) {
        body.querySelectorAll('h2[id], h3[id]').forEach((h) => {
          if (h.querySelector('.heading-anchor')) return;
          const a = document.createElement('a');
          a.className = 'heading-anchor'; a.href = '#' + h.id; a.textContent = '#';
          a.setAttribute('aria-label', 'Copy link to this section');
          a.addEventListener('click', (e) => {
            e.preventDefault();
            history.replaceState(null, '', '#' + h.id);
            if (navigator.clipboard) navigator.clipboard.writeText(location.origin + location.pathname + '#' + h.id).catch(() => {});
          });
          h.appendChild(a);
        });
      }
      const map = new Map();
      tocLinks.forEach((l) => { const href = l.getAttribute('href'); if (href) map.set(decodeURIComponent(href.slice(1)), l); });
      const targets = body ? Array.from(body.querySelectorAll('h2[id], h3[id]')) : [];
      if (window.__hbSpy && window.__hbSpy.disconnect) window.__hbSpy.disconnect();
      if (targets.length && map.size) {
        const obs = new IntersectionObserver((entries) => {
          entries.forEach((en) => {
            if (!en.isIntersecting) return;
            const link = map.get(en.target.id);
            if (!link) return;
            tocLinks.forEach((l) => l.classList.remove('is-active'));
            link.classList.add('is-active');
          });
        }, { rootMargin: '-88px 0px -70% 0px', threshold: 0 });
        targets.forEach((t) => obs.observe(t));
        window.__hbSpy = obs;
      }
    }
    initHandbook();
  </script>
</Base>
