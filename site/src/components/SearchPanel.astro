---
import { withBase } from '../lib/url';

interface Props {
  lang?: 'en' | 'zh';
  id?: string;
  compact?: boolean;
}
const { lang = 'en', id = 'notes-search', compact = false } = Astro.props;
const isZh = lang === 'zh';
---

<section
  class:list={['search-panel', { 'search-panel--compact': compact }]}
  aria-labelledby={`${id}-title`}
  data-search-panel
  data-search-lang={lang}
  data-pagefind-src={import.meta.env.DEV ? undefined : withBase('pagefind/pagefind.js')}
  data-fallback-src={withBase('search-index.json')}
  data-base-path={import.meta.env.BASE_URL}
  data-pagefind-ignore
>
  <div class:list={['search-panel-head', { 'visually-hidden': compact }]}>
    <h2 id={`${id}-title`}>{isZh ? '搜尋筆記' : 'Search notes'}</h2>
    <p id={`${id}-help`}>{isZh ? '輸入主題、關鍵字或單元編號，例如 Flow Matching、U4。' : 'Search by topic, keyword or unit code, such as Flow Matching or U4.'}</p>
  </div>
  <form class="search-form" role="search" aria-label={isZh ? '搜尋筆記' : 'Search notes'}>
    <label class="visually-hidden" for={`${id}-input`}>{isZh ? '搜尋關鍵字' : 'Search keywords'}</label>
    <input
      id={`${id}-input`}
      type="search"
      name="q"
      autocomplete="off"
      placeholder={compact ? (isZh ? '搜尋主題或單元，例如 Flow Matching、U4' : 'Search topics or units, e.g. Flow Matching, U4') : (isZh ? '想學些什麼？' : 'What would you like to learn?')}
      aria-describedby={`${id}-help ${id}-status`}
      aria-controls={`${id}-results`}
    />
    <button class="search-submit" type="submit">{isZh ? '搜尋' : 'Search'}</button>
  </form>
  <p class="search-status" id={`${id}-status`} role="status" aria-live="polite" aria-atomic="true"></p>
  <ol class="search-results" id={`${id}-results`}></ol>
</section>

<script>
  interface SearchItem {
    url: string;
    title: string;
    excerpt?: string;
    excerptHtml?: string;
    text?: string;
  }
  let fallbackPromise: Promise<SearchItem[]> | undefined;
  let pagefindPromise: Promise<any> | undefined;

  document.querySelectorAll<HTMLElement>('[data-search-panel]').forEach((panel) => {
    const input = panel.querySelector<HTMLInputElement>('input');
    const form = panel.querySelector('form');
    const results = panel.querySelector<HTMLOListElement>('.search-results');
    const status = panel.querySelector<HTMLElement>('.search-status');
    if (!input || !form || !results || !status) return;
    const isZh = panel.dataset.searchLang === 'zh';
    const basePath = panel.dataset.basePath || '/';
    let requestId = 0;
    let timer: ReturnType<typeof setTimeout>;

    function routeWithBase(url: string) {
      if (/^https?:\/\//.test(url) || url.startsWith(basePath)) return url;
      return basePath.replace(/\/$/, '') + '/' + url.replace(/^\//, '');
    }
    async function fallback(query: string) {
      fallbackPromise ??= fetch(panel.dataset.fallbackSrc!).then((response) => {
        if (!response.ok) throw new Error('Search unavailable');
        return response.json();
      }).catch((error) => { fallbackPromise = undefined; throw error; });
      const entries = await fallbackPromise;
      const terms = query.toLocaleLowerCase().split(/\s+/).filter(Boolean);
      return entries.map((item) => {
        const title = item.title.toLocaleLowerCase();
        const text = (item.text || '').toLocaleLowerCase();
        if (!terms.every((term) => text.includes(term))) return null;
        return { ...item, score: terms.reduce((score, term) => score + (title.includes(term) ? 4 : 1), 0) };
      }).filter((item) => item !== null).sort((a, b) => b.score - a.score).slice(0, 8);
    }
    async function search(query: string): Promise<SearchItem[]> {
      if (panel.dataset.pagefindSrc) {
        try {
          const src = panel.dataset.pagefindSrc;
          pagefindPromise ??= import(/* @vite-ignore */ src).catch((error) => { pagefindPromise = undefined; throw error; });
          const pagefind = await pagefindPromise;
          const response = await pagefind.search(query);
          const data = await Promise.all(response.results.slice(0, 8).map((result: any) => result.data()));
          if (data.length) return data.map((item: any) => ({ url: item.url, title: item.meta?.title || item.url, excerptHtml: item.excerpt || '' }));
        } catch { /* The metadata index also works before a full Pagefind build. */ }
      }
      return fallback(query);
    }
    async function run(query: string, current: number) {
      status!.textContent = isZh ? '搜尋中…' : 'Searching…';
      results!.setAttribute('aria-busy', 'true');
      try {
        const items = await search(query);
        if (current !== requestId) return;
        results!.replaceChildren();
        status!.textContent = items.length
          ? isZh ? `顯示 ${items.length} 筆結果${items.length === 8 ? '，可加入關鍵字縮小範圍' : ''}。` : `Showing ${items.length} result${items.length === 1 ? '' : 's'}${items.length === 8 ? '. Add keywords to narrow your search' : ''}.`
          : isZh ? '找不到相關筆記，試試其他關鍵字或單元編號。' : 'No matching notes. Try another keyword or unit code.';
        for (const item of items) {
          const li = document.createElement('li');
          const link = document.createElement('a');
          const title = document.createElement('strong');
          const excerpt = document.createElement('p');
          link.href = routeWithBase(item.url);
          title.textContent = item.title;
          if (item.excerptHtml) excerpt.innerHTML = item.excerptHtml;
          else excerpt.textContent = item.excerpt || '';
          link.append(title, excerpt);
          li.append(link);
          results!.append(li);
        }
      } catch {
        if (current !== requestId) return;
        results!.replaceChildren();
        status!.textContent = isZh ? '暫時無法搜尋，請稍後再試。' : 'Search is temporarily unavailable. Please try again.';
      } finally {
        if (current === requestId) results!.removeAttribute('aria-busy');
      }
    }
    function schedule(immediate = false) {
      clearTimeout(timer);
      // Invalidate in-flight results immediately, including when the input is cleared.
      const current = ++requestId;
      const query = input!.value.trim();
      results!.replaceChildren();
      results!.removeAttribute('aria-busy');
      status!.textContent = '';
      if (!query) return;
      if (immediate) void run(query, current);
      else timer = setTimeout(() => void run(query, current), 180);
    }
    input.addEventListener('input', () => schedule());
    form.addEventListener('submit', (event) => {
      event.preventDefault();
      schedule(true);
    });
    if (!panel.closest('dialog')) {
      const query = new URLSearchParams(location.search).get('q');
      if (query) { input.value = query; schedule(true); }
    }
  });
</script>
