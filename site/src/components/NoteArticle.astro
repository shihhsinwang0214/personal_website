---
import { render } from 'astro:content';
import Base from '../layouts/Base.astro';
import type { Lang, NoteEntry } from '../lib/notes';
import {
  categoryLabels,
  findNote,
  formatNoteDate,
  noteRoute,
  notesIndexRoute,
  researchAreaLabelForNote,
  siblingNotes,
  statusLabels,
} from '../lib/notes';
import { inlineMath } from '../lib/inlineMath';
import { noteTitles } from '../lib/noteRefs';
import { withBase } from '../lib/url';
import Comments from './Comments.astro';

interface Props {
  entry: NoteEntry;
  allNotes: NoteEntry[];
  lang: Lang;
}

const { entry, allNotes, lang } = Astro.props;
const { Content, headings } = await render(entry);
const { previous, next } = siblingNotes(allNotes, entry);
// Position codes ("W3.3") are derived from the note's group + order, never typed into
// frontmatter, so a week can be renumbered without touching any note.
const titles = await noteTitles();
const displayTitle = titles.of(entry);
const otherLang = lang === 'zh' ? 'en' : 'zh';
const alternateEntry = findNote(allNotes, entry.data.slug, otherLang);
// Missing translations no longer get standalone pages — only link real ones.
const alternate =
  alternateEntry && alternateEntry.data.status !== 'missing' ? alternateEntry : undefined;
const alternates = alternate
  ? [
      { lang, path: noteRoute(entry.data.slug, lang) },
      { lang: otherLang, path: noteRoute(alternate.data.slug, otherLang) },
    ]
  : undefined;
const researchAreaLabel = researchAreaLabelForNote(entry, lang);
// 目錄的文字不能用 Astro 給的 `heading.text`：它取的是**渲染完 KaTeX 之後**節點的
// textContent，所以 `## 真的要跑 $t$ 次嗎？` 會變成「真的要跑 ttt 次嗎？」——MathML、
// annotation、HTML 三層的文字被串在一起。改成從原始 mdx 讀那一行、用 inlineMath()
// 補上 KaTeX。`href` 仍然用 Astro 的 slug，所以錨點完全不受影響。
const headingLines = (() => {
  const out: { depth: number; raw: string }[] = [];
  let inFence = false;
  let inMath = false;
  for (const line of (entry.body ?? '').split('\n')) {
    const trimmed = line.trim();
    if (trimmed.startsWith('```') || trimmed.startsWith('~~~')) {
      inFence = !inFence;
      continue;
    }
    if (inFence) continue;
    if (trimmed === '$$') {
      inMath = !inMath;
      continue;
    }
    if (inMath) continue;
    const m = /^(#{1,6})\s+(.*\S)\s*$/.exec(line);
    if (m) out.push({ depth: m[1].length, raw: m[2] });
  }
  return out.filter((h) => h.depth > 1 && h.depth <= 3);
})();
const astroHeadings = headings.filter((heading) => heading.depth > 1 && heading.depth <= 3);
// 對不上就退回 Astro 的文字（寧可醜，不要錯位）。
const aligned = headingLines.length === astroHeadings.length;
const tocHeadings = astroHeadings.map((heading, i) => ({
  ...heading,
  html: inlineMath(aligned ? headingLines[i].raw : heading.text),
}));
const description =
  entry.data.status === 'missing'
    ? 'This translation is explicitly marked missing and has not been generated.'
    : entry.data.summary;

// Reading time, computed at build (zh by characters, en by words)
const rawBody = (entry.body ?? '').trim();
const cjkCount = (rawBody.match(/[㐀-鿿]/g) || []).length;
const wordCount = (rawBody.replace(/[㐀-鿿]/g, ' ').match(/[A-Za-z0-9]+/g) || []).length;
const readingMinutes = Math.max(1, Math.round(cjkCount / 330 + wordCount / 220));
const showReadingTime = entry.data.status !== 'missing';
const readingTimeLabel = lang === 'zh' ? `${readingMinutes} 分鐘閱讀` : `${readingMinutes} min read`;

const articleJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: displayTitle,
  description: entry.data.summary,
  inLanguage: lang === 'zh' ? 'zh-Hant' : 'en',
  dateModified: entry.data.updated.toISOString().slice(0, 10),
  author: { '@type': 'Person', name: 'Shih-Hsin Wang' },
  url: Astro.site ? new URL(withBase(noteRoute(entry.data.slug, lang)), Astro.site).href : undefined,
};
---

<Base
  title={`${displayTitle} — Notes`}
  description={description}
  active="notes"
  lang={lang}
  alternates={alternates}
  jsonLd={articleJsonLd}
  langToggleHref={alternate ? withBase(noteRoute(alternate.data.slug, otherLang)) : undefined}
>
  <div class="reading-progress" aria-hidden="true"><span></span></div>
  <button class="back-to-top" type="button" aria-label={lang === 'zh' ? '回到頂部' : 'Back to top'}>
    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M12 19V5M5 12l7-7 7 7" />
    </svg>
  </button>
  <main class="note-layout" id="note-main">
    <article class="note-article">
      <header class="note-header">
        <a class="back-link" href={withBase(notesIndexRoute(lang))}>
          {lang === 'zh' ? '← 返回筆記' : '← Back to notes'}
        </a>
        <p class="note-meta">
          {categoryLabels[entry.data.category][lang]}
          {researchAreaLabel ? ` / ${researchAreaLabel}` : ''}
          {' / '}
          {entry.data.group} / {formatNoteDate(entry.data.updated, lang)}
        </p>
        <h1>{displayTitle}</h1>
        <div class="note-header-actions">
          <span class={`status-badge status-${entry.data.status}`}>
            {statusLabels[entry.data.status][lang]}
          </span>
          {showReadingTime && <span class="reading-time">{readingTimeLabel}</span>}
        </div>
        {
          entry.data.status === 'missing' && (
            <div class="content-status-note">
              {lang === 'zh'
                ? '此版本標記為缺少翻譯。這是 content agent 的待辦事項；維護流程未自動產生翻譯。'
                : 'This version is marked as a missing translation. This is a content-agent task; no translation has been generated.'}
            </div>
          )
        }
      </header>

      <div class="note-grid">
        <aside class="note-toc" aria-label="Table of contents">
          <strong>{lang === 'zh' ? '目錄' : 'Contents'}</strong>
          {
            tocHeadings.length > 0 ? (
              <ol>
                {tocHeadings.map((heading) => (
                  <li class={`toc-depth-${heading.depth}`}>
                    <a href={`#${heading.slug}`} set:html={heading.html} />
                  </li>
                ))}
              </ol>
            ) : (
              <p>{lang === 'zh' ? '此頁沒有章節目錄。' : 'No section headings on this page.'}</p>
            )
          }
        </aside>

        <div class="note-body markdown-body">
          <Content />
        </div>
      </div>

      <nav class="note-prev-next" aria-label="Previous and next notes">
        {
          previous ? (
            <a href={withBase(noteRoute(previous.data.slug, lang))}>
              <span>{lang === 'zh' ? '上一篇' : 'Previous'}</span>
              {titles.of(previous)}
            </a>
          ) : (
            <span />
          )
        }
        {
          next ? (
            <a href={withBase(noteRoute(next.data.slug, lang))}>
              <span>{lang === 'zh' ? '下一篇' : 'Next'}</span>
              {titles.of(next)}
            </a>
          ) : (
            <span />
          )
        }
      </nav>

      {entry.data.status !== 'missing' && <Comments lang={lang} />}
    </article>
  </main>

  <script>
    function initNote() {
      const progress = document.querySelector('.reading-progress > span') as HTMLElement | null;
      const backTop = document.querySelector('.back-to-top') as HTMLElement | null;
      const body = document.querySelector('.note-body') as HTMLElement | null;
      const tocLinks = Array.from(document.querySelectorAll<HTMLAnchorElement>('.note-toc a[href^="#"]'));

      const onScroll = () => {
        const doc = document.documentElement;
        const max = doc.scrollHeight - doc.clientHeight;
        const ratio = max > 0 ? Math.min(1, doc.scrollTop / max) : 0;
        if (progress) progress.style.width = ratio * 100 + '%';
        if (backTop) backTop.classList.toggle('is-visible', doc.scrollTop > 600);
      };
      if ((window as any).__noteScroll) window.removeEventListener('scroll', (window as any).__noteScroll);
      (window as any).__noteScroll = onScroll;
      window.addEventListener('scroll', onScroll, { passive: true });
      onScroll();

      if (backTop) {
        backTop.addEventListener('click', () => window.scrollTo({ top: 0, behavior: 'smooth' }));
      }

      if (body) {
        body.querySelectorAll<HTMLElement>('h2[id], h3[id]').forEach((h) => {
          if (h.querySelector('.heading-anchor')) return;
          const a = document.createElement('a');
          a.className = 'heading-anchor';
          a.href = '#' + h.id;
          a.setAttribute('aria-label', 'Copy link to this section');
          a.textContent = '#';
          a.addEventListener('click', (e) => {
            e.preventDefault();
            history.replaceState(null, '', '#' + h.id);
            const url = location.origin + location.pathname + '#' + h.id;
            if (navigator.clipboard) navigator.clipboard.writeText(url).catch(() => {});
          });
          h.appendChild(a);
        });
      }

      const map = new Map<string, HTMLAnchorElement>();
      tocLinks.forEach((l) => {
        const href = l.getAttribute('href');
        if (href) map.set(decodeURIComponent(href.slice(1)), l);
      });
      const targets = body ? Array.from(body.querySelectorAll<HTMLElement>('h2[id], h3[id]')) : [];
      const prev = (window as any).__noteSpy;
      if (prev && prev.disconnect) prev.disconnect();
      if (targets.length && map.size) {
        const obs = new IntersectionObserver(
          (entries) => {
            entries.forEach((en) => {
              if (!en.isIntersecting) return;
              const link = map.get((en.target as HTMLElement).id);
              if (!link) return;
              tocLinks.forEach((l) => l.classList.remove('is-active'));
              link.classList.add('is-active');
            });
          },
          { rootMargin: '-88px 0px -70% 0px', threshold: 0 },
        );
        targets.forEach((t) => obs.observe(t));
        (window as any).__noteSpy = obs;
      }
    }

    initNote();
  </script>
</Base>
