---
import Base from '../../layouts/Base.astro';
import { withBase } from '../../lib/url';
import { experience } from '../../data/content';

const alternates = [
  { lang: 'en' as const, path: 'experience' },
  { lang: 'zh' as const, path: 'zh/experience' },
];
---

<Base
  title="經歷 — 王士欣"
  active="experience"
  ogImage="images/profile-avatar.jpg"
  lang="zh"
  alternates={alternates}
  langToggleHref={withBase('experience')}
>
  <main class="page content">
    <section>
      <h1>經歷</h1>

      <h3>Conference Organizing</h3>
      <p>
        I am organizing two minisymposia on generative modeling, optimal transport, imaging science,
        and scientific computing at <strong>SIAM IS26</strong> and <strong>SIAM MDS26</strong>
        (Salt Lake City, Nov 16–20, 2026). If you are attending, please join us:
      </p>
      <ul class="bullets">
        {experience.organizing.map((item) => <li set:html={item} />)}
      </ul>

      <h3>Recent Experience</h3>
      <ul class="bullets">
        {experience.recent.map((item) => <li set:html={item} />)}
      </ul>

      <h3>Invited Talks &amp; Presentations</h3>
      <ul class="bullets">
        {experience.talks.map((item) => <li set:html={item} />)}
      </ul>

      <h3>Academic Service</h3>
      <ul class="bullets">
        {experience.service.map((item) => <li set:html={item} />)}
      </ul>
    </section>
  </main>
</Base>
