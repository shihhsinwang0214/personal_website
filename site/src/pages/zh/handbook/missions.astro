---
import Base from '../../../layouts/Base.astro';
import MissionBoard from '../../../components/MissionBoard.astro';
import { withBase } from '../../../lib/url';

const alternates = [
  { lang: 'en' as const, path: 'handbook/missions' },
  { lang: 'zh' as const, path: 'zh/handbook/missions' },
];
---
<Base
  title="任務看板 — 結構導向學習與建模研究室"
  description="結構導向學習與建模研究室的研究方向，以及對應的筆記。"
  active="handbook"
  lang="zh"
  alternates={alternates}
  langToggleHref={withBase('handbook/missions')}
>
  <MissionBoard lang="zh" />
</Base>
