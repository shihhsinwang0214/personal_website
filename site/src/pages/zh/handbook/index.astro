---
import Base from '../../../layouts/Base.astro';
import HandbookLanding from '../../../components/HandbookLanding.astro';
import { withBase } from '../../../lib/url';

const alternates = [
  { lang: 'en' as const, path: 'handbook' },
  { lang: 'zh' as const, path: 'zh/handbook' },
];
---
<Base
  title="結構導向學習與建模實驗室"
  description="結構導向學習與建模實驗室 — 研究、理念與實驗室手冊。"
  active="handbook"
  lang="zh"
  alternates={alternates}
  langToggleHref={withBase('handbook')}
>
  <HandbookLanding lang="zh" />
</Base>
