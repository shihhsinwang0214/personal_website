---
import Base from '../../../layouts/Base.astro';
import BestiaryView from '../../../components/BestiaryView.astro';
import { withBase } from '../../../lib/url';

const alternates = [
  { lang: 'en' as const, path: 'handbook/bestiary' },
  { lang: 'zh' as const, path: 'zh/handbook/bestiary' },
];
---
<Base
  title="怪物圖鑑 — 結構導向學習與建模研究室"
  description="做研究會遇到的困難，以及手冊裡對應的應對方式。"
  active="handbook"
  lang="zh"
  alternates={alternates}
  langToggleHref={withBase('handbook/bestiary')}
>
  <BestiaryView lang="zh" />
</Base>
