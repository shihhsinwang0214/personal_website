---
import Base from '../../../layouts/Base.astro';
import PeopleView from '../../../components/PeopleView.astro';
import { withBase } from '../../../lib/url';

const alternates = [
  { lang: 'en' as const, path: 'handbook/people' },
  { lang: 'zh' as const, path: 'zh/handbook/people' },
];
---
<Base
  title="遠征隊成員 — 結構導向學習與建模研究室"
  description="結構導向學習與建模研究室（臺大資工）的成員。"
  active="handbook"
  lang="zh"
  alternates={alternates}
  langToggleHref={withBase('handbook/people')}
>
  <PeopleView lang="zh" />
</Base>
