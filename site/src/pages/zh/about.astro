---
import Base from '../../layouts/Base.astro';
import AboutView from '../../components/AboutView.astro';
import { withBase } from '../../lib/url';

const alternates = [
  { lang: 'en' as const, path: 'about' },
  { lang: 'zh' as const, path: 'zh/about' },
];
---

<Base
  title="關於我 — 王士欣"
  active="about"
  lang="zh"
  alternates={alternates}
  langToggleHref={withBase('about')}
>
  <AboutView lang="zh" />
</Base>
