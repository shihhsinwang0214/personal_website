---
import { getCollection } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import DojoIndex from '../../../components/dojo/DojoIndex.astro';
import { dojoForListingLang, dojoTitle, dojoTagline } from '../../../lib/dojo';
import { withBase } from '../../../lib/url';

const entries = dojoForListingLang(await getCollection('dojo'), 'zh');
const alternates = [
  { lang: 'en' as const, path: 'dojo' },
  { lang: 'zh' as const, path: 'zh/dojo' },
];
---

<Base
  title={`${dojoTitle['zh']} — Shih-Hsin Wang`}
  description={dojoTagline['zh']}
  active="dojo"
  lang="zh"
  alternates={alternates}
  langToggleHref={withBase('dojo')}
>
  <main class="notes-page">
    <DojoIndex lang="zh" entries={entries} />
  </main>
</Base>
