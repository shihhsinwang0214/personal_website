---
import ExplorationMark from '../../components/ExplorationMark.astro';
import PublicationTools from '../../components/PublicationTools.astro';
import Base from '../../layouts/Base.astro';
import { withBase } from '../../lib/url';
import { publications } from '../../data/content';

const scholarlyJsonLd = publications.flatMap((group) =>
  group.items.map((pub) => ({
    '@context': 'https://schema.org',
    '@type': 'ScholarlyArticle',
    headline: pub.title,
    author: { '@type': 'Person', name: 'Shih-Hsin Wang' },
    publication: pub.venue,
    ...(pub.url ? { url: pub.url } : {}),
  })),
);

const alternates = [
  { lang: 'en' as const, path: 'publications' },
  { lang: 'zh' as const, path: 'zh/publications' },
];
---

<Base
  title="著作 — 王士欣"
  active="publications"
  lang="zh"
  jsonLd={scholarlyJsonLd}
  alternates={alternates}
  langToggleHref={withBase('publications')}
>
  <main class="page content">
    <section>
      <ExplorationMark kind="research" label="PUBLICATIONS" />
      <h1>著作</h1>
      <p class="pub-intro">
        Full list also on
        <a href="https://scholar.google.com/citations?user=IoihdcYAAAAJ&hl=en" target="_blank" rel="noopener">Google Scholar</a>. * denotes equal contribution.
      </p>
      <PublicationTools lang="zh" groups={publications.map((group) => group.group)} />
      <div id="publication-list">
      {
        publications.map((group) => (
          <section class="publication-group" data-publication-group={group.group}>
            <h2>{group.group}</h2>
            {group.items.map((pub) => (
              <div class="pub-item">
                <div class="pub-title">
                  {pub.url ? (
                    <a href={pub.url} target="_blank" rel="noopener">
                      {pub.title}
                    </a>
                  ) : (
                    pub.title
                  )}
                </div>
                <div class="pub-authors" set:html={pub.authors} />
                <div class="pub-venue">{pub.venue}</div>
                <div class="pub-links">
                  {pub.links &&
                    pub.links.map((l) => (
                      <a class="pub-link" href={withBase(l.href)} target="_blank" rel="noopener">
                        {l.label}
                      </a>
                    ))}
                  {pub.bibtex && (
                    <details class="pub-bibtex">
                      <summary class="pub-link pub-bibtex-toggle">BibTeX</summary>
                      <div class="pub-bibtex-body">
                        <button class="pub-bibtex-copy" type="button">複製</button>
                        <pre><code>{pub.bibtex}</code></pre>
                      </div>
                    </details>
                  )}
                </div>
              </div>
            ))}
          </section>
        ))
      }
      </div>
    </section>
  </main>

</Base>
