---
import { getCollection } from 'astro:content';
import NoteArticle from '../../../components/NoteArticle.astro';
import LegacyNoteRedirect from '../../../components/LegacyNoteRedirect.astro';
import { isPublishedNote, mergedNoteAliases, noteRoute } from '../../../lib/notes';

export async function getStaticPaths() {
  const allNotes = await getCollection('notes');
  const redirects = Object.entries(mergedNoteAliases).map(([slug, target]) => {
    const canonical = allNotes.find((note) => note.data.slug === target && note.data.lang === 'zh' && note.data.status !== 'missing')
      ?? allNotes.find((note) => note.data.slug === target && note.data.status !== 'missing');
    if (!canonical) throw new Error(`Missing merged-note target: ${target}`);
    return { params: { slug }, props: { target: noteRoute(canonical.data.slug, canonical.data.lang) } };
  });
  const pages = allNotes
    .filter(
      (entry) => entry.data.lang === 'zh' && entry.data.status !== 'missing' && isPublishedNote(entry),
    )
    .map((entry) => ({
      params: { slug: entry.data.slug },
      props: { entry, allNotes },
    }));
  return [...pages, ...redirects];
}

const { entry, allNotes, target } = Astro.props;
---

{target ? <LegacyNoteRedirect lang="zh" target={target} /> : <NoteArticle entry={entry} allNotes={allNotes} lang="zh" />}
