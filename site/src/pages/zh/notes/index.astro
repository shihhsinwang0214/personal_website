---
import { getCollection } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import NotesIndex from '../../../components/NotesIndex.astro';
import { notesForListingLang } from '../../../lib/notes';
import { withBase } from '../../../lib/url';

const allNotes = await getCollection('notes');
const notes = notesForListingLang(allNotes, 'zh');
const alternates = [
  { lang: 'en' as const, path: 'notes' },
  { lang: 'zh' as const, path: 'zh/notes' },
];
---

<Base
  title="Notes & Guides — Shih-Hsin Wang"
  active="notes"
  lang="zh"
  alternates={alternates}
  langToggleHref={withBase('notes')}
>
  <main class="notes-page">
    <NotesIndex lang="zh" notes={notes} />
  </main>
</Base>
