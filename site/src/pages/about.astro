---
import Base from '../layouts/Base.astro';
import AboutView from '../components/AboutView.astro';
import { withBase } from '../lib/url';

const alternates = [
  { lang: 'en' as const, path: 'about' },
  { lang: 'zh' as const, path: 'zh/about' },
];
---

<Base
  title="About — Shih-Hsin Wang"
  active="about"
  ogImage="images/profile-avatar.jpg"
  alternates={alternates}
  langToggleHref={withBase('zh/about')}
>
  <AboutView lang="en" />
</Base>
