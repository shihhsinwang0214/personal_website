---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import DojoIndex from '../../components/dojo/DojoIndex.astro';
import { dojoForListingLang, dojoTitle, dojoTagline } from '../../lib/dojo';
import { withBase } from '../../lib/url';

const entries = dojoForListingLang(await getCollection('dojo'), 'en');
const alternates = [
  { lang: 'en' as const, path: 'dojo' },
  { lang: 'zh' as const, path: 'zh/dojo' },
];
---

<Base
  title={`${dojoTitle['en']} — Shih-Hsin Wang`}
  description={dojoTagline['en']}
  active="dojo"
  lang="en"
  alternates={alternates}
  langToggleHref={withBase('zh/dojo')}
>
  <main class="notes-page">
    <DojoIndex lang="en" entries={entries} />
  </main>
</Base>
