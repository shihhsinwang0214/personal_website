---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import NotesIndex from '../../components/NotesIndex.astro';
import { notesForListingLang } from '../../lib/notes';
import { withBase } from '../../lib/url';

const allNotes = await getCollection('notes');
const notes = notesForListingLang(allNotes, 'en');
const alternates = [
  { lang: 'en' as const, path: 'notes' },
  { lang: 'zh' as const, path: 'zh/notes' },
];
---

<Base
  title="Notes & Guides — Shih-Hsin Wang"
  active="notes"
  alternates={alternates}
  langToggleHref={withBase('zh/notes')}
>
  <main class="notes-page">
    <NotesIndex lang="en" notes={notes} />
  </main>
</Base>
