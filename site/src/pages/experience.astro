---
import Base from '../layouts/Base.astro';
import { experience } from '../data/content';
---

<Base title="Experience — Shih-Hsin Wang" active="experience">
  <main class="page content">
    <section>
      <h1>Highlights &amp; Experience</h1>

      <h3>Recent Experience</h3>
      <ul class="bullets">
        {experience.recent.map((item) => <li set:html={item} />)}
      </ul>

      <h3>Invited Talks &amp; Presentations</h3>
      <ul class="bullets">
        {experience.talks.map((item) => <li set:html={item} />)}
      </ul>

      <h3>Academic Service</h3>
      <ul class="bullets">
        {experience.service.map((item) => <li set:html={item} />)}
      </ul>
    </section>
  </main>
</Base>
