---
import Base from '../layouts/Base.astro';
import { withBase } from '../lib/url';
import { publications } from '../data/content';
---

<Base title="Publications — Shih-Hsin Wang" active="publications">
  <main class="page content">
    <section>
      <h1>Publications</h1>
      {
        publications.map((group) => (
          <>
            <h3>{group.group}</h3>
            {group.items.map((pub) => (
              <div class="pub-item">
                <div class="pub-title">
                  {pub.url ? (
                    <a href={pub.url} target="_blank" rel="noopener">
                      {pub.title}
                    </a>
                  ) : (
                    pub.title
                  )}
                </div>
                <div class="pub-authors" set:html={pub.authors} />
                <div class="pub-venue">{pub.venue}</div>
                {pub.links && (
                  <div class="pub-links">
                    {pub.links.map((l) => (
                      <a class="pub-link" href={withBase(l.href)} target="_blank" rel="noopener">
                        {l.label}
                      </a>
                    ))}
                  </div>
                )}
              </div>
            ))}
          </>
        ))
      }
    </section>
  </main>
</Base>
