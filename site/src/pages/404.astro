---
import Base from '../layouts/Base.astro';
import { withBase } from '../lib/url';
---

<Base title="Page not found — Shih-Hsin Wang" description="The page you are looking for could not be found." active="home">
  <main class="content notfound">
    <p class="notfound-code">404</p>
    <h1>Page not found</h1>
    <p>The page you’re looking for doesn’t exist or may have moved.</p>
    <div class="notfound-actions">
      <a href={withBase('')}>← Home</a>
      <a href={withBase('notes')}>Notes &amp; Guides</a>
    </div>
  </main>
</Base>

<style>
  .notfound {
    max-width: 640px;
    margin: 6vh auto 0;
    text-align: center;
  }
  .notfound-code {
    font-family: var(--font-mono);
    font-size: clamp(3rem, 14vw, 6rem);
    font-weight: 700;
    color: var(--accent);
    margin: 0;
    line-height: 1;
  }
  .notfound h1 {
    border: 0;
    margin: 12px 0 8px;
  }
  .notfound p { color: var(--text-muted); }
  .notfound-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    justify-content: center;
    margin-top: 24px;
  }
  .notfound-actions a {
    border: 1px solid var(--border);
    border-radius: 999px;
    color: var(--text);
    font-weight: 700;
    padding: 10px 16px;
    text-decoration: none;
    transition: border-color var(--dur-fast), color var(--dur-fast);
  }
  .notfound-actions a:hover { border-color: var(--accent); color: var(--accent); }
</style>
