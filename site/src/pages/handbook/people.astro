---
import Base from '../../layouts/Base.astro';
import PeopleView from '../../components/PeopleView.astro';
import { withBase } from '../../lib/url';

const alternates = [
  { lang: 'en' as const, path: 'handbook/people' },
  { lang: 'zh' as const, path: 'zh/handbook/people' },
];
---
<Base
  title="People — Structure-Aware Learning and Modeling Lab"
  description="Members of the Structure-Aware Learning and Modeling Lab at NTU CSIE."
  active="handbook"
  alternates={alternates}
  langToggleHref={withBase('zh/handbook/people')}
>
  <PeopleView lang="en" />
</Base>
