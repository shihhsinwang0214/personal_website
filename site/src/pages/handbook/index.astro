---
import Base from '../../layouts/Base.astro';
import HandbookLanding from '../../components/HandbookLanding.astro';
import { withBase } from '../../lib/url';

const alternates = [
  { lang: 'en' as const, path: 'handbook' },
  { lang: 'zh' as const, path: 'zh/handbook' },
];
---
<Base
  title="Lab — Shih-Hsin Wang"
  description="Structure-Aware Modeling and Discovery Lab — research, philosophy, and lab handbook."
  active="handbook"
  alternates={alternates}
  langToggleHref={withBase('zh/handbook')}
>
  <HandbookLanding lang="en" />
</Base>
