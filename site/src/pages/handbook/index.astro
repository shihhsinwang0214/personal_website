---
// The handbook is currently simplified to a single recruiting page.
// /handbook redirects to /handbook/join. Restore the HandbookLanding-based
// version of this file to bring back the full landing page.
import { withBase } from '../../lib/url';

const href = withBase('handbook/join');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta http-equiv="refresh" content={`0; url=${href}`} />
    <link rel="canonical" href={href} />
    <title>Redirecting…</title>
    <script is:inline define:vars={{ href }}>
      window.location.replace(href);
    </script>
  </head>
  <body>
    <p><a href={href}>Join the Lab</a></p>
  </body>
</html>
