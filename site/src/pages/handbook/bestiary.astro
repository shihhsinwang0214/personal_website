---
import Base from '../../layouts/Base.astro';
import BestiaryView from '../../components/BestiaryView.astro';
import { withBase } from '../../lib/url';

const alternates = [
  { lang: 'en' as const, path: 'handbook/bestiary' },
  { lang: 'zh' as const, path: 'zh/handbook/bestiary' },
];
---
<Base
  title="Bestiary — Structure-Aware Learning and Modeling Lab"
  description="The difficulties every researcher meets, and where the handbook deals with each one."
  active="handbook"
  alternates={alternates}
  langToggleHref={withBase('zh/handbook/bestiary')}
>
  <BestiaryView lang="en" />
</Base>
