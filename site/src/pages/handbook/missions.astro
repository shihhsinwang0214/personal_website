---
import Base from '../../layouts/Base.astro';
import MissionBoard from '../../components/MissionBoard.astro';
import { withBase } from '../../lib/url';

const alternates = [
  { lang: 'en' as const, path: 'handbook/missions' },
  { lang: 'zh' as const, path: 'zh/handbook/missions' },
];
---
<Base
  title="Mission Board — Structure-Aware Learning and Modeling Lab"
  description="The research directions of the Structure-Aware Learning and Modeling Lab, and the field notes that go with them."
  active="handbook"
  alternates={alternates}
  langToggleHref={withBase('zh/handbook/missions')}
>
  <MissionBoard lang="en" />
</Base>
